{
  "name": "expiya-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run catalog:active:sync && npm run technical-daily-life:active:sync && npm run persona-safe-traits:active:sync && next dev",
    "cars:dev:validation": "node --env-file=.env.local scripts/run-cars-validation-dev.mjs",
    "build": "npm run catalog:active:sync && npm run technical-daily-life:active:sync && npm run persona-safe-traits:active:sync && npm run verify:active-production-catalog && npm run verify:technical-daily-life && npm run verify:persona-safe-traits && npm run verify:vehicle-evidence-runtime-artifact && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run catalog:active:sync && npm run technical-daily-life:active:sync && npm run persona-safe-traits:active:sync && vitest run",
    "cars:trace:replay": "npm test -- --run features/decision/v2/trace",
    "cars:trace:gate": "npm test -- --run features/decision/v2/trace/productionReplayMatrix.test.ts features/decision/v2/trace/deploymentGate.test.ts",
    "cars:interpretation:measure": "node --import tsx scripts/report-deterministic-interpretation.ts",
    "cars:eval:deterministic": "CARS_V31_PROVIDER_DISABLED=true vitest run features/decision/v3/evaluation/contract.test.ts",
    "cars:eval:smoke": "CARS_V31_PROVIDER_DISABLED=true PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_CONFIG_DIR=evals/cars-v3/.promptfoo promptfoo eval -c evals/cars-v3/promptfooconfig.yaml -j 1 --no-cache --no-share -o evals/cars-v3/results/smoke.json",
    "cars:eval:http": "CARS_V31_PROVIDER_DISABLED=true node --import tsx scripts/run-v3-http-eval.ts",
    "cars:v38:replay": "node --env-file=.env.local --import tsx scripts/replay-cars-v38-manual-corpus.ts",
    "cars:v38:replay:fallback": "node --import tsx scripts/replay-cars-v38-manual-corpus.ts --deterministic",
    "cars:eval:simulated": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_CONFIG_DIR=evals/cars-v3/.promptfoo node --env-file=.env.local ./node_modules/promptfoo/dist/src/main.js eval -c evals/cars-v3/promptfoo.simulated.yaml -j 3 --no-cache --no-share -o evals/cars-v3/results/simulated-225.json",
    "cars:eval:regrade:preflight": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_CONFIG_DIR=evals/cars-v3/.promptfoo node --env-file=.env.local ./node_modules/promptfoo/dist/src/main.js eval -c evals/cars-v3/promptfoo.regrade.yaml -n 1 -j 1 --no-cache --no-share -o evals/cars-v3/results/regrade-preflight.json",
    "cars:eval:regrade": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_CONFIG_DIR=evals/cars-v3/.promptfoo PROMPTFOO_DELAY_MS=2500 node --env-file=.env.local ./node_modules/promptfoo/dist/src/main.js eval -c evals/cars-v3/promptfoo.regrade.yaml -j 1 --no-cache --no-share -o evals/cars-v3/results/regraded-225.json",
    "cars:pilot:password": "node scripts/create-cars-pilot-password.mjs",
    "cars:pilot:export": "node --env-file=.env.local --import tsx scripts/export-cars-pilot-conversations.ts",
    "cars:pilot:migrate": "node --env-file=.env.local --import tsx scripts/apply-cars-pilot-migration.ts",
    "db:migrate:vehicles": "tsx scripts/migrate-vehicle-data.ts",
    "db:import:vehicles": "tsx scripts/import-pilot-vehicles.ts",
    "db:import:catalog-candidates": "tsx scripts/import-manual-catalog-candidates.ts",
    "db:import:marketplace-pilot": "tsx scripts/import-marketplace-candidate-pilot.ts",
    "mobility:authority:activate": "node --import tsx scripts/activate-mobility-authority.ts",
    "mobility:db:validate": "node --import tsx scripts/apply-mobility-runtime-migration.ts --validate-only",
    "mobility:db:migrate": "node --import tsx scripts/apply-mobility-runtime-migration.ts",
    "db:report:catalog-candidates": "tsx scripts/report-catalog-candidates.ts",
    "verify:cars-catalog-blob": "node scripts/verify-cars-catalog-blob.mjs",
    "catalog:release:generate": "node --import tsx scripts/generate-production-catalog-release.ts",
    "catalog:release:verify": "node --import tsx scripts/verify-production-catalog-release.ts",
    "catalog:revision:dry-run": "node --import tsx scripts/dry-run-xpy-catalog-revision.ts",
    "catalog:active:sync": "node --import tsx scripts/sync-active-production-catalog.ts",
    "technical-daily-life:active:sync": "node --import tsx scripts/sync-active-technical-daily-life.ts",
    "verify:technical-daily-life": "node --import tsx scripts/verify-active-technical-daily-life.ts",
    "equipment-evidence:release:generate-v1": "node --import tsx scripts/generate-equipment-evidence-release-v1.ts",
    "equipment-evidence:pilot:generate-v1": "node --import tsx scripts/generate-equipment-pilot-manifest-v1.ts",
    "equipment-evidence:active:sync": "node --import tsx scripts/sync-active-equipment-evidence.ts",
    "owner-manual-evidence:v4:generate": "node --import tsx scripts/generate-owner-manual-evidence-v4.ts",
    "owner-manual-evidence:v4:exact-tr-bridge": "node --import tsx scripts/generate-owner-manual-exact-tr-bridge-v4.ts",
    "owner-manual-evidence:exact-tr-pilot-01": "node --import tsx scripts/generate-owner-manual-exact-tr-pilot-01.ts",
    "owner-manual-evidence:equipment-batch-01": "node --import tsx scripts/generate-owner-manual-equipment-evidence-batch-01.ts",
    "owner-manual-evidence:equipment-owner-review-01": "node --import tsx scripts/materialize-owner-reviewed-manual-equipment-01.ts",
    "equipment-daily-life:high-materiality-01": "node --import tsx scripts/generate-high-materiality-equipment-daily-life-01.ts",
    "appliances:dryer:catalog-richness": "node --import tsx scripts/generate-dryer-catalog-richness.ts",
    "appliances:dryer:catalog-richness:activate": "node --import tsx scripts/activate-dryer-catalog-richness.ts",
    "appliances:refrigerator:catalog-richness": "node --import tsx scripts/generate-refrigerator-catalog-richness.ts",
    "appliances:refrigerator:catalog-richness:activate": "node --import tsx scripts/activate-refrigerator-catalog-richness.ts",
    "appliances:dishwasher:catalog-richness": "node --import tsx scripts/generate-dishwasher-catalog-richness.ts",
    "appliances:dishwasher:catalog-richness:activate": "node --import tsx scripts/activate-dishwasher-catalog-richness.ts",
    "appliances:vacuum:catalog-richness": "node --import tsx scripts/generate-vacuum-catalog-richness.ts",
    "appliances:vacuum:catalog-richness:activate": "node --import tsx scripts/activate-vacuum-catalog-richness.ts",
    "appliances:washing-machine:catalog-richness": "node --import tsx scripts/generate-washing-machine-catalog-richness.ts",
    "appliances:washing-machine:catalog-richness:activate": "node --import tsx scripts/activate-washing-machine-catalog-richness.ts",
    "appliances:major-catalog-adoption:generate": "node --import tsx scripts/generate-major-appliance-catalog-adoption.ts",
    "appliances:major-catalog-adoption:activate": "node --import tsx scripts/activate-major-appliance-catalog-adoption.ts",
    "appliances:major-catalog-adoption:rollback": "node --import tsx scripts/activate-major-appliance-catalog-adoption.ts --rollback",
    "appliances:major-decision-adoption:activate": "node --import tsx scripts/activate-major-appliance-decision-adoption.ts",
    "appliances:major-decision-adoption:rollback": "node --import tsx scripts/activate-major-appliance-decision-adoption.ts --rollback",
    "appliances:manuals:acquire": "node --import tsx scripts/acquire-governed-appliance-manuals.ts",
    "appliances:manuals:acquire:batch-02": "node --import tsx scripts/acquire-governed-appliance-manuals-batch-02.ts",
    "appliances:media:acquire": "node --import tsx scripts/acquire-governed-appliance-media.ts --acquire",
    "appliances:commerce:collect": "node --import tsx scripts/acquire-appliances-commerce.ts --collect",
    "appliances:credentialed:inventory": "node --import tsx scripts/report-appliances-credentialed-activation.ts",
    "verify:equipment-evidence": "node --import tsx scripts/verify-active-equipment-evidence.ts",
    "persona-safe-traits:active:sync": "node --import tsx scripts/sync-active-vehicle-persona-safe-traits.ts",
    "persona-safe-traits:review:generate": "node --import tsx scripts/generate-vehicle-persona-owner-review.ts",
    "persona-safe-traits:approved-101:generate": "node --import tsx scripts/generate-approved-vehicle-persona-safe-traits-101.ts",
    "persona-safe-traits:approved-101:activate": "node --import tsx scripts/activate-approved-vehicle-persona-safe-traits-101.ts",
    "verify:persona-safe-traits": "node --import tsx scripts/verify-active-vehicle-persona-safe-traits.ts",
    "verify:active-production-catalog": "node --import tsx scripts/verify-active-production-catalog.ts",
    "verify:vehicle-evidence-runtime-artifact": "node scripts/verify-vehicle-evidence-runtime-artifact.mjs && node scripts/verify-release-pinned-vehicle-evidence.mjs",
    "vehicle-evidence:validate": "node --import tsx scripts/vehicle-evidence.ts validate data/cars/vehicle_evidence/releases/v0.4.1/tables",
    "vehicle-evidence:reconcile": "node --import tsx scripts/generate-release-pinned-vehicle-evidence.ts",
    "vehicle-evidence:next-id": "node --import tsx scripts/vehicle-evidence.ts next-id",
    "vehicle-evidence:manifest": "node --import tsx scripts/vehicle-evidence.ts manifest",
    "vehicle-evidence:snapshot-sources": "node --import tsx scripts/snapshot-vehicle-evidence-sources.ts",
    "vehicle-evidence:collect-hyundai": "node --import tsx scripts/collect-hyundai-brand-batch.ts",
    "vehicle-evidence:collect-hyundai-brochures": "node --import tsx scripts/collect-hyundai-brochures.ts",
    "vehicle-evidence:collect-alfa-romeo": "node --import tsx scripts/collect-alfa-romeo-brand-batch.ts",
    "vehicle-media:queue": "node --import tsx scripts/generate-vehicle-media-queue.ts",
    "vehicle-media:collect-candidates": "node --import tsx scripts/collect-vehicle-media-candidates.ts",
    "vehicle-media:upload-verified": "node --env-file=.env.local --import tsx scripts/upload-verified-vehicle-media.ts",
    "vehicle-media:collect-wikimedia": "node --env-file=.env.local --import tsx scripts/collect-upload-wikimedia-vehicle-media.ts",
    "catalog:release:generate-hyundai": "node --import tsx scripts/generate-hyundai-production-catalog-release.ts",
    "catalog:release:generate-alfa-romeo": "node --import tsx scripts/generate-alfa-romeo-production-catalog-release.ts",
    "catalog:release:generate-alpine": "node --import tsx scripts/generate-alpine-production-catalog-release.ts",
    "catalog:release:generate-estimated-backfill": "node --import tsx scripts/generate-estimated-price-backfill-release.ts",
    "catalog:release:generate-bmw": "node --import tsx scripts/generate-bmw-production-catalog-release.ts",
    "catalog:release:generate-bmw-electric": "node --import tsx scripts/generate-bmw-electric-production-catalog-release.ts",
    "vehicle-evidence:apply-hardening": "node --import tsx scripts/apply-post-batch01-hardening.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "promptfoo": "^0.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
