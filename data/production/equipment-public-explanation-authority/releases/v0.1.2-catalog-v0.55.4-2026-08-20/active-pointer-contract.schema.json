{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activePublicExplanationAuthorityRelease": {
      "type": "string"
    },
    "payloadSha256": {
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "productionCompositeBindingChecksum": {
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "publicActivation": {
      "type": "boolean"
    },
    "publicIntegration": {
      "type": "boolean"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "state": {
      "enum": [
        "PROPOSED_NOT_ACTIVE",
        "ACTIVE"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "state",
    "activePublicExplanationAuthorityRelease",
    "payloadSha256",
    "productionCompositeBindingChecksum"
  ],
  "title": "Equipment Public Explanation Authority Active Pointer",
  "type": "object"
}
