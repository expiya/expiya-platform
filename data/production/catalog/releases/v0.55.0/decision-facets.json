      "inputPatterns": ["(?:en az|min(?:imum)?)\\s*(\\d+)\\s*(?:litre|liter|l)\\s*(?:bagaj|cargo)", "^\\s*(\\d+)\\s*(?:litre|liter|l)\\s*$"],
      "questionTriggers": ["bagaj|bavul|yük hacmi|aile tatili yükü"],
