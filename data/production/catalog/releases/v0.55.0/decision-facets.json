      "questionTriggers": ["0\\s*[-–]?\\s*100|performans|motor gücü|hızlanma|güç önceli"],
      "answerMappings": [
        { "label": "Günlük kullanımda canlı", "patterns": ["günlük kullanımda canlı", "yeterince canlı"], "value": 110 },
        { "label": "Belirgin şekilde güçlü", "patterns": ["belirgin(?: şekilde)? güçlü", "güçlü olsun"], "value": 160 },
        { "label": "Çok yüksek performans", "patterns": ["çok yüksek performans", "en yüksek performans"], "value": 250 }
      ],
      "scale": 1
    },
    {
      "id": "seats_min",
