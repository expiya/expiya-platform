        { "label": "İki büyük bavul", "patterns": ["(?:iki|2)\\s*büyük bavul"], "value": 400 },
        { "label": "Aile tatili yükü", "patterns": ["aile tatili yükü", "kalabalık tatil bagajı"], "value": 500 }
