      "inputPatterns": ["(?:en az|min(?:imum)?)\\s*(\\d+)\\s*(?:koltuk|seat)", "^\\s*(\\d+)\\s*(?:koltuk|seat)\\s*$"],
      "questionTriggers": ["koltuk|kaç kişi|kişiyiz|kalabalık aile"],
      "scale": 1
    },
    {
