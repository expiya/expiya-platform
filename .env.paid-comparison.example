# Do not commit real values. Copy the required names into .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PAID_REPORT_PII_KEY=BASE64URL_ENCODED_32_BYTE_KEY
RESEND_API_KEY=re_REPLACE_WITH_SENDING_ONLY_KEY
PAID_REPORT_FROM_EMAIL=Expiya Cars <rapor@verified.expiya.com>

# Existing sandbox payment settings
IYZICO_ENV=sandbox
IYZICO_API_KEY=sandbox-REPLACE
IYZICO_SECRET_KEY=sandbox-REPLACE
IYZICO_CALLBACK_URL=https://YOUR-SANDBOX-HOST/api/payments/iyzico/callback

# Keep live gates closed during sandbox validation.
IYZICO_LIVE_PAYMENTS_ENABLED=false
PAID_COMPARISON_CHECKOUT_ENABLED=false
PAID_COMPARISON_SANDBOX_E2E_PASSED=false
