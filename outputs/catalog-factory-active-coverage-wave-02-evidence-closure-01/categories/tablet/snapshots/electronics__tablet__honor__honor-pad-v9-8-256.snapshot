    margin-top: 8vw;
  }
}
#honorPadV9 .sec-last4 .last-warper .card-pic .bg {
  position: relative;
  z-index: 10;
}
#honorPadV9 .sec-last4 .last-warper .card-pic .five-circle {
  width: 47.2395833333vw;
  height: 9.4270833333vw;
  position: absolute;
  left: 50%;
