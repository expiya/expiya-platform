@keyframes circleAni {
  0% {
    transform: translate(-50%, 0) scale(0);
    opacity: 0;
  }
  70% {
    transform: translate(-50%, 0) scale(1.1);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, 0) scale(2);
    opacity: 0;
  }
}
#honorPadV9 .sec-last4 .meng {
  width: 100%;
  height: 10vw;
  position: absolute;
  bottom: 0;
  left: 0;
  background: linear-gradient(to top, #fff, transparent);
  z-index: 1;
}
#honorPadV9 .sec-last4 .last4-bgd {
  width: 100%;
  height: 100%;
}
#honorPadV9 .sec-last4 .last-warper {
  width: 85vw;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -45%);
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-last4 .last-warper {
    width: 100%;
    flex-direction: column;
  }
}
#honorPadV9 .sec-last4 .last-warper .card-txt {
  width: 24.9479166667vw;
  transform: translateY(0vw);
  opacity: 0;
  transition: all 0.7s ease;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-last4 .last-warper .card-txt {
    width: 82.6666666667vw;
  }
}
#honorPadV9 .sec-last4 .last-warper .card-txt.active {
  transform: translateY(-1.0416666667vw);
  opacity: 1;
  transition: all 0.7s ease 0.2s;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-last4 .last-warper .card-txt.active {
    transform: translateY(-5vw);
  }
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-last4 .last-warper .card-txt h2 {
    text-align: center;
  }
}
#honorPadV9 .sec-last4 .last-warper .card-txt p {
  margin-top: 1.0416666667vw;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-last4 .last-warper .card-txt p {
    font-size: 3.7333333333vw;
    margin-top: 2.6666666667vw;
    text-align: center;
  }
}
#honorPadV9 .sec-last4 .last-warper .card-pic {
  width: 49.0277777778vw;
  height: 33.4375vw;
  position: relative;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-last4 .last-warper .card-pic {
    width: 74.8453333333vw;
