<style type="text/css">html,
body {
  padding: 0;
  margin: 0;
  overflow: initial;
}

#honorPadV9 {
  font-family: "HONOR Sans World Regular";
  background: #fff;
}
#honorPadV9 .blur-up {
  filter: blur(20px);
  transition: filter 0.2s;
}
#honorPadV9 .blur-up.lazyloaded {
  filter: blur(0);
}
#honorPadV9 section,
#honorPadV9 div,
#honorPadV9 h2,
#honorPadV9 h3,
#honorPadV9 h4,
#honorPadV9 ul,
#honorPadV9 ol,
#honorPadV9 li,
#honorPadV9 p,
#honorPadV9 form,
#honorPadV9 table,
#honorPadV9 th,
#honorPadV9 td,
#honorPadV9 figure,
#honorPadV9 button {
  border: none;
  margin: 0px;
  padding: 0px;
  color: #000;
  font-weight: normal;
  box-sizing: border-box;
}
#honorPadV9 h2,
#honorPadV9 h3,
#honorPadV9 h4 {
  line-height: 1.25;
}
#honorPadV9 p,
#honorPadV9 span {
  line-height: 1.4;
}
#honorPadV9 button {
  background-color: transparent;
  cursor: pointer;
}
#honorPadV9 sup {
  position: relative !important;
  font-size: 50% !important;
  line-height: 0 !important;
  vertical-align: super !important;
  top: 0 !important;
  display: inline-block !important;
  transform: scale(0.66) !important;
  transform-origin: left center !important;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 sup {
    transform: scale(0.7) !important;
  }
}
#honorPadV9 sup.zw-sup {
  position: relative !important;
  font-size: 50% !important;
  line-height: 0 !important;
  vertical-align: super !important;
  top: 0 !important;
  transform: none !important;
}
#honorPadV9 picture,
#honorPadV9 img,
#honorPadV9 video,
#honorPadV9 canvas {
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
}
#honorPadV9 a {
  color: inherit;
  text-decoration: none;
}
#honorPadV9 *,
#honorPadV9 *::before,
#honorPadV9 *::after {
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
  text-rendering: optimizeLegibility;
}
#honorPadV9 *:focus,
#honorPadV9 *:active {
  outline: none;
}
#honorPadV9 .object-fit {
  height: 100%;
  -o-object-fit: cover;
     object-fit: cover;
}
#honorPadV9 .ff-demiBold {
  font-family: "HONOR Sans World DemiBold";
}
#honorPadV9 .ff-medium {
  font-family: "HONOR Sans World Medium";
}
#honorPadV9 .ff-Regu {
  font-family: "HONOR Sans World Regular";
}
#honorPadV9 .fs-80 {
  font-size: 4.1666666667vw;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .fs-80 {
    font-size: 9.6vw;
  }
}
#honorPadV9 .fs-48 {
  font-size: 2.5vw;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .fs-48 {
    font-size: 7.4666666667vw;
  }
}
#honorPadV9 .fs-32 {
  font-size: 1.6666666667vw;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .fs-32 {
    font-size: 4.2666666667vw;
  }
}
#honorPadV9 .fs-18 {
  font-size: 0.9375vw;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .fs-18 {
    font-size: 3.7333333333vw;
  }
}
#honorPadV9 .mob-show {
  display: none !important;
}
#honorPadV9 .mob-show-inline {
  display: none !important;
}
#honorPadV9 .pc-show-inline {
  display: inline-block !important;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .mob-show {
    display: block !important;
  }
  #honorPadV9 .mob-show-inline {
    display: inline-block !important;
  }
  #honorPadV9 .pc-show {
    display: none !important;
  }
  #honorPadV9 .pc-show-inline {
    display: none !important;
  }
}

#honorPadV9 .sec-bottom-nodes {
  width: 62.5vw;
  height: -moz-max-content;
  height: max-content;
  padding: 0vw 0 5.2083333333vw 0;
  margin: 0 auto;
  margin-top: 5.2083333333vw;
}
#honorPadV9 .sec-bottom-nodes .line {
  height: 1px;
  width: 100%;
  background: rgba(0, 0, 0, 0.6);
  margin-bottom: 2.6041666667vw;
}
#honorPadV9 .sec-bottom-nodes ul.bz-txt {
  padding-left: 14px;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-bottom-nodes ul.bz-txt {
    padding-left: 12px;
  }
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-bottom-nodes {
    width: 79%;
    padding: 13.3333333333vw 0 13.3333333333vw 0;
    margin-top: 10.6666666667vw;
  }
}
#honorPadV9 .sec-bottom-nodes .node-beizhu {
  padding: 0 1.06vw;
  margin: 3.6458333333vw 0 1.0416666667vw;
  font-size: 14px;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-bottom-nodes .node-beizhu {
    padding: 0;
    margin: 9.3333333333vw 0 4vw;
    font-size: 12px;
  }
}
#honorPadV9 .sec-bottom-nodes li {
  list-style: decimal !important;
  line-height: 1.3;
  margin-bottom: 0.3125vw;
  color: rgb(0, 0, 0);
  font-size: 14px;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-bottom-nodes li {
    font-size: 12px;
  }
}
#honorPadV9 .sec-bottom-nodes ul.bz {
  width: 100%;
  margin-left: -0.8333333333vw;
  padding-left: 2.5625vw;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-bottom-nodes ul.bz {
    margin-left: 0;
  }
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .sec-bottom-nodes ul.bz {
    padding-left: 12px;
  }
}
#honorPadV9 .sec-bottom-nodes .star {
  margin-top: 1.0416666667vw;
  padding-left: 1.5625vw;
}

#honorPadV9 .sec-bottom-nodes .star li {
  list-style: none !important;
  position: relative;
}

@media (max-aspect-ratio: 12/10) and (max-width: 1025px) {
  #honorPadV9 .sec-bottom-nodes .star {
    padding-left: 12px;
  }
}
#honorPadV9 .sec-bottom-nodes .star li::after {
  content: "*";
  position: absolute;
  top: 0;
  left: 0;
  transform: translateX(calc(-100% - 0.1041666667vw));
}

#honorPadV9 .section-kv .kvBuyBtn {
  position: relative;
  display: inline-block;
  text-align: center;
  font-size: 0.9375vw;
  border-radius: 2.6041666667vw;
  border: 1.5px solid #7f7f7f;
  color: #000;
  z-index: 4;
  padding: 0.5208333333vw 1.5625vw;
  margin-top: 1.8229166667vw;
  line-height: 1;
  transition: border-color 0.1s linear;
  z-index: 99;
}

@media (min-width: 1366px) {
  #honorPadV9 .section-kv .kvBuyBtn:hover {
    border-color: #000;
  }
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .section-kv .kvBuyBtn {
    margin: 0.6666666667vw auto 0;
    font-size: 3.5vw;
    transform: none;
    padding: 1.13vw 3.8vw;
    border-radius: 8vw;
  }
}
.honorPadV9 section {
  position: relative;
}

.honorPadV9 .sticky-content {
  position: sticky;
  top: 52px;
  height: calc(100vh - 52px);
  overflow: hidden;
}

.honorPadV9 .text-gradient {
  display: inline-block;
  -webkit-text-fill-color: transparent;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}

#honorPadV9 .section-kv {
  height: 53.5416666667vw;
  width: 100%;
  overflow: hidden;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .section-kv {
    height: 177.8666666667vw;
  }
}
#honorPadV9 .section-kv .kv-bg {
  width: 100%;
  height: 100%;
}
#honorPadV9 .section-kv .text-wrapper {
  width: 34.0104166667vw;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(calc(-50% + 24vw), -50%);
  text-align: center;
}
@media (min-aspect-ratio: 661/758) and (max-width: 1000px) {
  #honorPadV9 .section-kv .text-wrapper {
    width: 44.6875vw;
  }
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .section-kv .text-wrapper {
    width: 114.666667vw;
    transform: translate(-50%, calc(-50% - 51vw));
  }
}
#honorPadV9 .section-kv .text-wrapper .product-name {
  width: 34.0104166667vw;
  height: auto;
  margin: 0 auto 1.91vw;
}
@media (max-aspect-ratio: 660/758) and (max-width: 1025px) {
  #honorPadV9 .section-kv .text-wrapper .product-name {
    width: 69.3333333333vw;
    margin: 0 auto 3.2vw;
