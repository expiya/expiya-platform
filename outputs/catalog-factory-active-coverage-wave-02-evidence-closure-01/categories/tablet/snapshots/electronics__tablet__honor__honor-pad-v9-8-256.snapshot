      function sec19() {
        var last2_video_load = true
        var last2_vid1 = document.querySelector('#last2-vid1')
        var last2_vid2 = document.querySelector('#last2-vid2')
        var last2_vid3 = document.querySelector('#last2-vid3')
  
  
        last2_vid1.addEventListener('ended', function () {
          $('.last2-vid1-replay').addClass('active')
        })
        last2_vid1.addEventListener('play', function () {
          $('.last2-vid1-replay').removeClass('active')
        })
        $('.last2-vid1-replay').on('click', function () {
          $('#last2-vid1')[0].play()
        })
  
        last2_vid2.addEventListener('ended', function () {
          $('.last2-vid2-replay').addClass('active')
        })
        last2_vid2.addEventListener('play', function () {
          $('.last2-vid2-replay').removeClass('active')
        })
        $('.last2-vid2-replay').on('click', function () {
          $('#last2-vid2')[0].play()
        })
  
        last2_vid3.addEventListener('ended', function () {
          $('.last2-vid3-replay').addClass('active')
        })
        last2_vid3.addEventListener('play', function () {
          $('.last2-vid3-replay').removeClass('active')
        })
        $('.last2-vid3-replay').on('click', function () {
          $('#last2-vid3')[0].play()
        })
  
        if (!isMob) {
          let sec19_pc1 = gsap.timeline({
            scrollTrigger: {
              trigger: '#sec19-trigger1',
              start: 'top 50%',
              end: 'top 50%',
              scrub: 0,
              // markers: true,
            }
          });
  
  
          sec19_pc1.to('.section19', 1, {
            onStart: function () {
              $('.section19').addClass('is-active')
  
              if (last2_video_load === true) {
                Common.loadVideo(last2_vid1)
                Common.loadVideo(last2_vid2)
                Common.loadVideo(last2_vid3)
  
                last2_video_load = false
              }
            },
            onReverseComplete: function () {
              $('.section19').removeClass('is-active')
            }
          })
  
  
  
  
        } else {
          let sec19_pc1 = gsap.timeline({
            scrollTrigger: {
              trigger: '#sec19-trigger1',
              start: 'top 60%',
              end: 'top 60%',
              scrub: 0,
              // markers: true,
            }
          });
  
  
          sec19_pc1.to('.section19', 1, {
            onStart: function () {
              $('.section19').addClass('is-active')
  
              if (last2_video_load === true) {
                Common.loadVideo(last2_vid1)
                Common.loadVideo(last2_vid2)
                Common.loadVideo(last2_vid3)
  
                last2_video_load = false
              }
            },
            onReverseComplete: function () {
              $('.section19').removeClass('is-active')
            }
          })
  
        }
      }
  
  
      function word2Swipe() {
        const
          $word2 = MAIN.querySelector('.sec-word2-swipe'),
          $pagination = MAIN.querySelector('.sec-word2-swipe .pagination-wrapper .pagination');
  
        if (!isMob) {
  
  
  
          const mySwiperWord2 = new Swiper('.swiper-container-word2', {
            slidesPerView: 1,
            spaceBetween: 400,
            speed: 500,
  
            pagination: {
              el: ".swiper-pagination-word2",
              type: "fraction",
              // type: "progressbar",
              formatFractionCurrent: function (number) {
                let myNum = 0
                switch (number) {
                  case 1:
                    myNum = '01'
                    break;
                  case 2:
                    myNum = '02'
                    break;
                  case 3:
                    myNum = '03'
                    break;
  
                  default: myNum = number
                }
                return myNum;
              },
              formatFractionTotal: function (number) {
                return '03';
              }
            },
            navigation: {
              nextEl: '.sec-word2-swipe .nextBtn',
              prevEl: '.sec-word2-swipe .prevBtn',
            },
            on: {
              slideChangeTransitionStart: function () {
  
                Common.removeClassesStartingWith($pagination, 'is-active');
                $pagination.classList.add('is-active-' + this.activeIndex);
              },
              touchMove: function () {
                touchMoving = true;
                // console.log('hua')
              },
              touchEnd: function () {
                setTimeout(() => { touchMoving = false }, 100);
              },
              slidePrevTransitionStart: function () {
                if (touchMoving) GA.swiper_touch($word2, 'prev');
              },
              slideNextTransitionStart: function () {
                if (touchMoving) GA.swiper_touch($word2, 'next');
              },
              slideChange: function () {
                if (this.activeIndex === 0) {
                  // console.log('0')
  
                }
                if (this.activeIndex === 1) {
                  // console.log('1')
  
                }
                if (this.activeIndex === 2) {
                  // console.log('2')
  
                }
  
              }
            }
  
  
          })
        } else {
          const mySwiperWord2_mob = new Swiper('.swiper-container-word2', {
            slidesPerView: 1,
            spaceBetween: 100,
            speed: 500,
  
            pagination: {
              el: ".swiper-pagination-word2",
              type: "fraction",
              // type: "progressbar",
              formatFractionCurrent: function (number) {
                let myNum = 0
                switch (number) {
                  case 1:
                    myNum = '01'
                    break;
                  case 2:
                    myNum = '02'
                    break;
                  case 3:
                    myNum = '03'
                    break;
  
                  default: myNum = number
                }
                return myNum;
              },
              formatFractionTotal: function (number) {
                return '03';
              }
            },
            navigation: {
              nextEl: '.sec-word2-swipe .nextBtn',
              prevEl: '.sec-word2-swipe .prevBtn',
            },
            on: {
              slideChangeTransitionStart: function () {
  
                Common.removeClassesStartingWith($pagination, 'is-active');
                $pagination.classList.add('is-active-' + this.activeIndex);
              },
              touchMove: function () {
                touchMoving = true;
                // console.log('hua')
              },
              touchEnd: function () {
                setTimeout(() => { touchMoving = false }, 100);
              },
              slidePrevTransitionStart: function () {
                if (touchMoving) GA.swiper_touch($word2, 'prev');
              },
              slideNextTransitionStart: function () {
                if (touchMoving) GA.swiper_touch($word2, 'next');
              },
              slideChange: function () {
                if (this.activeIndex === 0) {
