    }

    function otLoadScript(url, callback = () => {}) {
      var script = document.createElement('script');
      script.type = 'text/javascript';
      script.src = url;
      script.defer = true;

      if (script.readyState) {  // IE
          script.onreadystatechange = function() {
              if (script.readyState == 'loaded' || script.readyState == 'complete') {
                  script.onreadystatechange = null;
                  callback();
              }
          };
      } else {  // Other browsers
          script.onload = function() {
              callback();
          };
      }

      document.getElementsByTagName('head')[0].appendChild(script);
    }
    // Stylesheets ride along inside the JS bundles (window.otStyles) instead of
    // being fetched as .css assets. Every caller passes a slotId so the rules land
    // in a fixed spot in the document; appending to <body> is only a fallback for a
    // stale snippet, and it puts the rules after #ot-custom-css.
    function otInjectStyle(key, slotId) {
        const css = (window.otStyles || {})[key];
        if (!css) return;

        if (slotId) {
          const slot = document.getElementById(slotId);
          if (slot) {
            slot.textContent = css;
            return;
          }
        }

        const style = document.createElement("style");
        style.textContent = css;
        document.getElementsByTagName("body")[0].appendChild(style);
    }

    function otGetResouceFile(fileName) {
      const listFile = [{
        key: 'full',
