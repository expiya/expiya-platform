var tmsVETranslationData =[{"base_text":"Understand","published_trans_text":{"ru":"Понимают"}},{"base_text":"\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003eSmart Watches \u0026amp; Bands","published_trans_text":{"ru":"Смарт часы и браслеты"}},{"base_text":"After a day of intense exercise, wear your \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eHelio Ring\u003c/no-translate\u003e\u003c/no-translate\u003e while you sleep. In the morning, you'll get a Readiness score and insight\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e1\u003c/no-translate\u003e\u003c/sup\u003e based on your mental and physical recovery.\u0026nbsp;","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eПосле дня интенсивных тренировок наденьте\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eHelio Ring\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eпока вы спите. Утром вы получите оценку готовности и аналитическую информацию\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eна основе вашего психического и физического восстановления.\u0026nbsp;\u003c/font\u003e"}},{"base_text":"Over \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e Weeks of","published_trans_text":{"ru":"Более Недель"}},{"base_text":"Ultimate Outdoor GPS Smartwatch","published_trans_text":{"ru":"Лучшие умные часы с GPS на открытом воздухе"}},{"base_text":"Ultimate Outdoor GPS Smartwatch","published_trans_text":{"ru":"Лучшие умные часы с GPS для активных людей\u0026nbsp;"}},{"base_text":"Performance Series","published_trans_text":{"ru":"Серия Performance"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eGTR\u003c/no-translate\u003e Mini","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eGTR Mini\u003c/no-translate\u003e"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Band 7","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit Band\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e7\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Prime Your Mind.","published_trans_text":{"ru":"Контролируйте свой разум."}},{"base_text":"Learn about our","published_trans_text":{"ru":"Узнайте о нашей"}},{"base_text":"SUPPORT","published_trans_text":{"ru":"ПОДДЕРЖКА"}},{"base_text":"Premium subscribers of \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Aura can also enjoy access to the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Wellness Coach, which proactively prepares daily, weekly and monthly analysis of your sleep, and uses applied Large Language Models (LLM) to answer your questions.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eПремиум-подписчики\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eАура также могут получить доступ к\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eWellness Coach, который заранее готовит ежедневный, еженедельный и ежемесячный анализ вашего сна и использует прикладные модели Большого Языка (LLM), чтобы ответить на ваши вопросы.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Get the inside scoop on \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e !","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eУзнать больше об Amazfit\u003c/no-translate\u003e !"}},{"base_text":"Heart Rate Tracking","published_trans_text":{"ru":"Отслеживание сердечного ритма"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Актив","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit Active\u003c/no-translate\u003e"}},{"base_text":"the Fearless.","published_trans_text":{"ru":"бесстрашных."}},{"base_text":"Speak up whenever you want to adjust watch settings, check \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Coach™ progress or your readiness score, and more. No need to tap, swipe, or memorize keywords.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eСообщите, если вы хотите изменить настройки часов, проверьте прогресс\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u0026nbsp;Coach™ или оценку вашей готовности и многое другое. Не нужно нажимать, проводить пальцем или запоминать ключевые слова.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"The Finer Side of Fitness","published_trans_text":{"ru":"Прекрасная сторона фитнеса"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Cheetah (круглые)","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit Cheetah\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e (круглые)\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Battle 70℃ heat, brave extreme -30℃ cold\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e\u003c/sup\u003e, or plunge into 100 meter-deep waters\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e4\u003c/no-translate\u003e\u003c/sup\u003e\u003cspan style=\"letter-spacing: 0.24px; text-align: inherit;\"\u003e.\u003c/span\u003e","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eСражайтесь с 70℃ жарой, смело встречайте экстремальный -30℃ холод\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e, или погрузитесь в воду глубиной 100 метров\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003e News","published_trans_text":{"ru":"Новости\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003e"}},{"base_text":"Privacy and security are priorities with Zepp Pay. So, before you can activate it, you'll need to enable the off-wrist lock function of your Amazfit Balance, and then safeguard your transactions by settings up a passcode.","published_trans_text":{"ru":"Конфиденциальность и безопасность являются приоритетами дляZeppPay. Поэтому, прежде чем вы сможете активировать его, вам необходимо включить функцию блокировки вашего устройства Amazfit Balance, а затем защитите свои транзакции, установив пароль."}},{"base_text":"Умные часы и бренды","published_trans_text":{"ru":"Умные часы"}},{"base_text":"Health-Centered \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e OS \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e.\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e0\u003c/no-translate\u003e","published_trans_text":{"ru":"Операционная система Zepp ОС 3.0, ориентированная на здоровье."}},{"base_text":"The watch models receiving upgrades include the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eT-Rex\u003c/no-translate\u003e\u003c/no-translate\u003e Ultra\u003c/no-translate\u003e, \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eFalcon\u003c/no-translate\u003e\u003c/no-translate\u003e, and \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Cheetah Series. Here's an overview of what's in-store - for the full breakdown, make sure to check out the official update log when you download it.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eМодели часов, получающие обновления, включают:\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eT-Rex\u003c/no-translate\u003e\u003c/no-translate\u003e Ultra\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e,\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eFalcon\u003c/no-translate\u003e\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e, и\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eСерия Cheetah. Вот обзор того, что есть в магазине — для получения полной информации обязательно ознакомьтесь с официальным журналом обновлений при его загрузке.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Days  with Typical Usage\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e7\u003c/no-translate\u003e\u003c/sup\u003e","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eДней типичного использования\u003c/font\u003e"}},{"base_text":"Weightless Power","published_trans_text":{"ru":"Невесомая сила"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eGTR\u003c/no-translate\u003e 3 Pro","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eGTR\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e3 Pro\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"In-Depth Monitoring\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e2\u003c/no-translate\u003e\u003c/sup\u003e of","published_trans_text":{"ru":"Углубленный мониторинг"}},{"base_text":"Packing List","published_trans_text":{"ru":"Комплектация"}},{"base_text":"A sensitivity option has been introduced to the auto-detection of the downhill phase in Skiing, Snowboarding, and Alpine Skiing modes. This addition helps to further improve data accuracy for all winter sports lovers taking to the slopes.","published_trans_text":{"ru":"Добавлена опция распознавания для автоматического определения фазы спуска в режимах катания на лыжах, сноуборде и горных лыжах. Это дополнение помогает еще больше повысить точность данных для всех любителей зимних видов спорта, катающихся на склонах."}},{"base_text":"AMOLED experience.","published_trans_text":{"ru":"Технология AMOLED"}},{"base_text":"FEEL BETTER","published_trans_text":{"ru":"ЧУВСТВУЙТЕ СЕБЯ ЛУЧШЕ"}},{"base_text":"PPI","published_trans_text":{"ru":"​PPI"}},{"base_text":"Sports Modes","published_trans_text":{"ru":"Спортивных режимов"}},{"base_text":"Download free offline maps\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e7\u003c/no-translate\u003e\u003c/sup\u003e and route files, and get turn directions that can be read on the display or read aloud via connected Bluetooth headphones\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e8\u003c/no-translate\u003e\u003c/sup\u003e.","published_trans_text":{"ru":"Загрузите бесплатные офлайн-карты\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eи файлы маршрутов, а также получайте инструкций по поворотам, которые можно прочитать на дисплее или воспроизвести вслух через подключенные наушники Bluetooth\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e."}},{"base_text":"Fashion can't be boxed into a square. Color outside the lines and embrace what makes you exceptional, with the classy round \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eGTR\u003c/no-translate\u003e Mini.","published_trans_text":{"ru":"Мода не может быть помещена в квадрат. Мыслите нестандартно и примите то, что делает вас исключительным, с классными круглыми Amazfit GTR Mini."}},{"base_text":"Support","published_trans_text":{"ru":"Поддержка"}},{"base_text":"If your bank is not supported, you can sign up for a Curve account. Curve is a digital smart-wallet with an accompanying debit card (digital and physical). To use Zepp Pay via Curve, simply add your bank card to Curve and then add your Curve card to Zepp Pay.","published_trans_text":{"ru":"Если ваш банк не поддерживается, вы можете зарегистрировать учетную запись Curve. Curve — это цифровой смарт-кошелек, к которому прилагается дебетовая карта (цифровая и физическая). ИспользоватьZeppОплатите через Curve: просто добавьте свою банковскую карту в Curve, а затем добавьте свою карту Curve вZeppPay."}},{"base_text":"Tracking.","published_trans_text":{"ru":"Менструального цикла"}},{"base_text":"The watch face store in the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App contains a huge selection of free watch face options for your \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e smart watch or band.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eМагазин циферблатов в\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eПриложении содержит огромный выбор бесплатных вариантов циферблата для ваших\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Forge and Navigate","published_trans_text":{"ru":"Создавайте и следуйте"}},{"base_text":"Amazfit T-Rex 2","published_trans_text":{"ru":"Amazfit T-Rex 2"}},{"base_text":"Heart Rate, SpO\u003csub\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e2\u003c/no-translate\u003e\u003c/sub\u003e \u0026amp; Stress Tracking","published_trans_text":{"ru":"Частота сердечных сокращений, SpO и отслеживание стресса"}},{"base_text":"120+ Sports Modes \u0026amp; Smart Recognition \u003cbr\u003e5 ATM Water-resistance","published_trans_text":{"ru":"Более 120 спортивных режимов и интеллектуальное распознаваниеВодонепроницаемость 5 АТМ"}},{"base_text":"Auto-detection of \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e7\u003c/no-translate\u003e Sports","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eАвтоматическое обнаружение\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eВидов спорта\u003c/font\u003e"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Актив Эдж","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit Active Edge\u003c/no-translate\u003e"}},{"base_text":"GPS Max Battery Life","published_trans_text":{"ru":"Максимальное время работы батареи GPS"}},{"base_text":"Dismiss","published_trans_text":{"ru":"Отказ"}},{"base_text":"Got a marathon coming up? The \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App can analyze the data from your recorded runs - along with your current physical fitness status - to generate race predictions\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e\u003c/sup\u003e for 3KM, \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e2\u003c/no-translate\u003e mile, \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e mile, 5KM, 10KM, half marathon, and full marathon races.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eСкоро марафон?\u0026nbsp;\u003c/font\u003eZepp\u0026nbsp;\u003cfont style=\"vertical-align: inherit;\"\u003eПриложение может анализировать данные ваших записанных пробежек, а также ваше текущее состояние физической подготовки, чтобы генерировать прогнозы соревнований\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eна 3 км,\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e5 км, 10 км, полумарафон и полный марафон.\u003c/font\u003e"}},{"base_text":"UP YOUR GAME! \u003ca href=\"https://www.amazfit.com/pages/about\" style=\"color: red\"\u003eLearn More\u003c/a\u003e","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\n \u0026nbsp;УЛУЧШАЙ ИГРУ!\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003ca href=\"https://www.amazfit.com/pages/about\" style=\"color: red;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eУзнать больше\u003c/font\u003e\u003c/font\u003e\u003c/a\u003e"}},{"base_text":"Your Amazfit smartwatch is already an important part of your everyday life, in keeping you healthy and active.","published_trans_text":{"ru":"Умные часы Amazfit уже являются важной частью вашей повседневной жизни, поддерживая здоровье и активный образ жизни."}},{"base_text":"Subscribe to \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Fitness Membership for detailed weekly and monthly fitness reports, and access to a sports-focused AI chatbot answers your questions like your very own personal trainer.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eПодписаться на\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eЧленство в фитнесе для получения подробных еженедельных и ежемесячных отчетов о фитнесе, а также доступа к чат-боту с искусственным интеллектом, ориентированному на спорт, отвечающему на ваши вопросы, как ваш личный тренер.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Quick Release Wristband","published_trans_text":{"ru":"Быстросъемный браслет"}},{"base_text":"Already own an \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e sportswatch? Wear it together with the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eHelio Ring\u003c/no-translate\u003e\u003c/no-translate\u003e and enhance your fitness journey.When worn together, your data from both devices can be fused for an even deeper well of information for the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App to draw from.\u0026nbsp;","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eУ вас уже есть\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eспортивные часы? Носите их вместе с\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eHelio Ring\u0026nbsp;\u003c/no-translate\u003e\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eи улучшайте своё фитнес-путешествие. При совместном ношении ваши данные с обоих устройств могут быть объединены для получения еще более глубокой информации для\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eПриложения.\u0026nbsp;\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Your Lifestyle Hub.","published_trans_text":{"ru":"центр вашего образа жизни."}},{"base_text":"Bold Dual-Tone Swagger.","published_trans_text":{"ru":"Смелый двухцветный дизайн."}},{"base_text":"Battery Saver Mode Battery Life","published_trans_text":{"ru":"Режим экономии заряда батареи Срок работы батареи"}},{"base_text":"Dive deep into your fitness journey with insightful weekly and monthly snapshots. Sharpen your focus, reach those milestones.","published_trans_text":{"ru":"Погрузитесь в своё фитнес-путешествие с помощью подробных еженедельных и ежемесячных снимков. Сосредоточьте свое внимание, достигните целей."}},{"base_text":"Personalize your \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e smartwatch experience by downloading\u0026nbsp;","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eПерсонализируйте свои\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e, загрузив\u0026nbsp;\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Whatever training split you're following, create your own strength training templates\u003csup\u003e11\u0026nbsp;\u003c/sup\u003ein the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App, sync them to the watch, and then lift your way through your routine for the day.","published_trans_text":{"ru":"Какой бы тренировочной системы вы ни придерживались, создайте свои собственные шаблоны силовых тренировок\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e в\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eПриложении Zepp, синхронизируйте их с часами, а затем приступайте к выполнению своих ежедневных дел."}},{"base_text":"Amazfit Smart Scale","published_trans_text":{"ru":"Умные весы Amazfit"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Flow™","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\"\u003eZepp Flow\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e™\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"An \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eActive\u003c/no-translate\u003e Body Needs a\u0026nbsp;","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eАктивное Тело нуждается в\u0026nbsp;\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"The \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eT-Rex\u003c/no-translate\u003e\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e comes with a free strap-changing kit, which makes it super easy to replace the standard strap with one of your choosing.\u0026nbsp;","published_trans_text":{"ru":"В комплектацию входит бесплатный комплект для замены ремешка, который позволяет с легкостью заменить стандартный ремешок на любой другой по вашему выбору.\u0026nbsp;"}},{"base_text":"Meet the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eActive\u003c/no-translate\u003e\u003c/no-translate\u003e. Your enduring companion.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eВстречайте\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eActive\u003c/no-translate\u003e\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e. Ваш верный спутник.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Сокол","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit Falcon\u003c/no-translate\u003e"}},{"base_text":"Import route files from the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App and navigate\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e6\u003c/no-translate\u003e\u003c/sup\u003e all your favorite paths with incredible precision.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eИмпортируйте файлы маршрутов из приложения\u0026nbsp;\u003c/font\u003eZepp\u003cfont style=\"vertical-align: inherit;\"\u003e и найдите\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eвсе ваши любимые пути с невероятной точностью.\u003c/font\u003e"}},{"base_text":"Feeling out of balance this morning? Understand why, by checking your Readiness insights\u003csup\u003e2\u003c/sup\u003e in the Zepp App.\u0026nbsp;","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eЧувствую себя несбалансированно\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eэтим утром? Узнайте, почему, проверив статистику готовности.\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eв\u003c/font\u003eZepp\u003cfont style=\"vertical-align: inherit;\"\u003eПриложение.\u0026nbsp;\u003c/font\u003e"}},{"base_text":"Other","published_trans_text":{"ru":"Другое"}},{"base_text":"Lightweight, skin-friendly and breathable, the vegan leather strap material is responsibly chic, with no animals being harmed or toxic substances being produced during development.","published_trans_text":{"ru":"Легкий, приятный для кожи и дышащий материал ремешка из веганской кожи выглядит шикарно, при его разработке не причиняется вред животным и не выделяются токсичные вещества."}},{"base_text":"How to Use Zepp Pay.","published_trans_text":{"ru":"Как использоватьZeppPay."}},{"base_text":"Transactions.","published_trans_text":{"ru":"транзакции."}},{"base_text":"And when enabled, the watch's Automatic GPS battery mode will intelligently adjust GPS settings based on signal strength, to help conserve power.","published_trans_text":{"ru":"Автоматический режим работы от батареи GPS в часах будет разумно регулировать настройки GPS в зависимости от уровня сигнала, чтобы помочь экономить энергию."}},{"base_text":"Claim a free\u0026nbsp;\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Fitness trial as an \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eHelio Ring\u003c/no-translate\u003e\u003c/no-translate\u003e user. Enjoy detailed weekly and monthly fitness reports, and access to an AI chatbot that answers your questions.","published_trans_text":{"ru":"Получите бесплатную пробную версию Zepp Фитнес Amazfit Helio Ring. Наслаждайтесь подробными еженедельными и ежемесячными отчетами о фитнесе и доступом к чат-боту с искусственным интеллектом, который отвечает на ваши вопросы."}},{"base_text":"Your\u0026nbsp;Personal\u0026nbsp;Sports\u0026nbsp;and\u0026nbsp;Health\u0026nbsp;Companion\u0026nbsp;-\u0026nbsp;\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App","published_trans_text":{"ru":"Ваш личный компаньон для спорта и здоровья -\u003cno-translate data-markjs=\"true\"class=\"notranslate\"\u003e Zepp\u003c/no-translate\u003e Приложение"}},{"base_text":"The \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eBalance\u003c/no-translate\u003e\u003c/no-translate\u003e is now available in four Special Edition colors, with each name inspired by the harmony found in the natural world.","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eBalance\u0026nbsp;\u003c/no-translate\u003e\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eтеперь доступен в четырех цветах Special Edition, каждое из которых вдохновлено гармонией мира природы.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Resist the Pressure","published_trans_text":{"ru":"Сопротивление давлению"}},{"base_text":"Advanced Maps and Navigation","published_trans_text":{"ru":"Продвинутая навигация и карты"}},{"base_text":"Kelvin Kiptum","published_trans_text":{"ru":"Фонд Кельвина Киптума"}},{"base_text":"Bolster your options for health, fitness, outdoor sports, and smart living, by choosing from hundreds of \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003emini\u003c/no-translate\u003e apps ready for download from the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eРасширьте свои возможности для здоровья, фитнеса, занятий спортом на открытом воздухе и разумного образа жизни, выбрав из сотен\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003emini\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eприложений, готовых к загрузке из приложения\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Typical Usage Scenario Battery Life","published_trans_text":{"ru":"Типичный сценарий использования Срок работы батареи"}},{"base_text":"Optimization of \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Coach's Running Plan","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eОптимизация плана бега в Zepp Coach\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Learn More","published_trans_text":{"ru":"Узнать больше"}},{"base_text":"UP YOUR GAME! \u003ca href=\"https://www.amazfit.com/pages/about\" style=\"color: red\"\u003eLearn More\u003c/a\u003e","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\n \u0026nbsp;УЛУЧШАЙ ИГРУ!\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003ca href=\"https://www.amazfit.com/pages/about\" style=\"color: red;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eУзнать больше\u003c/font\u003e\u003c/font\u003e\u003c/a\u003e"}},{"base_text":"We're thrilled to announce an array of exciting upgrades to select smartwatches in our Performance and Adventure Series. Scheduled for late February through early March 2024, these upgrades promise to elevate your activities and experiences to new heights, whether you're pushing your limits in the gym or exploring the great outdoors.","published_trans_text":{"ru":"Мы рады объявить о ряде интересных обновлений для некоторых умных часов из серий Performance и Adventure. Эти обновления, запланированные на конец февраля — начало марта 2024 года, обещают поднять вашу производительность и впечатления на новую высоту, независимо от того, расширяете ли вы свои возможности в тренажерном зале или исследуете природу."}},{"base_text":"Access Zepp Pay in the app menu list, shortcut cards, or via double-tapping the crown.","published_trans_text":{"ru":"Найдите ZeppPay в списке меню приложений, на карточках быстрого доступа или двойным нажатием на корону."}},{"base_text":"Access to an AI chatbot, which proactively analyzes your sleep, and answers your wellness questions.","published_trans_text":{"ru":"Доступ к чат-боту с ИИ, который активно анализирует ваш сон и отвечает на ваши вопросы о самочувствии."}},{"base_text":"Amazfit Band 7 Strap","published_trans_text":{"ru":"Ремешок для Amazfit Band 7"}},{"base_text":"With its super large, bright display and military-grade\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e1\u003c/no-translate\u003e\u0026nbsp;\u003c/sup\u003ebody, the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eT-Rex\u003c/no-translate\u003e\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e is ready for any challenge you set your sights on.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eБлагодаря своему большому, яркому дисплею и прочности корпуса военного стандарта\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e,\u0026nbsp;\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate tms-translate-node\" tms-node-index=\"Amazfit\" tms-node-index-raw=\"Amazfit\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate tms-translate-node\" tms-node-index=\"T-Rex\" tms-node-index-raw=\"T-Rex\"\u003eT-Rex3\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eготов к любым вызовам, которые вы поставите перед собой.\u003c/font\u003e"}},{"base_text":"Download an offline map and a matching route file from the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App, and you'll always be moving towards your finish line.\u0026nbsp;","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eЗагрузите автономную карту и соответствующий файл маршрута с приложения\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e, и вы всегда будете двигаться к финишу.\u0026nbsp;\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Able to reach \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e2\u003c/no-translate\u003e,000 nits peak brightness\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e2\u003c/no-translate\u003e\u003c/sup\u003e, the AMOLED display makes every turn on your map and every detail of your workouts clear at a glance.\u0026nbsp;","published_trans_text":{"ru":"Пиковая яркость может достигать 2000 Нит.\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eБлагодаря AMOLED-дисплею каждый поворот на карте и каждая деталь ваших тренировок будут понятны с первого взгляда.\u0026nbsp;"}},{"base_text":"PeakBeats™","published_trans_text":{"ru":"PeakBeats™"}},{"base_text":"Sign Up Now.","published_trans_text":{"ru":"Регистрируйтесь сейчас."}},{"base_text":"the Ocean","published_trans_text":{"ru":"в Океане"}},{"base_text":"Misty Pink","published_trans_text":{"ru":"Туманно розовый"}},{"base_text":"Choose from over 120 watch faces and always-on displays\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e7\u003c/no-translate\u003e\u003c/sup\u003e, including options that show key outdoor data.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eВыбирайте из более чем 120 циферблатов и постоянно включенных дисплеев.\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e, включая параметры, отображающие ключевые данные об окружающей среде.\u003c/font\u003e"}},{"base_text":"This balance of all the important aspects of your life is made possible by the ultimate lifestyle smartwatch: the new Amazfit Balance.","published_trans_text":{"ru":"Все важные аспекты вашей жизни становятся возможными благодаря лучшим умным часам для образа жизни: новымAmazfit Balance."}},{"base_text":"Enhanced","published_trans_text":{"ru":"Улучшена"}},{"base_text":"VIEW MORE \u003e","published_trans_text":{"ru":"ПОСМОТРЕТЬ БОЛЬШЕ \u003e"}},{"base_text":"Sign up with your email, and join an exclusive club of athletes who we'll keep posted","published_trans_text":{"ru":"Зарегистрируйтесь, указав свой адрес электронной почты, и вступите в эксклюзивный клуб спортсменов, которых мы будем держать в курсе."}},{"base_text":"This score and accompanying insight\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e\u003c/sup\u003e sum up your mental and physical recovery, so you'll know whether to leap into action or plan some time to relax.","published_trans_text":{"ru":"Эта оценка и понимание своего психического и физического восстановления, чтобы вы знали, следует ли приступить к делу или запланировать время для отдыха."}},{"base_text":"Once downloaded, they can be installed or uninstalled directly from your \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e smartwatch - so you'll always have access to the apps you love.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eПосле загрузки их можно установить или удалить непосредственно с вашего компьютера.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Magnificent \u0026 minimalist","published_trans_text":{"ru":"Великолепный и минималистичный"}},{"base_text":"Lightweight","published_trans_text":{"ru":"Легкие"}},{"base_text":"The watch has incorporated a GPS Time Calibration function to address usage scenarios in extreme environments. This addition ensures accurate time display in challenging conditions, bolstering the watch's reliability as you brave the outdoors.","published_trans_text":{"ru":"В часы встроена функция калибровки времени по GPS, позволяющая учитывать сценарии использования в экстремальных условиях. Это дополнение обеспечивает точное отображение времени в сложных условиях, повышая надежность часов, когда выбросаете вызов приключениям."}},{"base_text":"Lead the way, wherever you go. This is your time, so get \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eactive\u003c/no-translate\u003e.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eВедите остальных, куда бы вы ни пошли. Это ваше время, хватайте\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eactive\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"accurate health\u003csup\u003e13\u003c/sup\u003e monitoring.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eточным мониторингом здоровья\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e .\u003c/font\u003e"}},{"base_text":"Activity Tracking","published_trans_text":{"ru":"Отслеживание активности"}},{"base_text":"List with \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eMini\u003c/no-translate\u003e Apps","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eСписок с\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eMini\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eПриложениями\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003e Fitness Gear","published_trans_text":{"ru":"Фитнес оборудование\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003e"}},{"base_text":"Display","published_trans_text":{"ru":"Дисплей"}},{"base_text":"Stay \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eActive\u003c/no-translate\u003e, Stay Healthy","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eОставаться\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u0026nbsp;Активным\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e, оставаться здоровым\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"restore coral ecosystems.","published_trans_text":{"ru":"восстановлению коралловой экосистемы."}},{"base_text":"Choose to enable or disable GPS location data storage, backup your data, and retain downloaded \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003emini\u003c/no-translate\u003e apps if restoring the watch to factory settings.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eВключите или отключите сохранение данных о местоположении GPS. Создайте резервное копирование данных и сохранение загруженных данных. Сохраняйте\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003emini\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eприложения при восстановлении заводских настроек часов.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Living an \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eactive\u003c/no-translate\u003e life is easy when you love your workouts.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eЖить активно легко\u003c/font\u003e\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e, когда ты любишь тренировки.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Blood-oxygen saturation measurement","published_trans_text":{"ru":"Измерение насыщения крови кислородом"}},{"base_text":"Resistant to extreme 70℃ heat and -40℃ cold - as well as humidity, shock and more - this outdoor smartwatch has proved its toughness by passing 15 military-grade tests\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e\u003c/sup\u003e.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eЭти умные часы, устойчивые к экстремальной жаре до 70 ℃ и холоду до -40 ℃, а также к влажности, ударам и многому другому, доказали свою прочность, прошли 15 испытаний военного уровня.\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e.\u003c/font\u003e"}},{"base_text":"Make a Splash.","published_trans_text":{"ru":"Не бойтесь воды."}},{"base_text":"\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Partners","published_trans_text":{"ru":"\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003e\u003cno-translate data-markjs=\"true\"\u003eПартнеры Amazfit\u003c/no-translate\u003e "}},{"base_text":"Powered by \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e OS 2.0","published_trans_text":{"ru":" \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eРаботают на Zepp\u003c/no-translate\u003e OS 2.0"}},{"base_text":"Days  with Heavy Usage","published_trans_text":{"ru":"Дней с интенсивным использованием"}},{"base_text":"In support of World Ocean Day, \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Health will be donating $10 USD for every \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eT-Rex\u003c/no-translate\u003e 2 Ocean Blue (Special Edition) purchased, which will go to supporting coral restoration projects in the Hatamin Marine Protected Area in Indonesia.\u0026nbsp;","published_trans_text":{"ru":"В поддержку Всемирного дня океана компания\u0026nbsp;Zepp\u0026nbsp;Health\u0026nbsp;пожертвует 10 долларов США за каждый приобретенный\u0026nbsp;Amazfit\u0026nbsp;T-Rex\u0026nbsp;2\u0026nbsp;Ocean\u0026nbsp;Blue\u0026nbsp;(Special\u0026nbsp;Edition), которые пойдут на поддержку проектов по восстановлению кораллов в морском заповеднике Хатамин в Индонезии."}},{"base_text":"Health assessment system","published_trans_text":{"ru":"Система оценки здоровья"}},{"base_text":"Partners for","published_trans_text":{"ru":"Партнеры"}},{"base_text":"Planning a trek through an unfamiliar path? Import a route file\u003csup\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e7\u003c/no-translate\u003e\u003c/sup\u003e from the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App, and navigate with incredible precision.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eПланируете поход по незнакомой тропе? Импортируйте файл маршрута\u0026nbsp;\u003c/font\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eиз\u0026nbsp;\u003c/font\u003eZepp\u0026nbsp;\u003cfont style=\"vertical-align: inherit;\"\u003eПриложения и перемещайтесь с невероятной точностью.\u003c/font\u003e"}},{"base_text":"Go Bigger, Go Smarter","published_trans_text":{"ru":"Стали больше, стали умнее"}},{"base_text":"Wear when you want a silent partner to track your recovery in the background, like when you're resting, sleeping, or just living life.","published_trans_text":{"ru":"Носите его, если вы хотите, чтобы молчаливый партнер отслеживал ваше восстановление в фоновом режиме, например, когда вы отдыхаете, спите или просто живете своей жизнью."}},{"base_text":"The watch also introduces a new Endurance GPS battery mode for those who love to lose themselves in nature for long periods of time.","published_trans_text":{"ru":"В часах также представлен новый режим работы от батареи Endurance GPS для тех, кто любит надолго уходить из дома."}},{"base_text":"\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003e About \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e","published_trans_text":{"ru":"\u003cspan class=\"megaitemicons\"\u003e\u003c/span\u003eИстория\u0026nbsp;\u003cno-translate data-markjs=\"true\"\u003eAmazfit\u003c/no-translate\u003e"}},{"base_text":"For every sale of the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eBalance\u003c/no-translate\u003e\u003c/no-translate\u003e Special Edition colors, \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e Health will donate $2 to support One Tree Planted's urban forestry projects in Europe, with trees being planted by local partner organizations and community volunteers in areas where deforestation has occurred.","published_trans_text":{"ru":"\u003cspan class=\"Y2IQFc\" lang=\"ru\"\u003eЗа каждую продажу цветов Amazfit Balance Special Edition Zepp Health будет жертвовать 2 доллара на поддержку городских лесохозяйственных проектов One Tree Planted в Европе, при этом деревья будут сажать местные партнерские организации и общественные волонтеры в районах, где произошла вырубка лесов.\u003c/span\u003e"}},{"base_text":"the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e App","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eПриложению Zepp\u003c/font\u003e"}},{"base_text":"The Legacy Grey's commemorative design honors Kelvin Kiptum's pride for his home by incorporating the Kenyan","published_trans_text":{"ru":"Памятный дизайн Legacy Grey отдает дань уважения Кельвину Киптуму , включив в него кенийский дизайн."}},{"base_text":"The Essential","published_trans_text":{"ru":"Базовые"}},{"base_text":"Cheetah (Round)","published_trans_text":{"ru":"Cheetah (круглые)"}},{"base_text":"the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eActive\u003c/no-translate\u003e\u003c/no-translate\u003e will be right there with you.","published_trans_text":{"ru":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eActive\u0026nbsp;\u003c/no-translate\u003e\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eбудет рядом с вами.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZEPP\u003c/no-translate\u003e OS \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e.\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e5\u003c/no-translate\u003e","published_trans_text":{"ru":"ZEPP ОС 3.5"}},{"base_text":"Your Ascent","published_trans_text":{"ru":"для восхождения"}},{"base_text":"Discovery","published_trans_text":{"ru":"​НОВОСТИ"}},{"base_text":"Own your recovery.","published_trans_text":{"ru":"Управляйте своим восстановлением."}},{"base_text":"Cheetah","published_trans_text":{"ru":"​Cheetah"}},{"base_text":"All-day fitness tracking","published_trans_text":{"ru":"Отслеживание фитнеса в течение всего дня"}},{"base_text":"Recovered Mind","published_trans_text":{"ru":"спокойном разуме"}},{"base_text":"Celebrate his legacy with this Commemorative Edition watch.","published_trans_text":{"ru":"Поддержите его наследие с помощью этих часов Commemorative Edition."}},{"base_text":"НОВОСТИ","published_trans_text":{"ru":"​НОВОСТИ"}},{"base_text":"Fitness.","published_trans_text":{"ru":"Фитнесу."}},{"base_text":"Health \u0026 Fitness","published_trans_text":{"ru":"Здоровья и фитнеса"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Up","published_trans_text":{"ru":"Amazfit Up"}},{"base_text":"Sports","published_trans_text":{"ru":"Видов спорта"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eZepp\u003c/no-translate\u003e OS \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e.\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e5\u003c/no-translate\u003e","published_trans_text":{"ru":"Zepp OS\u003cfont style=\"vertical-align: inherit;\"\u003e\u003c/font\u003e"}},{"base_text":"Find Your Edge","published_trans_text":{"ru":"Найди свой предел"}},{"base_text":"Get reward","published_trans_text":{"ru":"Награды"}},{"base_text":"Battery Life","published_trans_text":{"ru":"Срок работы батареи"}},{"base_text":"From detailed altitude data, to severe weather alerts, to environmental information, the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eT-Rex\u003c/no-translate\u003e\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e3\u003c/no-translate\u003e has everything you need to adventure with confidence.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003eОт подробных данных о высоте до предупреждений об опасных погодных условиях и информации об окружающей среде —в\u0026nbsp;\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate tms-translate-node\" tms-node-index=\"Amazfit\" tms-node-index-raw=\"Amazfit\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate tms-translate-node\" tms-node-index=\"T-Rex\" tms-node-index-raw=\"T-Rex\"\u003eT-Rex\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eесть все необходимое для уверенного путешествия.\u003c/font\u003e"}},{"base_text":"Whatever kind of activity makes you want to get moving, the \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eActive\u003c/no-translate\u003e\u003c/no-translate\u003e Edge\u003c/no-translate\u003e has your back.","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eКакой бы вид деятельности ни вызывал у вас желание двигаться,\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eActive\u003c/no-translate\u003e\u003c/no-translate\u003e Edge поддержит вас\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e.\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"AmazfitGTR Ltd Edition","published_trans_text":{"ru":"AmazfitGTR LE"}},{"base_text":"Endurance GPS Mode","published_trans_text":{"ru":"Режим Endurance GPS"}},{"base_text":"Кольцо \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e Helio","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eКольцо\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u0026nbsp;Helio\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Through these exciting upgrades, we hope to empower you to achieve your goals and take your sports performance to the next level. Stay tuned for more \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e updates!","published_trans_text":{"ru":"\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eМы надеемся, что благодаря этим потрясающим обновлениям вы сможете достичь своих целей и поднять свои спортивные результаты на новый уровень. Оставайтесь с нами, чтобы узнать больше об\u0026nbsp;\u003c/font\u003e\u003c/font\u003e\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u0026nbsp;\u003c/no-translate\u003e\u003cfont style=\"vertical-align: inherit;\"\u003e\u003cfont style=\"vertical-align: inherit;\"\u003eобновлениях!\u003c/font\u003e\u003c/font\u003e"}},{"base_text":"Heavy Usage","published_trans_text":{"ru":"Интенсивное использование"}},{"base_text":"\u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eAmazfit\u003c/no-translate\u003e \u003cno-translate data-markjs=\"true\" class=\"notranslate\"\u003eT