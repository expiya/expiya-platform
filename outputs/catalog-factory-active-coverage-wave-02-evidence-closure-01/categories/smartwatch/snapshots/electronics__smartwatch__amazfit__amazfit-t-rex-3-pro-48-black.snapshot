            <!-- Desktop Megamenu Options -->

            <script>
              $(document).ready(function(){
                $('.scroll').slick({
                  slidesToShow: 4,
                  slidesToScroll: 1,
                  arrows: true,
                  dots: false,
                  infinite: false,
                  cssEase: 'linear',
                  responsive: [
                    {
                      breakpoint: 1199,
                      settings: "unslick",
                    }
                  ]
                });

                $('.mm_header').hover(function(){
                  if($(this).hasClass('has-mm')){
                    $(this).next().addClass('mm-popup-open');
                  }
                },function(){
                  if($(this).hasClass('has-mm')){
                    $(this).next().removeClass('mm-popup-open');
                  }
                });
                $('.category-item').hover(function(){
                  $(this).find('.animated').addClass('show-content');
                  $('.category-item').removeClass('selected');
                  $(this).addClass('selected');
                });
                $('.custom-nav-list li').hover(function(){
                  let x = $(this).find('.category-item:first-child');
                  x.addClass('selected');
                  $('.animated').removeClass('show-content');
                  x.find('.animated').addClass('show-content');
                });
              });
            </script>
