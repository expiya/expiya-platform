                <div class="desktop-only">
                    <!-- /* 전체 Empty: .rating--empty 추가 */ -->
                    <span class="rating">
                      <span class="rating__inner">
                        <span class="rating__star-list">
                            <!-- /* style="width: %;"로 적용
                                Full : style="width: 100%;"
