				<p class="pd-get-stock-alert-popup__final-desc">
					Ürün tekrar stoklara girdiğinde size bir e-posta göndereceğiz.
					<br/>Teşekkür ederiz.
				</p>
			
			<div class="pd-get-stock-alert-popup__final-btn-wrap">
            
				
				<button class="pd-get-stock-alert-popup__final-btn-close cta cta--contained cta--emphasis" an-tr="pd21_product finder / cards-product detail-stock alert popup-buy_cta" an-ca="buy cta" an-ac="stock alert" an-la="stock alert:submit">Gönder</button>
				
				
				
			</div>
			<button class="pd-get-stock-alert-popup__close">
				<span class="hidden">Close popup</span>
				<svg class="icon" focusable="false" aria-hidden="true">
					<use xlink:href="#delete-bold" href="#delete-bold"></use>
				</svg>
			</button>
		</div>
	</div>
</section>

	
	
	











