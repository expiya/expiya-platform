   <!-- Smart Reply --> 
   <div class="smart-reply"> 
    <div class="common__wrap common__wrap--row-r"> 
     <div class="common__text"> 
      <h2 class="common__sub-headline" data-copy-set="C28-001">Yapay zeka ile hareket halindeyken yanıt önerileri alın</h2> 
      <p class="common__description" data-copy-set="C28-002"> Arkadaşlarınıza anında, doğru bir üslupla yanıt verin. <strong>Galaxy AI</strong>, sohbetinizdeki mesajları analiz eder ve Smart Reply ile konuşmanın ruh haline uygun şekilde <strong>hızlı yanıt</strong> önerileri sunar. <sup> <a href="#desc-section" class="click_sup" title="Sorumluluk reddi beyanını okuyun" data-sup-tag="sup-40"></a>, <a href="#desc-section" class="click_sup" title="Sorumluluk reddi beyanını okuyun" data-sup-tag="sup-41"></a>, <a href="#desc-section" class="click_sup" title="Sorumluluk reddi beyanını okuyun" data-sup-tag="sup-42"></a> </sup> </p> 
     </div> 
     <div class="common__content"> 
      <div class="smart-reply__image"> 
       <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-img-src js-res-img" data-copy-set="C28-003" data-src-pc="https://images.samsung.com/tr/galaxy-watch-ultra/feature/galaxy-watch-ultra-smart-responses-pc.jpg" data-src-mobile="https://images.samsung.com/tr/galaxy-watch-ultra/feature/galaxy-watch-ultra-smart-responses-mo.jpg" alt="Galaxy Watch Ultra ekranında bir mesaj sohbeti var ve cihazın üzerinde Galaxy AI tarafından üretilmiş yanıt önerileri gösteriliyor."> 
      </div> 
     </div> 
    </div> 
   </div> 
   <!-- -gesture --> 
   <div class="gesture"> 
    <div class="common__wrap common__wrap--column between"> 
     <div class="common__text"> 
      <h2 class="common__sub-headline" data-copy-set="C29-001">Çift Sıkıştırma hareketi ile hiçbir anı kaçırmayın</h2> 
      <p class="common__description" data-copy-set="C29-002"> Fotoğraf çekmek, aramaları yanıtlamak veya alarmı kapatmak için sadece <strong>Çift Sıkıştırma</strong> hareketi yeterlidir. Galaxy Watch Ultra, diğer Samsung Galaxy cihazlarla <strong>eşleştirildiğinde</strong> daha da güçlüdür. Kontrolü kaybetmeyin, bağlantıyı koparmayın. <sup> <a href="#desc-section" class="click_sup" title="Sorumluluk reddi beyanını okuyun" data-sup-tag="sup-43"></a>, <a href="#desc-section" class="click_sup" title="Sorumluluk reddi beyanını okuyun" data-sup-tag="sup-44"></a> </sup> </p> 
     </div> 
     <div class="common__content"> 
      <div class="gesture__image"> 
       <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-img-src js-res-img" data-copy-set="C29-003" data-src-pc="https://images.samsung.com/tr/galaxy-watch-ultra/feature/galaxy-watch-ultra-gesture-control-pc.jpg" data-src-mobile="https://images.samsung.com/tr/galaxy-watch-ultra/feature/galaxy-watch-ultra-gesture-control-mo.jpg" alt="Galaxy Watch Ultra takmış biri eliyle Çift Sıkıştırma hareketi yapıyor. Yanında, bisiklet süren bir adamın fotoğrafını çeken bir kamera ekranına sahip Kapak ekranıyla, eşleştirilmiş Galaxy Z Fold6 yer alıyor."> 
      </div> 
     </div> 
    </div> 
   </div> 
   <!-- one ui --> 
   <div class="one-ui"> 
    <div class="common__wrap common__wrap--column"> 
     <div class="common__text"> 
      <h2 class="common__sub-headline" data-copy-set="C30-001">Her şey için ayrı bir kordon<br class="common-br-pc"> ve tek bir One UI var </h2> 
      <p class="common__description" data-copy-set="C30-002"> Her tür maceraya hazırsınız çünkü <strong>tüm arazilere</strong> uygun kordon seçeneklerine sahipsiniz. Yepyeni bir işlemciyle desteklenen yeni One UI ile Galaxy Watch Ultra, tüm <strong>heyecan dolu maceralarınızda</strong> yanınızda. <sup> <a href="#desc-section" class="click_sup" title="Sorumluluk reddi beyanını okuyun" data-sup-tag="sup-45"></a> </sup> </p> 
