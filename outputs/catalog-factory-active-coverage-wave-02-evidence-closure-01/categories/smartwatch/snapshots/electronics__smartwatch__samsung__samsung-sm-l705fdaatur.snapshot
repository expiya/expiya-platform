   <!-- samsung health --> 
   <div class="samsung-health"> 
    <div class="common__wrap common__wrap--column between"> 
     <div class="common__text"> 
      <h2 class="common__sub-headline" data-copy-set="C27-001">Sağlık yolculuğunuzu uyumlu hale getirin</h2> 
      <p class="common__description" data-copy-set="C27-002">Samsung Galaxy cihazlarınızdaki Samsung Health uygulaması aracılığıyla genel sağlığınızla ilgili <strong>kapsamlı</strong> bilgilere erişin ve bunları yönetin. Sağlıklı yaşam hedeflerinize ulaşmak için ayrıntılı verileri <strong>entegre edin</strong>. <sup> <a href="#desc-section" class="click_sup" title="Sorumluluk reddi beyanını okuyun" data-sup-tag="sup-28"></a> </sup></p> 
     </div> 
     <div class="common__content"> 
      <div class="samsung-health__image"> 
       <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-img-src js-res-img" data-copy-set="C27-004" data-src-pc="//images.samsung.com/is/image/samsung/assets/tr/galaxy-watch-ultra/feature/galaxy-watch-ultra-samsung-health-pc_1016.jpg" data-src-mobile="//images.samsung.com/is/image/samsung/assets/tr/galaxy-watch-ultra/feature/galaxy-watch-ultra-samsung-health-mo_1016.jpg" alt="Galaxy Ring, Galaxy Z Flip6, Galaxy Buds3, Galaxy Z Fold6 ve Galaxy Watch Ultra bir araya toplanmış ve üstlerinde “Samsung Health” metni yer alıyor. Cihazların üzerinde, uyku takibi ve kalp atış hızı takibi için büyük uygulama simgeleri havada uçuyor."> 
      </div> 
      <div class="samsung-health__cta"> 
       <a href="//shealth.samsung.com/deepLink?sc_id=app.main&amp;action=view&amp;destination=me&amp;src=eStoreWatch" class="wearable-watch-common-cta wearable-watch__cta-round" aria-label="Learn more. Samsung health app download" data-omni-type="microsite_contentinter" data-omni="gwatch-ultra:highlights:samsung-health:link-page:samsung-health" ga-ca="content click" ga-ac="feature" ga-la="gwatch-ultra:highlights:samsung-health:link-page:samsung-health"> <span data-copy-set="C27-003">Daha fazla bilgi</span> </a> 
      </div> 
     </div> 
    </div> 
   </div> 
   <!-- android-connectivity --> 
   <div id="android-connectivity" class="android-connectivity"> 
    <div class="common__wrap common__wrap--row"> 
     <div class="common__text"> 
      <h2 class="common__sub-headline" data-copy-set="C32-001">Tüm Android akıllı telefonlarda sorunsuz bir deneyimin keyfini çıkarın</h2> 
      <p class="common__description" data-copy-set="C32-002">Android akıllı telefonunuzda Galaxy Wearable deneyimine bir şans verin. Galaxy Watch, Buds veya Ring cihazlarınızı halihazırda sahip olduğunuz Android telefonla kolayca eşleştirin. Google Play’den Galaxy Wearable ve Samsung Health uygulamalarını indirdiğinizde hazırsınız bile. Dilerseniz Galaxy Wearable uygulamasında farklı saat kadranlarını deneyin ve zevkinize göre farklı özellikleri seçerek bir arada kullanın. <sup> <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-51"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-52"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-53"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-54"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-55"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-56"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-57"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-58"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-59"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-60"></a> </sup> </p> 
      <div class="android-connectivity__cta"> 
       <a href="//play.google.com/store/apps/details?id=com.samsung.android.app.watchmanager" class="wearable-watch-common-cta wearable-watch__cta-round" aria-label="Galaxy Wearable Uygulaması download" data-omni-type="microsite_contentinter" data-omni="gwatch-ultra:highlights:ad^connect:btm^bnn:glaxy^wearable^app" ga-ca="content click" ga-ac="feature" ga-la="gwatch-ultra:highlights:ad^connect:btm^bnn:glaxy^wearable^app"> <span data-copy-set="C32-003">Galaxy Wearable Uygulaması</span> </a> 
