},\x22Features\x22:{\x22Value\x22:3,\x22Id\x22:\x22Features\x22,\x22DisplayType\x22:\x22NORMAL\x22,\x22Label\x22:\x22Özellikler\x22,\x22MaxLabel\x22:null,\x22ValueLabel\x22:null,\x22MinLabel\x22:null,\x22ValueRange\x22:5}},\x22ContextDataValuesOrder\x22:[],\x22Cons\x22:null,\x22TagDimensionsOrder\x22:[],\x22BadgesOrder\x22:[],\x22AdditionalFields\x22:{},\x22AdditionalFieldsOrder\x22:[],\x22IsSyndicated\x22:false,\x22UserLocation\x22:null,\x22Photos\x22:[],\x22ProductRecommendationIds\x22:[],\x22Pros\x22:null,\x22RatingRange\x22:5,\x22CommentIds\x22:[],\x22ContextDataValues\x22:{},\x22Badges\x22:{},\x22TagDimensions\x22:{},\x22Videos\x22:[],\x22IsTranslateYN\x22:\x22N\x22,\x22ProductPageName\x22:\x22Galaxy Watch Ultra (LTE, 47mm)(SM\u002DL705FZTATUR)\x22,\x22ProductPageUrl\x22:\x22https:\/\/www.samsung.com\/tr\/watches\/galaxy\u002Dwatch\/galaxy\u002Dwatch\u002Dultra\u002Dtitanium\u002Dsilver\u002Dlte\u002Dsm\u002Dl705fztatur\/\x22,\x22MediaTotalCount\x22:0,\x22KeywordlIst\x22:[],\x22TimeAgo\x22:\x222 years ago\x22},{\x22Id\x22:\x22243175050\x22,\x22CID\x22:\x220f559c4c\u002D44b0\u002D55f4\u002D9fdd\u002De76551e73138\x22,\x22SourceClient\x22:\x22samsung\x22,\x22LastModeratedTime\x22:\x222025\u002D07\u002D09T14:15:09.000+00:00\x22,\x22LastModificationTime\x22:\x222025\u002D07\u002D09T14:15:09.000+00:00\x22,\x22ProductId\x22:\x22SM\u002DL705FDAATUR\x22,\x22OriginalProductName\x22:\x22Galaxy Watch Ultra LTE\x22,\x22AuthorId\x22:\x22Jordanboi5galaxysweeps\x22,\x22ContentLocale\x22:\x22en_US\x22,\x22IsFeatured\x22:false,\x22TotalInappropriateFeedbackCount\x22:0,\x22IsSyndicated\x22:true,\x22SyndicationSource\x22:{\x22ClientId\x22:null,\x22LogoImageUrl\x22:\x22https:\/\/photos\u002Dus.bazaarvoice.com\/photo\/2\/cGhvdG86YXR0cmlidXRpb25sb2dvMg\/3f0db944\u002D7f1f\u002D456d\u002Dac37\u002D2291be7453fa\x22,\x22ContentLink\x22:\x22https:\/\/www.samsung.com\/us\/mobile\/wearables\/smartwatches\/galaxy\u002Dwatch\u002Dultra\u002D47mm\u002Dtitanium\u002Dgray\u002Dsm\u002Dl705udaaxaa\/\x22,\x22Name\x22:\x22Samsung US\x22},\x22TotalClientResponseCount\x22:0,\x22TotalCommentCount\x22:0,\x22Rating\x22:4,\x22IsRatingsOnly\x22:false,\x22ModerationStatus\x22:\x22APPROVED\x22,\x22SubmissionTime\x22:\x222025\u002D07\u002D09\x22,\x22ReviewText\x22:\x22[This review was collected as part of a promotion.] Haha, I\x27m just a regular user too. And honestly, those features like sleep apnea, sleep time, and heart rate are awesome. But how important are they to you?\\n\\nI just lift weights and run, so it\x27s cool. The only problem is if you have tattoos, it won\x27t read your heart rate. But, like, that makes sense, right?\\n\\nI don\x27t have cellular service, but you should totally get it. It\x27s super convenient, especially for running. You can listen to music without your phone.\\n\\nOh, and it\x27s kinda big, lol, but for me, it\x27s all about what I like.\\n\\nI wish the watch could announce the quarter times out loud, that would be helpful.\x22,\x22Title\x22:\x22It works?\x22,\x22UserNickname\x22:\x22Jordanboi5\x22,\x22SecondaryRatings\x22:{},\x22ContextDataValuesOrder\x22:[],\x22Cons\x22:null,\x22SecondaryRatingsOrder\x22:[],\x22ClientResponses\x22:[],\x22Helpfulness\x22:null,\x22TagDimensionsOrder\x22:[],\x22BadgesOrder\x22:[],\x22AdditionalFields\x22:{},\x22AdditionalFieldsOrder\x22:[],\x22TotalPositiveFeedbackCount\x22:0,\x22UserLocation\x22:null,\x22Photos\x22:[],\x22ProductRecommendationIds\x22:[],\x22IsRecommended\x22:null,\x22Pros\x22:null,\x22InappropriateFeedbackList\x22:[],\x22RatingRange\x22:5,\x22CommentIds\x22:[],\x22ContextDataValues\x22:{},\x22Badges\x22:{},\x22CampaignId\x22:null,\x22TotalFeedbackCount\x22:0,\x22TagDimensions\x22:{},\x22SubmissionId\x22:null,\x22Videos\x22:[],\x22TotalNegativeFeedbackCount\x22:0,\x22IsTranslateYN\x22:\x22Y\x22,\x22ProductPageName\x22:\x22Galaxy Watch Ultra (LTE, 47mm)(SM\u002DL705FDAATUR)\x22,\x22ProductPageUrl\x22:\x22https:\/\/www.samsung.com\/tr\/watches\/galaxy\u002Dwatch\/galaxy\u002Dwatch\u002Dultra\u002Dtitanium\u002Dgray\u002Dlte\u002Dsm\u002Dl705fdaatur\/\x22,\x22MediaTotalCount\x22:0,\x22KeywordlIst\x22:[],\x22TimeAgo\x22:\x22a year ago\x22},{\x22Id\x22:\x22237455513\x22,\x22CID\x22:\x222c4a50b3\u002Ddbb5\u002D5164\u002Da48f\u002D00bf588a155b\x22,\x22SourceClient\x22:\x22samsung\x22,\x22LastModeratedTime\x22:\x222024\u002D11\u002D15T01:15:09.000+00:00\x22,\x22LastModificationTime\x22:\x222024\u002D11\u002D15T01:15:09.000+00:00\x22,\x22ProductId\x22:\x22SM\u002DL705FDAATUR\x22,\x22OriginalProductName\x22:\x22Galaxy Watch Ultra, 47mm, Titanium Gray\x22,\x22ContextDataValuesOrder\x22:[\x22UsedProduct\x22,\x22Expertise\x22,\x22NumberOwned\x22],\x22UserLocation\x22:\x22PA\x22,\x22AuthorId\x22:\x22sjqr2tz5bcle4eddlk8tllaau\x22,\x22ContentLocale\x22:\x22en_US\x22,\x22IsFeatured\x22:false,\x22TotalInappropriateFeedbackCount\x22:0,\x22IsSyndicated\x22:true,\x22SyndicationSource\x22:{\x22ClientId\x22:null,\x22LogoImageUrl\x22:\x22https:\/\/photos\u002Dus.bazaarvoice.com\/photo\/2\/cGhvdG86YXR0cmlidXRpb25sb2dvMg\/3f0db944\u002D7f1f\u002D456d\u002Dac37\u002D2291be7453fa\x22,\x22ContentLink\x22:null,\x22Name\x22:\x22Samsung US\x22},\x22TotalClientResponseCount\x22:0,\x22TotalCommentCount\x22:0,\x22Rating\x22:4,\x22IsRatingsOnly\x22:false,\x22IsRecommended\x22:true,\x22ModerationStatus\x22:\x22APPROVED\x22,\x22SubmissionTime\x22:\x222024\u002D11\u002D14\x22,\x22ReviewText\x22:\x22Moved up from a Watch 5 Pro.  The 5 Pro was fast, but this Ultra is even faster.  Beautiful display.  Unfortunately, the same issue I saw with the 5 Pro is still present with this model:   it misses most of my floor climbs.  I routinely do 12 \u002D 15 floors every day, but it only records 3 \u002D 4 most days.  Fitbit is much better at recording these accurately.  Other tracking functions appear to be good.  About the same battery life as the 5 Pro, but it seems to charge a little bit more slowly. \\n Disappointed that the magnetic clasp band from the 5 Pro wasn\x27t available on the new one.  Had to replace it with a third party product.  Overall an impressive watch and I do recommend it.\x22,\x22Title\x22:\x22Very nice watch!\x22,\x22UserNickname\x22:\x22Rick\x22,\x22ContextDataValues\x22:{\x22NumberOwned\x22:{\x22Value\x22:\x226to10\x22,\x22Id\x22:\x22NumberOwned\x22,\x22ValueLabel\x22:\x226\u002D10\x22,\x22DimensionLabel\x22:\x22Sahip olduğum SAMSUNG ürün sayısı\x22},\x22Expertise\x22:{\x22Value\x22:\x22Expert\x22,\x22Id\x22:\x22Expertise\x22,\x22ValueLabel\x22:\x22uzman\x22,\x22DimensionLabel\x22:\x22Uzmanlık\x22},\x22UsedProduct\x22:{\x22Value\x22:\x22Under1mo\x22,\x22Id\x22:\x22UsedProduct\x22,\x22ValueLabel\x22:\x22bir aydan daha az\x22,\x22DimensionLabel\x22:\x22Bu ürünü şu kadar süre kullandım\x22}},\x22SecondaryRatings\x22:{},\x22Cons\x22:null,\x22SecondaryRatingsOrder\x22:[],\x22ClientResponses\x22:[],\x22Helpfulness\x22:null,\x22TagDimensionsOrder\x22:[],\x22BadgesOrder\x22:[],\x22AdditionalFields\x22:{},\x22AdditionalFieldsOrder\x22:[],\x22TotalPositiveFeedbackCount\x22:0,\x22Photos\x22:[],\x22ProductRecommendationIds\x22:[],\x22Pros\x22:null,\x22InappropriateFeedbackList\x22:[],\x22RatingRange\x22:5,\x22CommentIds\x22:[],\x22Badges\x22:{},\x22CampaignId\x22:null,\x22TotalFeedbackCount\x22:0,\x22TagDimensions\x22:{},\x22SubmissionId\x22:null,\x22Videos\x22:[],\x22TotalNegativeFeedbackCount\x22:0,\x22IsTranslateYN\x22:\x22Y\x22,\x22ProductPageName\x22:\x22Galaxy Watch Ultra (LTE, 47mm)(SM\u002DL705FDAATUR)\x22,\x22ProductPageUrl\x22:\x22https:\/\/www.samsung.com\/tr\/watches\/galaxy\u002Dwatch\/galaxy\u002Dwatch\u002Dultra\u002Dtitanium\u002Dgray\u002Dlte\u002Dsm\u002Dl705fdaatur\/\x22,\x22MediaTotalCount\x22:0,\x22KeywordlIst\x22:[],\x22TimeAgo\x22:\x22a year ago\x22},{\x22Id\x22:\x22240037116\x22,\x22CID\x22:\x221a3aa9bd\u002D98b4\u002D500d\u002Db919\u002Dbaef631d3822\x22,\x22SourceClient\x22:\x22samsung\x22,\x22LastModeratedTime\x22:\x222025\u002D02\u002D28T17:00:10.000+00:00\x22,\x22LastModificationTime\x22:\x222025\u002D02\u002D28T17:00:10.000+00:00\x22,\x22ProductId\x22:\x22SM\u002DL705FDAATUR\x22,\x22OriginalProductName\x22:\x22Galaxy Watch Ultra LTE\x22,\x22AuthorId\x22:\x22KNIGHTMAREgalaxysweeps\x22,\x22ContentLocale\x22:\x22en_US\x22,\x22IsFeatured\x22:false,\x22TotalInappropriateFeedbackCount\x22:0,\x22IsSyndicated\x22:true,\x22SyndicationSource\x22:{\x22ClientId\x22:null,\x22LogoImageUrl\x22:\x22https:\/\/photos\u002Dus.bazaarvoice.com\/photo\/2\/cGhvdG86YXR0cmlidXRpb25sb2dvMg\/3f0db944\u002D7f1f\u002D456d\u002Dac37\u002D2291be7453fa\x22,\x22ContentLink\x22:\x22https:\/\/www.samsung.com\/us\/mobile\/wearables\/smartwatches\/galaxy\u002Dwatch\u002Dultra\u002D47mm\u002Dtitanium\u002Dgray\u002Dsm\u002Dl705udaaxaa\/\x22,\x22Name\x22:\x22Samsung US\x22},\x22TotalClientResponseCount\x22:0,\x22TotalCommentCount\x22:0,\x22Rating\x22:5,\x22IsRatingsOnly\x22:false,\x22ModerationStatus\x22:\x22APPROVED\x22,\x22SubmissionTime\x22:\x222025\u002D02\u002D25\x22,\x22ReviewText\x22:\x22[This review was collected as part of a promotion.] I got the new galaxy ultra watch and in my opinion this is the best watch I\x27ve gotten by far. It doesn\x27t feel too heavy especially when I wear it to bed I don\x27t feel like it\x27s catching onto my pillow or uncomfortable wearing the device, i love the features of it tracking my blood oxygen while I sleep. How long I was in deep sleep, my body temp. I was worried about this watch since it is a ultra, but i was pleasently surprised and the amount of times I\x27ve hit this device on the wall or scrapped it I\x27ve been so worried about if the device was gonna have cracks or scratches and it still looks as if I just pulled it out of the box. This is by far one my favorite samsung purchases\x22,\x22Title\x22:\x22Durable beautiful watch\x22,\x22UserNickname\x22:\x22KNIGHTMare\x22,\x22SecondaryRatings\x22:{},\x22ContextDataValuesOrder\x22:[],\x22Cons\x22:null,\x22SecondaryRatingsOrder\x22:[],\x22ClientResponses\x22:[],\x22Helpfulness\x22:null,\x22TagDimensionsOrder\x22:[],\x22BadgesOrder\x22:[],\x22AdditionalFields\x22:{},\x22AdditionalFieldsOrder\x22:[],\x22TotalPositiveFeedbackCount\x22:0,\x22UserLocation\x22:null,\x22Photos\x22:[],\x22ProductRecommendationIds\x22:[],\x22IsRecommended\x22:null,\x22Pros\x22:null,\x22InappropriateFeedbackList\x22:[],\x22RatingRange\x22:5,\x22CommentIds\x22:[],\x22ContextDataValues\x22:{},\x22Badges\x22:{},\x22CampaignId\x22:null,\x22TotalFeedbackCount\x22:0,\x22TagDimensions\x22:{},\x22SubmissionId\x22:null,\x22Videos\x22:[],\x22TotalNegativeFeedbackCount\x22:0,\x22IsTranslateYN\x22:\x22Y\x22,\x22ProductPageName\x22:\x22Galaxy Watch Ultra (LTE, 47mm)(SM\u002DL705FDAATUR)\x22,\x22ProductPageUrl\x22:\x22https:\/\/www.samsung.com\/tr\/watches\/galaxy\u002Dwatch\/galaxy\u002Dwatch\u002Dultra\u002Dtitanium\u002Dgray\u002Dlte\u002Dsm\u002Dl705fdaatur\/\x22,\x22MediaTotalCount\x22:0,\x22KeywordlIst\x22:[],\x22TimeAgo\x22:\x22a year ago\x22}]";
						// 1. 'review-cache'라는 이름의 캐시 저장소 열기 (없으면 자동 생성)
						const cache = await caches.open(cachesname);
						
						// 2. JSON 데이터를 Response 객체로 변환 (헤더에 JSON 타입 명시)
						//const jsonString = JSON.stringify(reviewData);
						const response = new Response(listData, {
							headers: { 'Content-Type': 'application/json' ,
			                    'X-Cache-Timestamp' : Date.now().toString() }
						});
						
						// 3. 가상의 URL 경로를 키(Key)로 사용하여 데이터 저장
						await cache.put(cachesdataname, response);
						
					} catch (error) {
						//console.error('#bv_review# - list.html Cache read failure', error);
					}
				}
				// 사용 예시 (리뷰 100건 데이터)
				saveReviewsToCache();
			})();
        </script>
    
    


              
