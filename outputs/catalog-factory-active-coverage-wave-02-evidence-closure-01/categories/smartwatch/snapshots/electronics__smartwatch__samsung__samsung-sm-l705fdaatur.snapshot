      .wearable-watch .battery__info-title+h4{position: relative; top:0; left:-30%; width: 150%;}
      .wearable-watch .battery__info-title[data-copy-set="C06-005"] {position: relative; top:0; left:-30%; width: 150%;}
      .wearable-watch .battery__info-title+h4[data-copy-set="C06-006"] {position: relative; top:0; left:-30%; width: 150%;}
      @media screen and (min-width: 1440px) {
        .wearable-watch .battery__info-title{position: relative; top:0; left:-30%; width: 150%;}
        .wearable-watch .battery__info-title+h4{position: relative; top:0; left:-30%; width: 150%;}
        .wearable-watch .battery__info-title[data-copy-set="C06-005"] {position: relative; top:0; left:-30%; width: 150%;}
        .wearable-watch .battery__info-title+h4[data-copy-set="C06-006"] {position: relative; top:0; left:-30%; width: 150%;}
      }
      @media screen and (max-width: 767px){
