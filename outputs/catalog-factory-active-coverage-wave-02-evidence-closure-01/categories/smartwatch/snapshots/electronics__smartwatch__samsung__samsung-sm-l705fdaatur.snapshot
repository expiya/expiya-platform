	<script>
		(function() {
			async function saveMediaReviewsToCache() {
				try {
					// 0일때 리셋
					const mediatype = "all";
					const paging="0";
					const modelCode="SM\u002DL705FDAATUR";
					const cachesname='bv-review-media-cache-'+modelCode;
					const cachesdataname="/bv_mediaData_"+mediatype+"_"+paging;
					const hasCache = await caches.has(cachesname);
					
					if(hasCache && paging == "0"){
						caches.delete(cachesname);
					}
					
					const imageDataAll = "[{\x22Id\x22:\x22235791689\x22,\x22CID\x22:\x22529bcf03\u002D8192\u002D528b\u002D846e\u002Dc8b5fa350061\x22,\x22SourceClient\x22:\x22samsung\x22,\x22LastModeratedTime\x22:\x222024\u002D08\u002D26T22:15:09.000+00:00\x22,\x22LastModificationTime\x22:\x222024\u002D08\u002D26T22:15:09.000+00:00\x22,\x22ProductId\x22:\x22SM\u002DL705FDAATUR\x22,\x22OriginalProductName\x22:\x22Galaxy Watch Ultra LTE\x22,\x22AuthorId\x22:\x22Tony2toesgalaxysweeps\x22,\x22ContentLocale\x22:\x22en_US\x22,\x22IsFeatured\x22:false,\x22TotalInappropriateFeedbackCount\x22:0,\x22IsSyndicated\x22:true,\x22SyndicationSource\x22:{\x22ClientId\x22:null,\x22LogoImageUrl\x22:\x22https:\/\/photos\u002Dus.bazaarvoice.com\/photo\/2\/cGhvdG86YXR0cmlidXRpb25sb2dvMg\/3f0db944\u002D7f1f\u002D456d\u002Dac37\u002D2291be7453fa\x22,\x22ContentLink\x22:\x22https:\/\/www.samsung.com\/us\/mobile\/wearables\/smartwatches\/galaxy\u002Dwatch\u002Dultra\u002D47mm\u002Dtitanium\u002Dgray\u002Dsm\u002Dl705udaaxaa\/\x22,\x22Name\x22:\x22Samsung US\x22},\x22TotalClientResponseCount\x22:0,\x22TotalCommentCount\x22:0,\x22Rating\x22:5,\x22IsRatingsOnly\x22:false,\x22ModerationStatus\x22:\x22APPROVED\x22,\x22SubmissionTime\x22:\x222024\u002D08\u002D26\x22,\x22ReviewText\x22:\x22[This review was collected as part of a promotion.] Upgraded from my Watch 5 Pro the new Ultra is definitely a big improvement. The Ultra is so much quicker and less laggy. I consider it up to today\x27s standards for a smart watch. The Galaxy AI feature on the Ultra is cool with the sleep score. It also gives you an idea of your energy score by using your previous day activities and sleep score to let you know what how your body is. \\n\\nBattery run time between the Watch 5 Pro and Ultra is about the same (well they both have the battery capacity). \\n\\nSo far we have 2 Watch Ultras for me and the wife. We both love it compared to our W5P.\x22,\x22Title\x22:\x22Ultra is really Ultra!\x22,\x22UserNickname\x22:\x22Tony2toes\x2