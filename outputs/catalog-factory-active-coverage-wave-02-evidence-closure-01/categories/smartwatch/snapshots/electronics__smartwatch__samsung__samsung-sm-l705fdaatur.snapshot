        .wearable-watch .battery__info-title+h4{position: relative; top:0; left:0%; width: 110%;}
        .wearable-watch .battery__info-title[data-copy-set="C06-005"] {position: relative; top:0; left:0%; width: 100%;}
        .wearable-watch .battery__info-title+h4[data-copy-set="C06-006"] {position: relative; top:0; left:0%; width: 125%;}
    
        /* 초록 수영모자 남자 텍스트 겹치는 부분 */
        .wearable-watch .big-moment__content--expand .common__headline{margin: 4.888889vw 9.555556vw 0;}
    
        /* 아래 시계 탭버튼 */
