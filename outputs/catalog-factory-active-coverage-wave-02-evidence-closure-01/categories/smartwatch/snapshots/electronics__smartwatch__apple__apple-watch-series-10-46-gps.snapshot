":true,"copy":true,"image":true,"analyticsAttributes":true}},"b4ddbcfda67564761d5fd57876245a157a9bfb6352b6687788cbe36f20d6c2e4":{"a":{"_model":"markdown-inline-copy","textType":"markdown","metadata":[],"_id":"b4ddbcfda67564761d5fd57876245a157a9bfb6352b6687788cbe36f20d6c2e4","copy":"Kilometrelerce. Saatlerce.","_meta":[]},"r":{}},"40ee32b11ea047977681badd69d2b82b8373e581dcd6628869721c4dcf1ba6d7":{"a":{"_model":"markdown-inline-copy","textType":"markdown","metadata":["9a4689953dd35c5a203472e4f44b36e8cade2b8cba745d1edb2f8547c2516505"],"_id":"40ee32b11ea047977681badd69d2b82b8373e581dcd6628869721c4dcf1ba6d7","copy":"Apple{%nbsp%}Watch Ultra{%nbsp%}3 normal kullanımda 42{%nbsp%}saate kadar ve düşük{%nbsp%}güç ayarları açıkken 72{%nbsp%}saate kadar pil{%nbsp%}ömrü sunuyor.{%sosumi type=\"numbered\" metadata=\"1\"%} Bir{%nbsp%}maraton veya triatlon için gerekenden daha{%nbsp%}fazla.","_meta":[{"contentId":"9a4689953dd35c5a203472e4f44b36e8cade2b8cba745d1edb2f8547c2516505"}]},"r":{"_meta":true}},"9a4689953dd35c5a203472e4f44b36e8cade2b8cba745d1edb2f8547c2516505":{"a":{"_model":"markdown-inline-copy","textType":"markdown","categories":["legal"],"metadata":[],"_id":"9a4689953dd35c5a203472e4f44b36e8cade2b8cba745d1edb2f8547c2516505","copy":"Günler süren pil ömrü, uyku takibi{%nbsp%}de dahil olmak üzere, şu{%nbsp%}işlemler temel alınarak hesaplanmıştır: 42{%nbsp%}saat içerisinde 600{%nbsp%}kez saate bakma, 180{%nbsp%}bildirim alma, 30{%nbsp%}dakika uygulama kullanma, Bluetooth aracılığıyla Apple{%nbsp%}Watch’tan müzik dinleyerek 60{%nbsp%}dakika antrenman yapma ve 6{%nbsp%}saat uyku takibi yapma. Apple{%nbsp%}Watch{%nbsp%}Ultra{%nbsp%}3 kullanımı, 42{%nbsp%}saatlik test süresince 8{%nbsp%}saat hücresel bağlantıyı ve Bluetooth üzerinden 34{%nbsp%}saatlik iPhone bağlantısını{%nbsp%}da kapsamaktadır. Düşük{%nbsp%}Güç{%nbsp%}Modu’nda pil{%nbsp%}ömrü, uyku takibi{%nbsp%}de dahil olmak üzere, şu{%nbsp%}işlemler temel alınarak hesaplanmıştır: 72{%nbsp%}saat içerisinde 900{%nbsp%}kez saate bakma, 270{%nbsp%}bildirim alma, 45{%nbsp%}dakika uygulama kullanma, Bluetooth aracılığıyla Apple{%nbsp%}Watch’tan müzik dinleyerek iki{%nbsp%}kez 60{%nbsp%}dakika antrenman yapma ve 18{%nbsp%}saat uyku takibi yapma. Apple{%nbsp%}Watch{%nbsp%}Ultra{%nbsp%}3 kullanımı, 72{%nbsp%}saatlik test süresince isteğe bağlı hücresel bağlantıyı ve Bluetooth üzerinden 60{%nbsp%}saatlik iPhone bağlantısını{%nbsp%}da kapsamaktadır. Testler Apple tarafından Temmuz ve Ağustos{%nbsp%}2025’te, birer iPhone ile eşleştirilmiş ön{%nbsp%}üretim Apple{%nbsp%}Watch{%nbsp%}Ultra{%nbsp%}3 üniteleriyle gerçekleştirilmiştir; tüm{%nbsp%}aygıtlar ön{%nbsp%}sürüm yazılım kullanılarak test edilmiştir. Pil{%nbsp%}ömrü kullanıma, yapılandırmaya, hücresel ağa, sinyal gücüne ve diğer birçok etkene göre değişir; gerçek sonuçlar farklılık{%nbsp%}gösterir."},"r":{}},"12b8472178a0251809fe306366620b317cdfd1bf9c321fa07b72725cf507449d":{"a":{"_model":"asset-set","alt":{"contentId":"6aa9262f3c78ceff7c5d4699690671dc46032d7923d13053ef7e7cff7a23db30"},"viewportSmall":{"contentId":"bf093ef9821f85dffbd47210253b3cae3e96fb5dff4cea724910baec73b945bb"},"viewportMedium":{"contentId":"9a5ff116ceda2ec7064f436a3c63646d0129c104424dfa93947705ead68a58a8"},"viewportLarge":{"contentId":"191a475b7fe527dcff3d33623e98b68e27d6c5ec7dc0253ccffd0d8cc37b2149"},"loop":false,"controls":false,"_id":"12b8472178a0251809fe306366620b317cdfd1bf9c321fa07b72725cf507449d"},"r":{"alt":true,"viewportSmall":true,"viewportMedium":true,"viewportLarge":true}},"6aa9262f3c78ceff7c5d4699690671dc46032d7923d13053ef7e7cff7a23db30":{"a":{"_model":"plain-text-copy","textType":"plainText","metadata":[],"_id":"6aa9262f3c78ceff7c5d4699690671dc46032d7923d13053ef7e7cff7a23db30","copy":"Apple Watch Ultra 3, titanyum kasa, natürel renk, pil şarj simgesi, Trail Loop, mavi/parlak mavi renk","_meta":[]},"r":{}},"bf093ef9821f85dffbd47210253b3cae3e96fb5dff4cea724910baec73b945bb":{"a":{"_model":"pinnable-image","uri1x":"/assets-www/en_WW/watch/feature_card_boc/small/modal