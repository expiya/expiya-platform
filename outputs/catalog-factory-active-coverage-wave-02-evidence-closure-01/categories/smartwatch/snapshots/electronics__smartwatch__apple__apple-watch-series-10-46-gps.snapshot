 metadata=\"1\"%} Üstelik koşu, doğa yürüyüşü, dalış veya keşif yaparken gerçek zamanlı ölçümler gibi bilgileri okumanızı{%nbsp%}kolaylaştırıyor.","_meta":[{"contentId":"3c0e4b1b425ed12bf70c3187b43116831d1b0cc2e25b3b94ad87535a83faf6e2"}]},"r":{"_meta":true}},"3c0e4b1b425ed12bf70c3187b43116831d1b0cc2e25b3b94ad87535a83faf6e2":{"a":{"_model":"markdown-inline-copy","textType":"markdown","categories":["legal"],"metadata":[],"_id":"3c0e4b1b425ed12bf70c3187b43116831d1b0cc2e25b3b94ad87535a83faf6e2","copy":"Apple{%nbsp%}Watch{%nbsp%}Ultra veya Apple{%nbsp%}Watch{%nbsp%}Ultra{%nbsp%}2’ye kıyasla, eğik bir açıyla belirli bir mesafede tutulduğunda."},"r":{}},"87c8c489383dbae1492a70ac79450fb1500ccc40bb05d60023b441cf77a970f8":{"a":{"_model":"asset-set","alt":{"contentId":"6d216b7be4ac120ca4cf2cbe2af7b9b9c1394f4b2bb0e0ac82e37d8d289cef65"},"viewportSmall":{"contentId":"da4d8f6c68384c4d0535c271f5e0e798b8b08b9a4f2095ce8f57d9b2fa378d25"},"viewportMedium":{"contentId":"bacdc57704327013d7f85628e955c5832eb21d7a3b513e72a9d444edbcdf6807"},"viewportLarge":{"contentId":"3f79783be2fa953f025b67a64a5062bf712a74fc3d2ada6c36aa166f843a78cd"},"loop":false,"controls":false,"_id":"87c8c489383dbae1492a70ac79450fb1500ccc40bb05d60023b441cf77a970f8"},"r":{"alt":true,"viewportSmall":true,"viewportMedium":true,"viewportLarge":true}},"6d216b7be4ac120ca4cf2cbe2af7b9b9c1394f4b2bb0e0ac82e37d8d289cef65":{"a":{"_model":"plain-text-copy","textType":"plainText","metadata":[],"_id":"6d216b7be4ac120ca4cf2cbe2af7b9b9c1394f4b2bb0e0ac82e37d8d289cef65","copy":"Apple Watch Ultra 3 aygıtları, titanyum kasalar, natürel ve siyah renkler, Antrenman uygulaması ekranları: koşu, tüplü dalış, doğa yürüyüşü, kayışlar: Trail Loop, siyah/kömür rengi, Ocean Kordon, neon yeşil renk, Alpine Loop, demir mavisi renk","_meta":[]},"r":{}},"da4d8f6c68384c4d0535c271f5e0e798b8b08b9a4f2095ce8f57d9b2fa378d25":{"a":{"_model":"pinnable-image","uri1x":"/assets-www/tr_TR/watch/feature_card_boc/small/modal_adventure_metrics_46f4ff2ab.jpg","uri2x":"