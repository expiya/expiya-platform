dex:1;display:-webkit-inline-box;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-box-pack:center;-ms-flex-pack:center;-webkit-justify-content:center;justify-content:center;-webkit-align-items:center;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-transform:translateY(-33%) translateX(33%);-moz-transform:translateY(-33%) translateX(33%);-ms-transform:translateY(-33%) translateX(33%);transform:translateY(-33%) translateX(33%);}</style><div class="css-58gv9h"></div><a data-testid="cart-icon" class="bsh-button-action css-14ar6pb" aria-label="0 ürün alışveriş sepetinde" href="https://www.bosch-home.com.tr/tr/checkout/cart"><!--$?--><template id="B:1"></template><svg aria-hidden="true" class="css-1vdqdbe" data-fallback="true" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"></svg><!--/$--></a></div><style data-emotion="css sc61z8">@media (min-width: 0px){.css-sc61z8{display:block;}}@media (min-width: 720px){.css-sc61z8{display:none;}}@media (min-width: 1200px){.css-sc61z8{display:none;}}</style><div class="css-sc61z8"><button class="bsh-button-action css-14ar6pb" data-testid="menu-icon-right" aria-label="Ana başlıkları göster" disabled=""><!--$--><svg aria-hidden="true" class="css-1vdqdbe" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6.54544H21M3 12H21M3 17.4545H21" stroke="currentColor" stroke-miterlimit="10"></path></svg><!--/$--></button></div></div></div></div></div></header><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Ana Sayfa","item":"https://www.bosch-home.com.tr/"},{"@type":"ListItem","position":2,"name":"Ürünler","item":"https://www.bosch-home.com.tr/online-satis"},{"@type":"ListItem","position":3,"name":"Çamaşır & Kurutma Makineleri","item":"https://www.bosch-home.com.tr/tr/category/camasir-ve-kurutma-makineleri"},{"@type":"ListItem","position":4,"name":"Kurutma Makinesi","item":"https://www.bosch-home.com.tr/tr/category/camasir-ve-kurutma-makineleri/kurutma-makineleri"},{"@type":"ListItem","position":5,"name":"Isı Pompalı Kurutma Makinesi","item":"https://www.bosch-home.com.tr/tr/category/camasir-ve-kurutma-makineleri/kurutma-makineleri/isi-pompali-kurutma-makineleri"},{"@type":"ListItem","position":6,"name":"WQB245A0TR","item":"https://www.bosch-home.com.tr/tr/product/camasir-ve-kurutma-makineleri/kurutma-makineleri/isi-pompali-kurutma-makineleri/WQB245A0TR"}]}</script><script type="application/ld+json">{"@context":"https://schema.org/","@type":"Product","name":"Serie 8 Isı Pompalı Kurutma Makinesi 9 kg","image":["https://media3.bsh-group.com/Product_Shots/21357200_WQB245A0TR_STP_def.webp","https://media3.bsh-group.com/Product_Shots/21548005_WQB245A0TR_PGA1_def.webp","https://media3.bsh-group.com/Product_Shots/21548004_WQB245A0TR_PGA2_def.webp","https://media3.bsh-group.com/Product_Shots/21548006_WQB245A0TR_PGA3_def.webp","https://media3.bsh-group.com/Product_Shots/21547859_WQB245A0TR_PGA4_def.webp","https://media3.bsh-group.com/Product_Shots/21043058_Drum_D_STEEL_white_PGA8_def.webp","https://media3.bsh-group.com/Product_Shots/22978621_Sidewall_D_L_fullsize_standard_white_PGA9_def.webp","https://media3.bsh-group.com/Product_Shots/25176652_Filter-Out_D_white_PGA6_def.webp","https://media3.bsh-group.com/Product_Shots/25176574_Filter-In_D_white_PGA5_def.webp","https://media3.bsh-group.com/Line_Drawings/19623722_dryer_ld7c_tr-TR.webp","https://media3.bsh-group.com/Line_Drawings/MCZ_00597236_233850_WT44B200BY_tr-TR.webp"],"description":"Serie 8 Isı Pompalı Kurutma Makinesi","gtin":"4242005364138","mpn":"WQB245A0TR","brand":{"@context":"https://schema.org/","@type":"Brand","name":"Bosch Ev Aletleri"},"@id":"https://www.bosch-home.com.tr/tr/product/camasir-ve-kurutma-makineleri/kurutma-makineleri/isi-pompali-kurutma-makineleri/WQB245A0TR","offers":{"@context":"https://schema.org/","@type":"Offer","url":"https://www.bosch-home.com.tr/tr/product/camasir-ve-kurutma-makineleri/kurutma-makineleri/isi-pompali-kurutma-makineleri/WQB245A0TR","availability":"https://schema.org/InStock","seller":{"@type":"Organization","name":"BSH"},"priceCurrency":"TRY","price":75500},"aggregateRating":{"@type":"AggregateRating","bestRating":5,"ratingValue":3.9,"reviewCount":7},"additionalProperty":[{"@type":"PropertyValue","name":"Kurutma tipi","value":"Elektrik kondansatörü"},{"@type":"PropertyValue","name":"Isı pompası","value":"Mevcut"},{"@type":"PropertyValue","name":"Maksimum kapasite (kg)","value":"9.0","unitText":"kg"},{"@type":"PropertyValue","name":"Renk","value":"Beyaz"},{"@type":"PropertyValue","name":"Tambur yapısı","value":"Evet"},{"@type":"PropertyValue","name":"Kapı yönü","value":"Sağa ters çevrilebilir"},{"@type":"PropertyValue","name":"Kullanma şekli","value":"Döner kontrol, Dokunmatik kontrol, Uygulama ile"},{"@type":"PropertyValue","name":"Ek fonksiyonlar","value":"Pamuklu, Çarşaflar, Gömlekler/Bluzler, Pamuklu Eko, Narinler, Havlular, Hijyen programı, Kırışıklıkları azaltma ve kolay ütüleme için yenileme programı, karışık, Süper kısa 40', Sentetik, yünlüler sepette kurutma, Zaman programı sıcak"},{"@type":"PropertyValue","name":"Ses seviyesi","value":"61","unitText":"dB(A) re 1pW"},{"@type":"PropertyValue","name":"Ses seviyesi sınıfı","value":"B"},{"@type":"PropertyValue","name":"Enerji Verimlilik Sınıfı","value":"C"},{"@type":"PropertyValue","name":"Enerji sınıfı (A+++)","value":"NA"},{"@type":"PropertyValue","name":"Yoğuşma Verimlilik Sınıfı (EU 2017/1369)","value":"B"},{"@type":"PropertyValue","name":"Su çıkış borusu","value":"Mevcut"},{"@type":"PropertyValue","name":"Ürün Ölçüleri  (Yükseklik x Genişlik x Derinlik)","value":"842x598x613","unitText":"mm"},{"@type":"PropertyValue","name":"Ambalajlı Ürün Boyutları","value":"880x620x670","unitText":"mm"},{"@type":"PropertyValue","name":"Kapağı 90 derece açık olduğunda ürün derinliği","value":"1105","unitText":"mm"},{"@type":"PropertyValue","name":"Çıkarılabilir üst kapak","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Havalandırma hortumu","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Maksimum yükseklik ayarı","value":"15","unitText":"mm"},{"@type":"PropertyValue","name":"Net Ağırlık","value":"57.1","unitText":"kg"},{"@type":"PropertyValue","name":"Elektrik Kablosu Uzunluğu","value":"145","unitText":"cm"},{"@type":"PropertyValue","name":"İç aydınlatma","value":"Mevcut"},{"@type":"PropertyValue","name":"Sessiz cihazlar","value":"Mevcut"},{"@type":"PropertyValue","name":"AutoDry","value":"Mevcut"},{"@type":"PropertyValue","name":"Smart Dry","value":"Mevcut"},{"@type":"PropertyValue","name":"Iron Assist","value":"Mevcut"},{"@type":"PropertyValue","name":"15 dakika programı","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Süper 40'","value":"Mevcut"},{"@type":"PropertyValue","name":"Kalan süre erteleme","value":"Mevcut"},{"@type":"PropertyValue","name":"Interval fonksiyonu","value":"Mevcut"},{"@type":"PropertyValue","name":"AutoClean","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Kendi kendini temizleyen kondenser","value":"Mevcut"},{"@type":"PropertyValue","name":"Refresher","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Nem sensörü","value":"Otomatik elektrik nem algılama, Isı pompalı hava yoğunlaştırma"},{"@type":"PropertyValue","name":"İlerleme göstergesi","value":"LED ekran"},{"@type":"PropertyValue","name":"Filtre göstergesi","value":"Mevcut"},{"@type":"PropertyValue","name":"Dolu tank göstergesi","value":"Mevcut"},{"@type":"PropertyValue","name":"Kurutma zaman ayarı","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Ayarlanabilir kurutma derecesi","value":"Mevcut"},{"@type":"PropertyValue","name":"Reload (Yeniden yükleme fonksiyonu)","value":"Mevcut"},{"@type":"PropertyValue","name":"Titreşim önleyici yan duvar tasarımı","value":"Mevcut"},{"@type":"PropertyValue","name":"İstiflenebilirlik","value":"Mevcut"},{"@type":"PropertyValue","name":"Tiftik filtresi","value":"Mevcut"},{"@type":"PropertyValue","name":"Hassas döngü","value":"Hassas"},{"@type":"PropertyValue","name":"Allergy Plus","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Spor giysileri programı","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Havlu programı","value":"Mevcut"},{"@type":"PropertyValue","name":"Yün/Ayakkabı sepeti","value":"Mevcut"},{"@type":"PropertyValue","name":"Gömlek/Bluz programı","value":"Mevcut"},{"@type":"PropertyValue","name":"Kuş tüyü","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Outdoor programı","value":"Mevcut değil"},{"@type":"PropertyValue","name":"Home Connect","value":"Mevcut"},{"@type":"PropertyValue","name":"Home Connect Özellikleri","value":"Uzaktan arıza tespiti, Uzaktan takip ve kontrol"},{"@type":"PropertyValue","name":"Home Connect: Yaşam kalitesini artıran akıllı bağlantıya sahip ev aletleri.","value":"Home Connect özellikli Bosch ev aletlerini akıllı telefon veya tabletinize indireceğiniz Home Connect uygulamasıyla takip edebilir, aynı zamanda tek tıkla uzaktan ayarlayabilirsiniz."},{"@type":"PropertyValue","name":"Program İndirme: Değişen ihtiyaçlarınız için yeni kurutma programları yükleyebilirsiniz.","value":"Özel bir şeyi kurutmanız mı gerekiyor ve doğru kurutma programını mı arıyorsunuz? Endişelenmeyin. Program İndirme ile, ihtiyacınız olduğunda kurutma makinenize özel kurutma programlarını görüntüleyebilir ve indirebilirsiniz. Bosch Home Connect uygulamasında mevcut seçenekleri gözden geçirin ve kurutma ihtiyaçlarınıza en uygun programı indirin."},{"@type":"PropertyValue","name":"Bosch Kendini Temizleyen Kondenser: A+++ enerji verimliliğini korumak için kurutma makinenizi tozlardan ve tüylerden uzak tutar.","value":"Isı pompalı kurutucular, Bosch Kendini Temizleyen Kondenser sayesinde giysilerinizi korur ve yüksek enerji verimliliği sağlar. Kondenser kurutma işlemi sırasında 4 kereye kadar otomatik olarak temizlenir ve yüksek enerji performansını korur. Bosch ısı pompalı kurutucular verimli çalışarak giysileri nazikçe ve mükemmel şekilde kurutur."},{"@type":"PropertyValue","name":"Iron Assist: Hem kırışıklıkları hem ütüye ayırdığınız zamanı azaltan buhar uygulaması.","value":"Bir dokunuşla ütüye ayırdığınız vakti azaltın. Iron Assist, kuruyan çamaşırları düzleştirmek için doğal bir buhar kullanır, böylece bazı giysilerde ütüye dahi gerek kalmaz. Ceketler, gömlekler, hatta takım elbiseler için idealdir."},{"@type":"PropertyValue","name":"AutoDry: Tam istediğiniz derecede otomatik kurutma.","value":"Kurutma makinenize ya da kurutmalı çamaşır makinenize on kiloya kadar çamaşırı yerleştirin ve AutoDry ile tam istediğiniz derecede kurutun. İster ütülemeye yetecek kadar kuru ister katlayıp kaldırmak üzere ekstra kuru… Sensörleriyle ısı ve nemi sürekli ölçerek çamaşırlarınızı yüksek sıcaklıktan ve aşırı kurumadan korur. Böylece her kurutmada mükemmel sonuçlar sunar."},{"@type":"PropertyValue","name":"Anti Vibration Tasarım: Özel titreşim koruması sayesinde olağanüstü dengeli ve son derece sessiz.","value":"Tam da bebeği uykuya yatırmıştınız! Ya kurutma makinenizden gelen yüksek titreşim sesi, onu uyandırırsa? Neyse ki Bosch ile bu konuda içiniz rahat olabilir. Bosch kurutma makinelerinde yer alan Anti Vibration yan duvarlar, daha fazla denge sağlarken titreşimi azaltır. Ayrıca gürültü seviyesini kontrol altında tutan gelişmiş yalıtıma sahiptirler. Artık rahatsız edici kurutma gürültüsü uykularınızı kaçırmasın. Bebeğiniz rahatça uyurken siz de sessizliğin tadını çıkarın."},{"@type":"PropertyValue","name":"Enerji kullanımınız size kalmış.","value":"Hepimiz ev aletlerimizi seçiyoruz, ancak enerji kullanımı söz konusu olduğunda her zaman söz sahibi değiliz. Home Connect'in FlexStart seçeneği, Bosch ev aletlerinizi en verimli şekilde kullanmanızı sağlar. Akıllı şebeke bağlantınız veya fotovoltaik kollektörünüz için EEBUS tabanlı bir enerji yönetim sistemi kullanıyorsanız, mobil cihazınızdaki Home Conenct uygulamasıyla artık ev aletlerinizin çalışacağı zaman dilimini kolayca seçebilirsiniz. Akıllı Enerji Yönetim sisteminiz, ev aletlerinizin çalışması için otomatik olarak mevcut en iyi enerji kaynağını kullanır. Son olarak, yeşil düşüncenize uyum sağlayan ev aletleri."},{"@type":"PropertyValue","name":"Hassas Kurutma Sistemi: Kırışıklık olmadan hassas yıkama.","value":"Hassas Kurutma Sistemi, her yönden ılık hava vererek çamaşırlarınızı özenle kurutur. Bu sistem tamburdaki hafif kavisli kanatlarla desteklenir, böylece çamaşırlarınız zeminde yayılı kalmaz ve kırışmaz. Çamaşırlarınız makinenizden kuru, kırışıklık olmadan ve yumuşacık çıkar."},{"@type":"PropertyValue","name":"Yünlüler için özel sepet: Yünlüler için uygun, çok hassas kurutma. Ayrıca spor ayakkabılar için de kullanılabilir.","value":"Kurutma makinenizde çorap gibi ufak parçaları veya özel bir kazak gibi büyük ama hassas kıyafetlerinizi bu özel sepet sayesinde rahatça kurutabilirsiniz. Ayrıca %75'e varan kurutma süresi tasarrufu ile spor ayakkabılarınızı kurutmak için en ideal çözüm yine bu sepet olacaktır."},{"@type":"PropertyValue","name":"40 dakika içerisinde mükemmel kurutma.","value":"Süper kısa 40′ programı ile sentetik ve hafif pamuklu çamaşırlarınızı yalnızca 40 dakika içerisinde mükemmel bir şekilde kurutabilirsiniz."},{"@type":"PropertyValue","name":"Yarım Yük Opsiyonu: Az miktardaki çamaşırlar için kurutma ayarlarını optimize eder.","value":"Yarım Yük Opsiyonu: Az miktardaki çamaşırlar için kurutma ayarlarını optimize eder."},{"@type":"PropertyValue","name":"Yönü değiştirilebilir kapak menteşesi ile daha fazla esneklik.","value":"Yönü değiştirilebilir kapak menteşesinin esnekliği ile kapak açılma yönünü ihtiyaçlarınıza göre kolayca değiştirebilirsiniz."},{"@type":"PropertyValue","name":"Kullanıcı dostu dokunmatik kontrol paneli.","value":"Kullanıcı dostu dokunmatik kontrol paneli, ihtiyacınız olan programı hızlı ve kolay bir şekilde bulmanızı sağlar. Makineninizin ön kısmında ergonomik olarak konumlandırılmış eğimli, geniş ve şık kontrol paneli, cihazı açtığınızda yanar ve sizi doğru programa yönlendirir. Böylece makineyi kolaylıkla başlatabilir ve diğer işlerinize geçebilirsiniz."},{"@type":"PropertyValue","name":"Smart Dry: Kurutma ve çamaşır makineniz birbirine bağlanarak doğru kurutma programını önerir.","value":"Doğru kurutma programını seçmek kafa karıştırıcı olabilir. Siz karar veremediğinizde, Smart Dry sizin için karar verir. Çamaşır ve kurutma makineniz, aralarındaki Wi-Fi bağlantısı sayesinde, harici bir cihaz veya uygulama kullanmadan birbirine bağlanır; son yıkamanıza göre doğru kurutma programını seçer; böylece size mükemmel kurutma sonuçları sunar."},{"@type":"PropertyValue","name":"Yeni nesil çevre dostu R290 gazı ile iklim dostu kurutma makineleri","value":"Bosch kurutma makinelerimiz, küresel ısınmaya yol açan ve çevresel etkileri yüksek olan gazların yerine R290 gazını kullanarak doğayı koruma yolunda adım atar. R290 gazı, diğer geleneksel gazlara göre çok daha düşük bir Küresel Isınma Potansiyeli (GWP) değerine sahiptir, bu da atmosfere salınan zararlı gaz miktarını en aza indirir ve ekosistemi daha fazla korur."}]}</script><style data-emotion="css 1vu2tp0">.css-1vu2tp0{padding-block-end:3rem;}@media (min-width: 720px){.css-1vu2tp0{padding-block-end:4rem;}}@media (min-width: 1200px){.css-1vu2tp0{padding-block-end:5rem;}}</style><style data-emotion="css 53jhp9">.css-53jhp9{padding-block-end:3rem;}@media (min-width: 0px){.css-53jhp9{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:3rem;-webkit-align-items:normal;-webkit-box-align:normal;-ms-flex-align:normal;align-items:normal;-webkit-box-pack:normal;-ms-flex-pack:normal;-webkit-justify-content:normal;justify-content:normal;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;}}@media (min-width: 720px){.css-53jhp9{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:4rem;-webkit-align-items:normal;-webkit-box-align:normal;-ms-flex-align:norm