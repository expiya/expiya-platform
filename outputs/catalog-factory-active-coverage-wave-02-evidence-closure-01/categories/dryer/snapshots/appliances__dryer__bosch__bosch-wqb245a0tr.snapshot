me\":{\"footnoteDataArray\":[],\"text\":\"Hassas döngü\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Hassas\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"ALLERGY_PLUS\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Allergy Plus\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[{\"featureStoryLinkId\":\"10599746\",\"relatedTo\":\"NAME\"}]},{\"key\":\"SPORTSWARE\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Spor giysileri programı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"HS_TOWELS_PROGRAMME_DRYERS\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Havlu programı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"HS_WOOLSHOEBASKET\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Yün/Ayakkabı sepeti\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"HS_BUSINESS_SHIRTS_PROGRAMME\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Gömlek/Bluz programı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"DOWN_PROGRAMME\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Kuş tüyü\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"OUTDOOR_DRYERS\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Outdoor programı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]}],\"lineImages\":null},{\"name\":\"Home Connect\",\"fallbackNameKey\":null,\"key\":\"CONNECTIVITY\",\"specifications\":[{\"key\":\"HOMECONNECTABLE\",\"name\":{\"footnoteDataArray\":[{\"id\":\"20671533\",\"text\":\"Yarını bugünden yaşamak için akıllı telefon ve tabletinizden Home Connect uygulamasını indirmeniz yeterli. Böylece dilediğiniz yerden herhangi bir ev aletinize bağlanabilirsiniz.\",\"superscriptIndex\":12}],\"text\":\"Home Connect\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[{\"featureStoryLinkId\":\"11713707\",\"relatedTo\":\"NAME\"}]},{\"key\":\"HOMECONNECT_TYPE\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Home Connect Özellikleri\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Uzaktan arıza tespiti, Uzaktan takip ve kontrol\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]}],\"lineImages\":null}],\"spinMaxProperty\":null,\"overviewSpecifications\":[{\"key\":\"HOMECONNECTABLE\",\"name\":{\"footnoteDataArray\":[{\"id\":\"20671533\",\"text\":\"Yarını bugünden yaşamak için akıllı telefon ve tabletinizden Home Connect uygulamasını indirmeniz yeterli. Böylece dilediğiniz yerden herhangi bir ev aletinize bağlanabilirsiniz.\",\"superscriptIndex\":12}],\"text\":\"Home Connect\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[{\"featureStoryLinkId\":\"11713707\",\"relatedTo\":\"NAME\"}]},{\"key\":\"SELFCLEANINGCONDENSER\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Kendi kendini temizleyen kondenser\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[{\"featureStoryLinkId\":\"13488487\",\"relatedTo\":\"NAME\"}]},{\"key\":\"IRONASSIST\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Iron Assist\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[{\"featureStoryLinkId\":\"16098686\",\"relatedTo\":\"NAME\"}]},{\"key\":\"HEAT_PUMP\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Isı pompası\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"COLOR_MARKETING\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Renk\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Beyaz\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]}],\"awards\":[{\"id\":\"24801959_Bosch_logo_Made_in_Europe_1200x1200px_transparentbackground\",\"mediaType\":\"Feature_Icons\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"25296378_20220504_TR_made_in_europe_150x150\",\"mediaType\":\"Feature_Icons\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"}],\"highlights\":[{\"id\":\"11713707\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"MCIM03201880_for_mast_head__1\",\"url\":\"https://media3.bsh-group.com/Images/MCIM03201880_for_mast_head__1.png\"},{\"category\":\"bsh:category.product-image\",\"id\":\"MCMI03339038_WAV28K40_WTX87M40_LINIE_Serie8_SmartDry\",\"url\":\"https://media3.bsh-group.com/Images/MCMI03339038_WAV28K40_WTX87M40_LINIE_Serie8_SmartDry.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Home Connect: Yaşam kalitesini artıran akıllı bağlantıya sahip ev aletleri.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Home Connect özellikli Bosch ev aletlerini akıllı telefon veya tabletinize indireceğiniz Home Connect uygulamasıyla takip edebilir, aynı zamanda tek tıkla uzaktan ayarlayabilirsiniz.\"}},{\"id\":\"27556170\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.food.mood.styling\",\"id\":\"27300113_Programme_Download\",\"url\":\"https://media3.bsh-group.com/Images/27300113_Programme_Download.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Program İndirme: Değişen ihtiyaçlarınız için yeni kurutma programları yükleyebilirsiniz.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Özel bir şeyi kurutmanız mı gerekiyor ve doğru kurutma programını mı arıyorsunuz? Endişelenmeyin. Program İndirme ile, ihtiyacınız olduğunda kurutma makinenize özel kurutma programlarını görüntüleyebilir ve indirebilirsiniz. Bosch Home Connect uygulamasında mevcut seçenekleri gözden geçirin ve kurutma ihtiyaçlarınıza en uygun programı indirin.\"}},{\"id\":\"16496656\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"20757330_REU_PLC_Serie8_Dryers_LAB 2022_32 X-Ray Close-Up of Selfcleaning Condenser\",\"url\":\"https://media3.bsh-group.com/Images/20757330_REU_PLC_Serie8_Dryers_LAB%202022_32%20X-Ray%20Close-Up%20of%20Selfcleaning%20Condenser.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Bosch Kendini Temizleyen Kondenser: A+++ enerji verimliliğini korumak için kurutma makinenizi tozlardan ve tüylerden uzak tutar.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Isı pompalı kurutucular, Bosch Kendini Temizleyen Kondenser sayesinde giysilerinizi korur ve yüksek enerji verimliliği sağlar. Kondenser kurutma işlemi sırasında 4 kereye kadar otomatik olarak temizlenir ve yüksek enerji performansını korur. Bosch ısı pompalı kurutucular verimli çalışarak giysileri nazikçe ve mükemmel şekilde kurutur.\"}},{\"id\":\"17129509\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.feature-highlight-image\",\"id\":\"25177985_REU_PLC_Serie6_Dryers_LAB_2024_iron_assist_01\",\"url\":\"https://media3.bsh-group.com/Images/25177985_REU_PLC_Serie6_Dryers_LAB_2024_iron_assist_01.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Iron Assist: Hem kırışıklıkları hem ütüye ayırdığınız zamanı azaltan buhar uygulaması.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Bir dokunuşla ütüye ayırdığınız vakti azaltın. Iron Assist, kuruyan çamaşırları düzleştirmek için doğal bir buhar kullanır, böylece bazı giysilerde ütüye dahi gerek kalmaz. Ceketler, gömlekler, hatta takım elbiseler için idealdir.\"}},{\"id\":\"10599775\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"MCIM03235602_04_Iron-Assist-lifestyle-image-Serie8-AutoClean-dryer_1600x1100\",\"url\":\"https://media3.bsh-group.com/Images/MCIM03235602_04_Iron-Assist-lifestyle-image-Serie8-AutoClean-dryer_1600x1100.png\"},{\"category\":\"bsh:category.product-image\",\"id\":\"12846240_MCIM02834939_WD_WMS_TC_Baby_Blog_Content_Media_M_06_1600x1300\",\"url\":\"https://media3.bsh-group.com/Images/12846240_MCIM02834939_WD_WMS_TC_Baby_Blog_Content_Media_M_06_1600x1300.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"AutoDry: Tam istediğiniz derecede otomatik kurutma.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Kurutma makinenize ya da kurutmalı çamaşır makinenize on kiloya kadar çamaşırı yerleştirin ve AutoDry ile tam istediğiniz derecede kurutun. İster ütülemeye yetecek kadar kuru ister katlayıp kaldırmak üzere ekstra kuru… Sensörleriyle ısı ve nemi sürekli ölçerek çamaşırlarınızı yüksek sıcaklıktan ve aşırı kurumadan korur. Böylece her kurutmada mükemmel sonuçlar sunar.\"}},{\"id\":\"16098233\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.food.mood.styling\",\"id\":\"MCIM03392242_HS_Bosch_IronAssist_washer_dryer_2017\",\"url\":\"https://media3.bsh-group.com/Images/MCIM03392242_HS_Bosch_IronAssist_washer_dryer_2017.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Anti Vibration Tasarım: Özel titreşim koruması sayesinde olağanüstü dengeli ve son derece sessiz.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Tam da bebeği uykuya yatırmıştınız! Ya kurutma makinenizden gelen yüksek titreşim sesi, onu uyandırırsa? Neyse ki Bosch ile bu konuda içiniz rahat olabilir. Bosch kurutma makinelerinde yer alan Anti Vibration yan duvarlar, daha fazla denge sağlarken titreşimi azaltır. Ayrıca gürültü seviyesini kontrol altında tutan gelişmiş yalıtıma sahiptirler. Artık rahatsız edici kurutma gürültüsü uykularınızı kaçırmasın. Bebeğiniz rahatça uyurken siz de sessizliğin tadını çıkarın.\"}},{\"id\":\"16327830\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.screenshot\",\"id\":\"MCIM02311844_Bosch_Home_Connect_Hotstory_PXX_Smart_Energy_Management_iPhone_En\",\"url\":\"https://media3.bsh-group.com/Images/MCIM02311844_Bosch_Home_Connect_Hotstory_PXX_Smart_Energy_Management_iPhone_En.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Enerji kullanımınız size kalmış.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Hepimiz ev aletlerimizi seçiyoruz, ancak enerji kullanımı söz konusu olduğunda her zaman söz sahibi değiliz. Home Connect'in FlexStart seçeneği, Bosch ev aletlerinizi en verimli şekilde kullanmanızı sağlar. Akıllı şebeke bağlantınız veya fotovoltaik kollektörünüz için EEBUS tabanlı bir enerji yönetim sistemi kullanıyorsanız, mobil cihazınızdaki Home Conenct uygulamasıyla artık ev aletlerinizin çalışacağı zaman dilimini kolayca seçebilirsiniz. Akıllı Enerji Yönetim sisteminiz, ev aletlerinizin çalışması için otomatik olarak mevcut en iyi enerji kaynağını kullanır. Son olarak, yeşil düşüncenize uyum sağlayan ev aletleri.\"}},{\"id\":\"10599754\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"MCIM03200432_05_AutoClean_IronAssist_container_1600x1600_neu\",\"url\":\"https://media3.bsh-group.com/Images/MCIM03200432_05_AutoClean_IronAssist_container_1600x1600_neu.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Hassas Kurutma Sistemi: Kırışıklık olmadan hassas yıkama.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Hassas Kurutma Sistemi, her yönden ılık hava vererek çamaşırlarınızı özenle kurutur. Bu sistem tamburdaki hafif kavisli kanatlarla desteklenir, böylece çamaşırlarınız zeminde yayılı kalmaz ve kırışmaz. Çamaşırlarınız makinenizden kuru, kırışıklık olmadan ve yumuşacık çıkar.\"}},{\"id\":\"15932795\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.background\",\"id\":\"12968209_Detail_Woolbasket_master\",\"url\":\"https://media3.bsh-group.com/Images/12968209_Detail_Woolbasket_master.png\"},{\"category\":\"bsh:category.product-image\",\"id\":\"MCIM01787987_WD_TDS_Content_12_R_1600x900\",\"url\":\"https://media3.bsh-group.com/Images/MCIM01787987_WD_TDS_Content_12_R_1600x900.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Yünlüler için özel sepet: Yünlüler için uygun, çok hassas kurutma. Ayrıca spor ayakkabılar için de kullanılabilir.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Kurutma makinenizde çorap gibi ufak parçaları veya özel bir kazak gibi büyük ama hassas kıyafetlerinizi bu özel sepet sayesinde rahatça kurutabilirsiniz. Ayrıca %75'e varan kurutma süresi tasarrufu ile spor ayakkabılarınızı kurutmak için en ideal çözüm yine bu sepet olacaktır.\"}},{\"id\":\"16098400\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"MCIM01787953_WD_Content_04_R_1600x1164\",\"url\":\"https://media3.bsh-group.com/Images/MCIM01787953_WD_Content_04_R_1600x1164.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"40 dakika içerisinde mükemmel kurutma.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Süper kısa 40′ programı ile sentetik ve hafif pamuklu çamaşırlarınızı yalnızca 40 dakika içerisinde mükemmel bir şekilde kurutabilirsiniz.\"}},{\"id\":\"18230531\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Yarım Yük Opsiyonu: Az miktardaki çamaşırlar için kurutma ayarlarını optimize eder.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Yarım Yük Opsiyonu: Az miktardaki çamaşırlar için kurutma ayarlarını optimize eder.\"}},{\"id\":\"21911710\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Yönü değiştirilebilir kapak menteşesi ile daha fazla esneklik.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Yönü değiştirilebilir kapak menteşesinin esnekliği ile kapak açılma yönünü ihtiyaçlarınıza göre kolayca değiştirebilirsiniz.\"}},{\"id\":\"21911608\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Kullanıcı dostu dokunmatik kontrol paneli.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Kullanıcı dostu dokunmatik kontrol paneli, ihtiyacınız olan programı hızlı ve kolay bir şekilde bulmanızı sağlar. Makineninizin ön kısmında ergonomik olarak konumlandırılmış eğimli, geniş ve şık kontrol paneli, cihazı açtığınızda yanar ve sizi doğru programa yönlendirir. Böylece makineyi kolaylıkla başlatabilir ve diğer işlerinize geçebilirsiniz.\"}},{\"id\":\"13221123\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.feature-highlight-image\",\"id\":\"25177981_REU_PLC_Serie6_Dryers_LAB_2024_smart_dry_02\",\"url\":\"https://media3.bsh-group.com/Images/25177981_REU_PLC_Serie6_Dryers_LAB_2024_smart_dry_02.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Smart Dry: Kurutma ve çamaşır makineniz birbirine bağlanarak doğru kurutma programını önerir.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Doğru kurutma programını seçmek kafa karıştırıcı olabilir. Siz karar veremediğinizde, Smart Dry sizin için karar verir. Çamaşır ve kurutma makineniz, aralarındaki Wi-Fi bağlantısı sayesinde, harici bir cihaz veya uygulama kullanmadan birbirine bağlanır; son yıkamanıza göre doğru kurutma programını seçer; böylece size mükemmel kurutma sonuçları sunar.\"}},{\"id\":\"15911010\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Yeni nesil çevre dostu R290 gazı ile iklim dostu kurutma makineleri\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Bosch kurutma makinelerimiz, küresel ısınmaya yol açan ve çevresel etkileri yüksek olan gazların yerine R290 gazını kullanarak doğayı koruma yolunda adım atar. R290 gazı, diğer geleneksel gazlara göre çok daha düşük bir Küresel Isınma Potansiyeli (GWP) değerine sahiptir, bu da atmosfere salınan zararlı gaz miktarını en aza indirir ve ekosistemi daha fazla korur.\"}}],\"images360\":{\"mediaType\":\"PRODUCT_GALLERY_360\",\"imagesCount\":36,\"baseUrl\":\"https://media3.bsh-group.com/3D_Asset/MC3D360_27850800_WQB245A0TR_360/Lv1/900x506\",\"filenamePrefix\":\"img\",\"fileType\":\"jpg\"},\"images\":[{\"id\":\"21357200_WQB245A0TR_STP_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"21548005_WQB245A0TR_PGA1_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"21548004_WQB245A0TR_PGA2_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"21548006_WQB245A0TR_PGA3_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"21547859_WQB245A0TR_PGA4_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"21043058_Drum_D_STEEL_white_PGA8_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"22978621_Sidewall_D_L_fullsize_standard_white_PGA9_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"25176652_Filter-Out_D_white_PGA6_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},