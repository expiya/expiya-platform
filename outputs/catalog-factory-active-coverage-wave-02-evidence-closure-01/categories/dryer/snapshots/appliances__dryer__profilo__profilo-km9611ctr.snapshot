":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"DOWN_PROGRAMME\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Kuş tüyü\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"OUTDOOR_DRYERS\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Outdoor programı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]}],\"lineImages\":null},{\"name\":\"Home Connect\",\"fallbackNameKey\":null,\"key\":\"CONNECTIVITY\",\"specifications\":[{\"key\":\"HOMECONNECTABLE\",\"name\":{\"footnoteDataArray\":[{\"id\":\"20671533\",\"text\":\"Yarını bugünden yaşamak için akıllı telefon ve tabletinizden Home Connect uygulamasını indirmeniz yeterli. Böylece dilediğiniz yerden herhangi bir ev aletinize bağlanabilirsiniz.\",\"superscriptIndex\":12}],\"text\":\"Home Connect\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]}],\"lineImages\":null}],\"spinMaxProperty\":null,\"overviewSpecifications\":[{\"key\":\"HOMECONNECTABLE\",\"name\":{\"footnoteDataArray\":[{\"id\":\"20671533\",\"text\":\"Yarını bugünden yaşamak için akıllı telefon ve tabletinizden Home Connect uygulamasını indirmeniz yeterli. Böylece dilediğiniz yerden herhangi bir ev aletinize bağlanabilirsiniz.\",\"superscriptIndex\":12}],\"text\":\"Home Connect\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"SELFCLEANINGCONDENSER\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Kendi kendini temizleyen kondenser\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"IRONASSIST\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Iron Assist\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"HEAT_PUMP\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Isı pompası\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"COLOR_MARKETING\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Renk\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Beyaz\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]}],\"awards\":[{\"id\":\"25296378_20220504_TR_made_in_europe_150x150\",\"mediaType\":\"Feature_Icons\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"}],\"highlights\":[{\"id\":\"25768844\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Profilo Kurutma Makinesi tamamen dolmasa bile Yarım Yük programı ile daha az miktarda çamaşırı tasarruflu bir şekilde kurutabilirsiniz.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Yarım Yük programı sayesinde daha az çamaşırı daha az enerji harcayarak kurutabilirsiniz. Pamuklu, sentetik ve havlu kurutma programlarında, Profilo Kurutma Makineniz normalin yarısı kadar doluysa Yarım Yük programı otomatik olarak devreye girer.\"}},{\"id\":\"25768685\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Nem ve Zaman Sensörü ile çamaşırlarınız, her zaman eşit olarak kurutulurken yüksek sıcaklıklara ve yıpranmaya karşı korunur.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Nem ve Zaman Sensörü, çamaşırlarınızı doğru sürede ve ısıda kurutarak çekmelerini önler. Profilo Kurutma Makinelerinde bulunan Nem ve Zaman Sensörleri, kurutma esnasında çamaşırlarınızın sıcaklığını ve nemini sürekli kontrol eder. Böylece kurutma makineniz çamaşırlarınızı, daha az enerji harcayarak ve zarar vermeden kurutur.\"}},{\"id\":\"25768456\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Hassas Kurutma teknolojisi çok sayıda kıyafeti daha az kırışıklıkla yumuşacık kurutur.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Hassas kurutma teknolojisi, hassas tambur hareketleri ve her yönden gelen hafif ve sıcak hava akımı sayesinde giysilerinizi kırıştırmadan nazik ve eşit şekilde kurutmanızı sağlar. SoftFlow pedallarıyla da dikkatli bir şekilde kurutma makinesinin içinde döndürür. Böylece kıyafetleriniz daha az kırışıklıkla yumuşacık kururken yıpranmaz.\"}},{\"id\":\"25768529\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Profilo Kurutma Makineleri, yenilikçi Isı Pompası ile giysilerinizi kurutmak için sıcak hava kullanır ve enerji tasarrufu yapmanızı sağlar.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Profilo Kurutma Makineleri, geleneksel kurutma makinelerinin aksine havayı ısıtıcı rezistans ile değil, ısı pompası ile ısıtır. Bu sayede çamaşırlarınızı kuruturken daha az enerji tüketir. Isı Pompası ile enerji tüketiminizi azaltır, aile bütçenize katkıda bulunursunuz.\"}},{\"id\":\"25768738\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Sessizlik özelliğine sahip Profilo Kurutma Makineleri çamaşırlarınızı sessizce kurutur.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Profilo Kurutma Makinelerinde bulunan Sessizlik özelliği, makinenizin çalışırken çıkardığı sesi, tamburu yavaşlatarak ve tüm bildirim seslerini kapatarak minimuma indirir. Çamaşırlarınız kururken sessizliğe ihtiyaç duyduğunuz anlarda, size gürültüsüz ve konforlu bir ortam sağlar.\"}},{\"id\":\"25768897\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Profilo Kurutma Makinelerinin geniş iç hacminde yorganlarınız, sentetik-dolgulu battaniye ve yatak örtüleriniz rahatça kurur.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Kışlık yorganları ve her mevsim kullanılan yatak örtülerini kurutmak çok kolay. Profilo Kurutma Makinelerinin Yorgan programı ve büyük iç hacmi sayesinde yorganlarınızı, battaniyelerinizi ve yatak örtülerinizi kolayca kurutun. İster saklayın isterseniz hemen kullanın. Alandan ve vakitten tasarruf sağlayın.\"}}],\"images360\":null,\"images\":[{\"id\":\"26158359_KM9611CTR_STP_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"26207799_Cleaning-open-out_T27_white_PGA15_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"26207144_Cleaning-open-in_T27_white_PGA14_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"21043058_Drum_D_STEEL_white_PGA8_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"22978621_Sidewall_D_L_fullsize_standard_white_PGA9_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"26201170_Cleaning-closed_T27_white_PGA13_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"25176652_Filter-Out_D_white_PGA6_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"25176574_Filter-In_D_white_PGA5_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"19602068_dryer_ld4c_tr-TR\",\"mediaType\":\"Line_Drawings\",\"alt\":\"$undefined\