":\"Organization\",\"name\":\"BSH\"},\"priceCurrency\":\"TRY\",\"price\":44200},\"aggregateRating\":{\"@type\":\"AggregateRating\",\"bestRating\":5,\"ratingValue\":5,\"reviewCount\":6},\"additionalProperty\":[{\"@type\":\"PropertyValue\",\"name\":\"Kurutma tipi\",\"value\":\"Elektrik kondansatörü\"},{\"@type\":\"PropertyValue\",\"name\":\"Isı pompası\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Maksimum kapasite (kg)\",\"value\":\"9.0\",\"unitText\":\"kg\"},{\"@type\":\"PropertyValue\",\"name\":\"Renk\",\"value\":\"Beyaz\"},{\"@type\":\"PropertyValue\",\"name\":\"Tambur yapısı\",\"value\":\"Evet\"},{\"@type\":\"PropertyValue\",\"name\":\"Kapı yönü\",\"value\":\"Sağ\"},{\"@type\":\"PropertyValue\",\"name\":\"Kullanma şekli\",\"value\":\"Döner kontrol, Dokunmatik kontrol\"},{\"@type\":\"PropertyValue\",\"name\":\"Ek fonksiyonlar\",\"value\":\"Pamuklu, Gömlekler/Bluzler, Pamuklu Eko, İç çamaşırları, Havlular, Yastıklar, karışık, outdoor, Süper kısa 40', Yorgan, Sentetik, yünlülerde son uygulama, Zaman programı soğuk, Zaman programı sıcak\"},{\"@type\":\"PropertyValue\",\"name\":\"Ses seviyesi\",\"value\":\"62\",\"unitText\":\"dB(A) re 1pW\"},{\"@type\":\"PropertyValue\",\"name\":\"Ses verimllik sınıfı\",\"value\":\"B\"},{\"@type\":\"PropertyValue\",\"name\":\"Enerji Verimlilik Sınıfı\",\"value\":\"D\"},{\"@type\":\"PropertyValue\",\"name\":\"Yoğuşma Verimlilik Sınıfı (EU 2017/1369)\",\"value\":\"C\"},{\"@type\":\"PropertyValue\",\"name\":\"Su çıkış borusu\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Ürün Ölçüleri  (Yükseklik x Genişlik x Derinlik)\",\"value\":\"842x598x613\",\"unitText\":\"mm\"},{\"@type\":\"PropertyValue\",\"name\":\"Ambalajlı Ürün Boyutları\",\"value\":\"890x630x670\",\"unitText\":\"mm\"},{\"@type\":\"PropertyValue\",\"name\":\"Kapağı 90 derece açık olduğunda ürün derinliği\",\"value\":\"1096\",\"unitText\":\"mm\"},{\"@type\":\"PropertyValue\",\"name\":\"Çıkarılabilir üst kapak\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Havalandırma hortumu\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Maksimum yükseklik ayarı\",\"value\":\"15\",\"unitText\":\"mm\"},{\"@type\":\"PropertyValue\",\"name\":\"Net Ağırlık\",\"value\":\"47.8\",\"unitText\":\"kg\"},{\"@type\":\"PropertyValue\",\"name\":\"Elektrik Kablosu Uzunluğu\",\"value\":\"145\",\"unitText\":\"cm\"},{\"@type\":\"PropertyValue\",\"name\":\"İç aydınlatma\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Sessiz cihazlar\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"AutoDry\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Smart Dry\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Iron Assist\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"15 dakika programı\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Süper 40'\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Kalan süre erteleme\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Interval fonksiyonu\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Kendi kendini temizleyen kondenser\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Refresher\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Nem sensörü\",\"value\":\"Otomatik elektrik nem algılama, Isı pompalı hava yoğunlaştırma\"},{\"@type\":\"PropertyValue\",\"name\":\"İlerleme göstergesi\",\"value\":\"LED ekran\"},{\"@type\":\"PropertyValue\",\"name\":\"Filtre göstergesi\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Dolu tank göstergesi\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Kurutma zaman ayarı\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Ayarlanabilir kurutma derecesi\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Reload (Yeniden yükleme fonksiyonu)\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Titreşim önleyici yan duvar tasarımı\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"İstiflenebilirlik\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Tiftik filtresi\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Hassas döngü\",\"value\":\"Hassas\"},{\"@type\":\"PropertyValue\",\"name\":\"Allergy Plus\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Spor giysileri programı\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Havlu programı\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Yün/Ayakkabı sepeti\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Gömlek/Bluz programı\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Kuş tüyü\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Outdoor programı\",\"value\":\"Mevcut\"},{\"@type\":\"PropertyValue\",\"name\":\"Home Connect\",\"value\":\"Mevcut değil\"},{\"@type\":\"PropertyValue\",\"name\":\"Profilo Kurutma Makinesi tamamen dolmasa bile Yarım Yük programı ile daha az miktarda çamaşırı tasarruflu bir şekilde kurutabilirsiniz.\",\"value\":\"Yarım Yük programı sayesinde daha az çamaşırı daha az enerji harcayarak kurutabilirsiniz. Pamuklu, sentetik ve havlu kurutma programlarında, Profilo Kurutma Makineniz normalin yarısı kadar doluysa Yarım Yük programı otomatik olarak devreye girer.\"},{\"@type\":\"PropertyValue\",\"name\":\"Nem ve Zaman Sensörü ile çamaşırlarınız, her zaman eşit olarak kurutulurken yüksek sıcaklıklara ve yıpranmaya karşı korunur.\",\"value\":\"Nem ve Zaman Sensörü, çamaşırlarınızı doğru sürede ve ısıda kurutarak çekmelerini önler. Profilo Kurutma Makinelerinde bulunan Nem ve Zaman Sensörleri, kurutma esnasında çamaşırlarınızın sıcaklığını ve nemini sürekli kontrol eder. Böylece kurutma makineniz çamaşırlarınızı, daha az enerji harcayarak ve zarar vermeden kurutur.\"},{\"@type\":\"PropertyValue\",\"name\":\"Hassas Kurutma teknolojisi çok sayıda kıyafeti daha az kırışıklıkla yumuşacık kurutur.\",\"value\":\"Hassas kurutma teknolojisi, hassas tambur hareketleri ve her yönden gelen hafif ve sıcak hava akımı sayesinde giysilerinizi kırıştırmadan nazik ve eşit şekilde kurutmanızı sağlar. SoftFlow pedallarıyla da dikkatli bir şekilde kurutma makinesinin içinde döndürür. Böylece kıyafetleriniz daha az kırışıklıkla yumuşacık kururken yıpranmaz.\"},{\"@type\":\"PropertyValue\",\"name\":\"Profilo Kurutma Makineleri, yenilikçi Isı Pompası ile giysilerinizi kurutmak için sıcak hava kullanır ve enerji tasarrufu yapmanızı sağlar.\",\"value\":\"Profilo Kurutma Makineleri, geleneksel kurutma makinelerinin aksine havayı ısıtıcı rezistans ile değil, ısı pompası ile ısıtır. Bu sayede çamaşırlarınızı kuruturken daha az enerji tüketir. Isı Pompası ile enerji tüketiminizi azaltır, aile bütçenize katkıda bulunursunuz.\"},{\"@type\":\"PropertyValue\",\"name\":\"Sessizlik özelliğine sahip Profilo Kurutma Makineleri çamaşırlarınızı sessizce kurutur.\",\"value\":\"Profilo Kurutma Makinelerinde bulunan Sessizlik özelliği, makinenizin çalışırken çıkardığı sesi, tamburu yavaşlatarak ve tüm bildirim seslerini kapatarak minimuma indirir. Çamaşırlarınız kururken sessizliğe ihtiyaç duyduğunuz anlarda, size gürültüsüz ve konforlu bir ortam sağlar.\"},{\"@type\":\"PropertyValue\",\"name\":\"Profilo Kurutma Makinelerinin geniş iç hacminde yorganlarınız, sentetik-dolgulu battaniye ve yatak örtüleriniz rahatça kurur.\",\"value\":\"Kışlık yorganları ve her mevsim kullanılan yatak örtülerini kurutmak çok kolay. Profilo Kurutma Makinelerinin Yorgan programı ve büyük iç hacmi sayesinde yorganlarınızı, battaniyelerinizi ve yatak örtülerinizi kolayca kurutun. İster saklayın isterseniz hemen kullanın. Alandan ve vakitten tasarruf sağlayın.\"}]}}]\n"])</script><script>self.__next_f.push([1,"3c:[\"$\",\"$L3e\",null,{\"children\":\"$L3f\"}]\n"])</script><script>self.__next_f.push([1,"40:I[41548,[\"12545\",\"static/chunks/c16f53c3-ffa0e0