<script>
  (function () {
    var burger = document.querySelector('.catnav__burger');
    var drawer = document.querySelector('.catnav__drawer');
    var backdrop = document.querySelector('.catnav__backdrop');
    var closeBtn = document.querySelector('.catnav__drawer-close');
    function openDrawer() {
      drawer.classList.add('catnav__drawer--open');
      backdrop.classList.add('catnav__backdrop--visible');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer.classList.remove('catnav__drawer--open');
      backdrop.classList.remove('catnav__backdrop--visible');
      document.body.style.overflow = '';
    }
    if (burger) burger.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);
    document.querySelectorAll('.catnav__accordion').forEach(function (d) {
      d.addEventListener('toggle', function () {
        var icon = d.querySelector(':scope > summary .catnav__accordion-icon');
        if (icon) icon.textContent = d.open ? '−' : '+';
      });
    });
    if (document.querySelector('[data-category-nav]') && document.querySelector('.site-header')) {
      document.querySelector('.catnav__burger').style.display = 'block';
    }
    document.addEventListener('DOMContentLoaded', function () {
      var items = document.querySelectorAll('#main-menu .menu-list > li');
      var w = (1170 / items.length - 1) + 'px';
      items.forEach(function (li) { li.style.width = w; li.style.opacity = '1'; });
      var wraps = document.querySelectorAll('.parent-menu-wrap');
      if (wraps.length > 0 && typeof $ !== 'undefined' && $.fn.hoverIntent) {
        $('.parent-menu-wrap').hoverIntent({
          over: function () { $(this).addClass('active-hvr'); },
          out: function () { $(this).removeClass('active-hvr'); },
          interval: 120,
          timeout: 100
        });
      }
    });
  })();
</script>
