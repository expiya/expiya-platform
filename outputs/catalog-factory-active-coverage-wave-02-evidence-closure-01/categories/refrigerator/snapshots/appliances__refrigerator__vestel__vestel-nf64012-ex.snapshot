</style><style data-block-css="VWzyVfrOC_cL3jFaWiHhy">.login {
  text-decoration: none;
  color: #000;
  font-weight: bold;
  font-size: 14px;
}
.mobile-user-box .login {
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  width: 24px;
}

.login-user {
  align-items: center;
  gap: 10px;
  cursor: pointer;
}

.login-user .customer-name {
  height: 20px;
  line-height: 20px;
  font-size: 14px;
  width: 90px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-user .account {
  height: 20px;
  line-height: 20px;
  font-size: 14px;
  color: #df2027;
}

.login-user .account .icon {
  margin-top: 8px;
  margin-left: 8px;
  width: 12px;
  height: 6px;
  display: inline-block;
  background-position: -164px -116px;
}

.toggle-container {
  display: flex;
  flex-direction: column;
  align-content: center;
  justify-content: center;
  align-items: center;
}

.toggle-label {
  text-align: center;
  font-size: 10px;
  line-height: 11px;
  margin-bottom: 3px;
  color: #333;
}

header .switch {
  position: relative;
  display: inline-block;
  width: 50px; /* küçültüldü */
  height: 24px; /* küçültüldü */
}

header .switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

header .slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ccc;
  border-radius: 12px; /* yarıçap da küçültüldü */
  transition: 0.4s;
}

/* Slider top */
header .slider::before {
  content: "";
  position: absolute;
  height: 18px; /* küçültüldü */
  width: 18px; /* küçültüldü */
  left: 3px;
  bottom: 3px;
  background-color: white;
  border-radius: 50%;
  transition: 0.4s;
}

/* Açık/Kapalı yazısı top'un yanında */
header .slider::after {
  content: "Kapalı";
  position: absolute;
  left: 22px; /* küçültüldü */
  top: 50%;
  transform: translateY(-50%);
  font-size: 9px; /* biraz daha küçük */
  font-weight: bold;
  color: white;
  transition: 0.4s;
}

/* Açık konum */
header .switch input:checked + .slider {
  background-color: #df2027;
}

header .switch input:checked + .slider::before {
  transform: translateX(26px); /* top’un hareketi küçültüldü */
}

header .switch input:checked + .slider::after {
  content: "Açık";
  left: 4px; /* top’un sol tarafına yaslı */
}

.account-links {
  box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.1);
  position: absolute;
  background-color: #fff;
  width: 310px;
  right: 45px;
  border-top: solid 2px #df2027;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0, 10, 0.175, 1);
  z-index: 99999999999;
}

.account-links .title {
  line-height: 39px;
  box-sizing: border-box;
  padding: 0 8px;
  font-size: 16px;
  letter-spacing: 1px;
  color: #000;
  border-bottom: solid 1px #dedede;
}

.account-links .links {
  padding: 16px;
}

.account-links .links ul li {
  width: 100%;
  font-size: 14px;
  color: #888;
}

.account-links .links ul li a {
  height: 24px;
  line-height: 24px;
}

.account-links .logout-btn {
  width: 100%;
  height: 40px;
  box-sizing: border-box;
  border-top: solid 1px #dedede !important;
  color: #df2027;
  text-align: center;
  letter-spacing: 2px;
  font-size: 14px;
  border: none;
  background: none;
  outline: none;
}

.account-links.is-open-list {
  visibility: visible;
}

.account-links .links ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.account-links .links p {
  margin: 0 !important;
}
