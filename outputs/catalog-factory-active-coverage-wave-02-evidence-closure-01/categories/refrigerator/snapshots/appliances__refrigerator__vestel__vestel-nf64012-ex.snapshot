<style data-section-css="zm5smXjg1POfceeFD7guC">.site-footer {
  margin-top: auto;
}
.site-footer__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem 2rem;
}

.site-footer__blocks {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 2.5rem;
  margin-bottom: 3rem;
}
.site-footer__column {
  min-width: 0;
}
.site-footer__newsletter {
  margin-bottom: 2rem;
  text-align: center;
}
.site-footer__newsletter h4 {
  margin-bottom: 1rem;
}
.site-footer__copyright {
  border-top: 1px solid var(--color-outline, rgba(255, 255, 255, 0.1));
  padding-top: 32px;
  text-align: center;
  opacity: 0.5;
  height: 80px;
  line-height: 80px;
  color: #dedede;
  font-size: 14px;
}
.site-footer__column,
.site-footer__payment {
  font-size: var(--font-size-sm, 0.9rem); /* Example: Adjust font size */
  color: var(--color-text); /* Example: Inherit text color */
  /* Add other shared text styles here */
}

.footer-column ul li a 
{
  font-size:15px;
  font-weight: 500;
  font-family: "League Medium", sans-serif;
  color: #bbb

}

.site-footer__payment-wrapper {
  margin-top: 1rem;
}
.site-footer__payment {
  display: inline-block;
}

@media (max-width: 768px) {
  .site-footer__blocks {
    grid-template-columns: 1fr;
    gap: 0;
    margin-bottom: 2rem;
  }
  .site-footer__column {
    
    padding-bottom: 0.25rem;
  }
  .site-footer__column:last-child {
    border-bottom: 0;
  }
}</style><style data-block-css="tSddH_p_hZKRDoIV6jaZu">.footer-column h3 {
  text-transform: uppercase;
  font-size: var(--font-size-xs, 0.8rem);
  font-weight: 700;
  letter-spacing: 0.08em;
  margin-bottom: 0.75rem;
  margin-top: 1.25rem;
  color: inherit;
  opacity: 0.95;
}
.footer-column h3:first-child {
  margin-top: 0;
}

.footer-column h3 a {
  color: inherit;
  text-decoration: none;
  opacity: 0.95;
}
.footer-column h3 a:hover {
  opacity: 1;
  text-decoration: underline;
}
.footer-column ul {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin: 0 0 1rem 0;
  padding: 0;
  list-style: none;
}
.footer-column ul li p {
  margin: 0;
}

.footer-column ul li a {
  font-size:15px;
  font-font-weight: 500;
  font-font-family: "League Medium",sans-serif;
}

.footer-column a {
  font-size: var(--font-size-sm, 0.9rem);
  opacity: 0.8;
  transition:
    opacity 0.2s,
    color 0.2s;
  color: #fff;
}
.footer-column a:hover {
  opacity: 1;
}

.footer-payment-inner h3 a,
.footer-column h3 a {
 color:#ddd;
 font-size: 18px;
 opacity: 1;
}

.footer-payment-inner h3 a:hover,
.footer-column h3 a:hover{
 color:#fff;
}

.footer-column a:hover {
  opacity: 1;
  color: #df2027;
}

/* Mobil accordion: yalnızca h3 görünür, tıklayınca liste açılır */
.footer-column__toggle {
  display: none;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  font: inherit;
  color: #ddd;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: left;
  cursor: pointer;
  opacity: 1;
}
.footer-column__heading-link {
  display: inline;
}
.footer-column__chevron {
  flex-shrink: 0;
  width: 0.5rem;
  height: 0.5rem;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
  margin-top: -0.15rem;
}
.footer-column__group--collapsible.is-open .footer-column__chevron {
  transform: rotate(-135deg);
  margin-top: 0.15rem;
}

@media (max-width: 768px) {
  .footer-column--api .footer-column__group--collapsible .footer-column__toggle {
    display: flex;
  }
  .footer-column--api .footer-column__group--collapsible .footer-column__heading-link {
    display: none;
  }
  .footer-column--api .footer-column__group--collapsible .footer-column__panel {
    display: none;
    margin-bottom: 0;
  }
  .footer-column--api .footer-column__group--collapsible.is-open .footer-column__panel {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
  }
  .footer-column--api h3 {
    margin-bottom: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.75rem 0;
  }
  .footer-column--api .footer-column__group--collapsible.is-open h3 {
    margin-bottom: 0.75rem;
  }

  .site-footer__blocks {
    gap: 0;
  }

  .footer-column--api h3:focus,
  .footer-column--api h3:focus-visible,
  .footer-column--api h3:active,
  .footer-column--api h3:focus-within,
  .footer-column--api h3 a:focus,
  .footer-column--api h3 a:focus-visible,
  .footer-column--api h3 a:active,
  .footer-column--api h3 a:focus-within ,
  .footer-column--api h3 a button:focus,
  .footer-column--api h3 a button:focus-visible,
  .footer-column--api h3 a button:active,
  .footer-column--api h3 a button:focus-within,
  .footer-column--api h3 button:focus,
  .footer-column--api h3 button:focus-visible,
  .footer-column--api h3 button:active,
  .footer-column--api h3 button:focus-within {
    outline: none;
  }
}

@media (min-width: 769px) {
  .footer-column--api .footer-column__group--collapsible .footer-column__panel {
    display: flex;
    flex-direction: column;
  }
  .footer-column--api .footer-column__group--collapsible .footer-column__panel[hidden] {
    display: flex !important;
  }
