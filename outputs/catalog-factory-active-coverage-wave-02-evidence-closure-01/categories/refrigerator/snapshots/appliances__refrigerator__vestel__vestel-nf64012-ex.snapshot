  color: #555;
  text-decoration: none;
  transition: color 0.15s;
}
.catnav__accordion--nested .catnav__accordion-link {
  padding-left: 2.5rem;
}
.catnav__accordion-link:hover {
  color: var(--catnav-bg, #f7272f);
}

@media (min-width: 1200px) {
