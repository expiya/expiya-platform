<div class="d-flex d-xl-none">
  <div class="search">
   <div style="width: 24px; height: 24px; background-image: url(https://static.vrunibex.com/template/c17f7a94-6525-45a6-bd48-88935e1c2559.svg); background-position: -140px 0;"></div>
  </div>
</div>
<div class="mobile-search-box">
  <form
    id="mobileSearchForm"
    action="https://www.vestel.com.tr/search"
    method="get"
    class="d-flex w-100"
  >
    <input
      type="text"
      name="searchKey"
      id="mobileTxtsearch"
      class="personaclick-instant-search"
      placeholder="Ürün, kategori, servis, mağaza ara"
      autocomplete="off"
    >
    <button type="submit">Ara</button>
