<script>
  (function () {
    var slider = document.getElementById('mobile-header-slider');
    if (!slider) { return; }

    var slides = slider.getElementsByClassName('mobile-header-slide');
    var interval = 5000;
    var index = 0;

    for (var i = 1; i < slides.length; i++) {
      slides[i].style.display = 'none';
    }

    // A single slide has nothing to rotate to.
    if (slides.length < 2) { return; }

    // Guard against a stale timer when the section re-renders in the editor.
    if (slider.__slideTimer) { clearInterval(slider.__slideTimer); }

    slider.__slideTimer = setInterval(function () {
      slides[index].style.display = 'none';
      index = (index + 1) % slides.length;
      slides[index].style.display = 'flex';
    }, interval);
  })();
</script>
