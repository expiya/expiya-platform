<style data-section-css="nMa--8Dby2ux1q1rzuYco">header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 10000;
  background: #fff;
  transition: box-shadow 0.2s ease;
}

main{
  display: inline-block !important;
  width:100%;
    padding-top: 100px;
}

@media (min-width: 1200px) {
    main {
        padding-top: 168px;
    }
}

@media (max-width: 1200px) {
    .site-header__logo img {
        width:110px !important;
        height: 30px !important;
    }
}
.search-box button{
  z-index:999;
}

.site-header {
  height: 78px;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 102;
}

@media (max-width: 1200px) {
  .site-header {
    height: 60px !important;
  }

    .menu-desktop {display: none !important;}
}

@media (min-width: 1200px) {
  .menu-mobile {display: none !important;}

}

.menu a {
  text-decoration: none;
  color: #000;
  margin-right: 20px;
  font-size: 14px;
}

/* SAĞ TARAF */
.header-right {
  display: flex;
  align-items: center;
}

/* SEARCH */
.search input {
  padding: 8px 12px;
  border: 1px solid #ddd;
  border-radius: 4px;
  width: 260px;
}

.site-header__logo {
  flex-shrink: 0;
}
.site-header__logo-text {
  font-size: 1.35rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: inherit;
  text-decoration: none;
}
.site-header__logo img {
  height: auto;
  width: auto;
}

.nav-link {
  background: transparent;
  color: #2e2e2e;
  padding: 0px !important;
  margin-left: 0px !important;
  font-size:14px;
  font-weight: 400;
}

.nav-link:first-child {
  margin-right: 16px;
}

.nav-link:last-child {
  margin-right: 0px !important;
}



.nav-link:hover {
  background: transparent;
  color: #df2027;
}
.nav-link--active {
  background: color-mix(in srgb, var(--color-primary) 14%, transparent);
  color: var(--color-primary);
  font-weight: 600;
}
.nav-link--highlight {
  background: var(--color-primary);
  color: var(--color-bg);
  border-radius: var(--btn-radius, 100px);
  font-weight: 600;
}
.nav-link--highlight:hover {
  background: color-mix(in srgb, var(--color-primary) 85%, black);
}
@media (max-width: 768px) {
  .site-header__inner {
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .site-header__nav {
    justify-content: center;
  }
  .site-header .container{
    padding:0;
  }
}

.header-actions > * {
  margin-left: 20px;
}

/* ---- Cart Drawer ---- */
.cart-drawer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  visibility: hidden;
  transition:
    opacity 0.3s,
    visibility 0.3s;
}
.cart-drawer-overlay.is-open {
  opacity: 1;
  visibility: visible;
}
.cart-drawer {
  position: absolute;
  top: 0;
  bottom: 0;
  width: min(420px, 90vw);
  background: var(--color-bg, #fff);
  color: var(--color-text, #1a1a2e);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);
}
.cart-drawer--right {
  right: 0;
}
.cart-drawer--left {
  left: 0;
  transform: translateX(-100%);
}
.cart-drawer-overlay.is-open .cart-drawer {
  transform: translateX(0);
}
.cart-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--color-outline, rgba(0, 0, 0, 0.08));
}
.cart-drawer__title {
  font-size: 1.15rem;
  font-weight: 700;
  margin: 0;
}
.cart-drawer__close {
  background: none;
  border: none;
  cursor: pointer;
  color: inherit;
  padding: 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-drawer__close:hover {
  background: rgba(0, 0, 0, 0.06);
}
.cart-drawer__items {
  flex: 1;
  overflow-y: auto;
  padding: 1rem 1.5rem;
}
.cart-drawer__item {
  display: flex;
  gap: 0.85rem;
  padding: 0.85rem 0;
  border-bottom: 1px solid var(--color-outline, rgba(0, 0, 0, 0.06));
}
.cart-drawer__item:last-child {
  border-bottom: none;
}
.cart-drawer__item-img {
  flex-shrink: 0;
}
.cart-drawer__item-img img {
  width: 72px;
  height: 72px;
  object-fit: cover;
  border-radius: 8px;
}
.cart-drawer__item-info {
  flex: 1;
  min-width: 0;
}
.cart-drawer__item-title {
  font-weight: 600;
  font-size: 0.92rem;
  color: inherit;
  text-decoration: none;
  display: block;
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cart-drawer__item-variant {
  font-size: 0.8rem;
  opacity: 0.6;
  margin-bottom: 2px;
}
.cart-drawer__item-price {
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 0.35rem;
}
.cart-drawer__qty {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.cart-drawer__qty-btn {
  width: 28px;
  height: 28px;
  border: 1px solid var(--color-outline, rgba(0, 0, 0, 0.15));
  background: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: inherit;
}
.cart-drawer__qty-btn:hover {
  background: rgba(0, 0, 0, 0.04);
}
.cart-drawer__qty-val {
  min-width: 24px;
  text-align: center;
  font-size: 0.9rem;
  font-weight: 600;
}
.cart-drawer__remove-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text, inherit);
  opacity: 0.45;
  padding: 4px;
  margin-left: auto;
  display: flex;
  align-items: center;
  border-radius: 4px;
}
.cart-drawer__remove-btn:hover {
  opacity: 1;
  color: #ef4444;
}
.cart-drawer__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 1rem;
  text-align: center;
  gap: 1rem;
}
.cart-drawer__empty p {
  font-size: 1.05rem;
  opacity: 0.6;
  margin: 0;
}
.cart-drawer__footer {
  border-top: 1px solid var(--color-outline, rgba(0, 0, 0, 0.08));
  padding: 1rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.cart-drawer__subtotal {
  display: flex;
  justify-content: space-between;
  font-weight: 700;
  font-size: 1.05rem;
  padding-bottom: 0.5rem;
}
.cart-drawer__footer .btn {
  display: block;
  text-align: center;
  padding: 0.75rem;
  border-radius: var(--btn-radius, 8px);
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
}
.cart-drawer__footer .btn--primary {
  background: var(--color-primary);
  color: var(--color-bg, #fff);
}
.cart-drawer__footer .btn--primary:hover {
  background: color-mix(in srgb, var(--color-primary) 85%, #000);
}
.cart-drawer__footer .btn--secondary {
  background: transparent;
  color: var(--color-primary);
  border: 1.5px solid var(--color-primary);
}
.cart-drawer__footer .btn--secondary:hover {
  background: color-mix(in srgb, var(--color-primary) 8%, transparent);
}

/* ---- Cart Popup ---- */
.cart-popup {
  display: none;
}
.cart-popup.is-open {
  display: block;
}
.cart-popup__panel {
  position: fixed;
  z-index: 10000;
  width: 360px;
  max-height: 480px;
  background: var(--color-bg, #fff);
  color: var(--color-text, #1a1a2e);
  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.18),
    0 2px 8px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  overflow: visible;
}

.cart-popup__panel::before {
  content: "";
  position: absolute;
  top: -12px; /* panelin üstünden çıkıyor */
  right: 35px;
  width: 0;
  height: 0;
  border-left: 12px solid transparent;
  border-right: 12px solid transparent;
  border-bottom: 12px solid #df2027; /* border rengi */
  z-index: 10001;
}

.cart-popup__panel::after {
  content: "";
  position: absolute;
  top: -8px;
  right: 37px;
  width: 0;
  height: 0;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  border-bottom: 10px solid #fff;
  z-index: 10002;
}
@keyframes cartPopupIn {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.cart-popup__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem;
  border-top: 2px solid #df2027;
}
.cart-popup__title {
  font-size: 0.95rem;
  font-weight: 700;
  margin: 0;
}
.cart-popup__close {
  background: none;
  border: none;
  cursor: pointer;
  color: inherit;
  padding: 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-popup__close:hover {
  background: rgba(0, 0, 0, 0.06);
}
.cart-popup__items {
  flex: 1;
  overflow-y: auto;
  padding: 0.65rem 1rem;
  max-height: 280px;
}
.cart-popup__item {
  display: flex;
  gap: 0.65rem;
  padding: 0.6rem 0;
  border-bottom: 1px solid var(--color-outline, rgba(0, 0, 0, 0.06));
}

.cart-popup__item-img {
  flex-shrink: 0;
  width: 80px;
  height: 80px;
  background-color: #fff;
  border: solid 1px #dedede;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cart-popup__item-img img {
  width: 52px;
  height: 52px;
  object-fit: cover;
}

.cart-popup__item-title {
  font-weight: 600;
  font-size: 0.82rem;
  color: inherit;
  text-decoration: none;
  display: block;
  margin-bottom: 1px;
}
.cart-popup__item-variant {
  font-size: 0.72rem;
  opacity: 0.6;
  margin-bottom: 1px;
}
.cart-popup__item-quantity {
  font-size: 0.82rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
}
.cart-popup__item-price {
  font-size: 0.82rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
}
.cart-popup__item-price .price {
  color: #df2027;
}

.cart-popup__item-price .price--old,
#cart-popup-subtotal .price--old {
  color: #999;
  text-decoration: line-through;
  font-weight: 400;
  margin-right: 6px;
}
.cart-popup__item-price .price--new,
#cart-popup-subtotal .price--new {
  color: #df2027;
}

.cart-popup__qty {
  display: flex;
  align-items: center;
  gap: 0.3rem;
}
.cart-popup__qty-btn {
  width: 24px;
  height: 24px;
  border: 1px solid var(--color-outline, rgba(0, 0, 0, 0.15));
  background: none;
  border-radius: 5px;
  cursor: pointer;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: inherit;
}
.cart-popup__qty-btn:hover {
  background: rgba(0, 0, 0, 0.04);
}
.cart-popup__qty-val {
  min-width: 20px;
  text-align: center;
  font-size: 0.82rem;
  font-weight: 600;
}
.cart-popup__remove-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text, inherit);
  opacity: 0.45;
  padding: 3px;
  margin-left: auto;
  display: flex;
  align-items: center;
  border-radius: 4px;
}
.cart-popup__remove-btn:hover {
  opacity: 1;
  color: #ef4444;
}
.cart-popup__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem 0.75rem;
  text-align: center;
  gap: 0.65rem;
}
.cart-popup__empty p {
  font-size: 0.9rem;
  opacity: 0.6;
  margin: 0;
}
.cart-popup__footer {
  display: flex;
  flex-direction: column;
}
.cart-popup__subtotal {
  display: flex;
  font-weight: 700;
  font-size: 0.92rem;
  gap: 10px;
  padding: 0.75rem 1rem;
}

.cart-popup__subtotal #cart-popup-subtotal {
  color: #df2027;
}

.cart-popup__view-cart {
  background: #df2027;
  color: #fff;
  font-weight: bold;
  text-align: center;
  padding: 10px;
}

.cart-popup__view-cart:hover {
  color: #fff;
}

.cart-popup__footer .btn {
  display: block;
  text-align: center;
  padding: 0.55rem;
  border-radius: var(--btn-radius, 8px);
  font-weight: 600;
  font-size: 0.85rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
}
.cart-popup__footer .btn--primary {
  background: var(--color-primary);
  color: var(--color-bg, #fff);
}
.cart-popup__footer .btn--primary:hover {
  background: color-mix(in srgb, var(--color-primary) 85%, #000);
}
.cart-popup__footer .btn--secondary {
  background: transparent;
  color: var(--color-primary);
  border: 1.5px solid var(--color-primary);
}
.cart-popup__footer .btn--secondary:hover {
  background: color-mix(in srgb, var(--color-primary) 8%, transparent);
}
@media (max-width: 480px) {
  .cart-popup__panel {
    width: calc(100vw - 24px);
    right: 12px !important;
  }
}

@media (max-width: 1200px) {
  nav.menu {
    display: none;
  }
}

.catnav__burger {
  background: #fff;
  color: #df2027;
  border: none;
  cursor: pointer;
  display: none;
  padding-right: 10px;
}

.mobile-user-box {
  justify-content: center;
  align-items: center;
  gap: 25px;
}

.user-menu {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: row-reverse;
  gap: 25px;
}

@media (min-width: 1200px) {
  .user-menu {
    flex-direction: row;
  }
}
