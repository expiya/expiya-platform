<style data-section-css="kDF-0TOLNoFfzXSo_uTNo">.cookie-banner-container.active {
    position: fixed;
    display: block;
    z-index: 999999;
}
.cookie-banner-container{
    position: relative;
    display: none;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
}

.cookie-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.5);
    pointer-events: none;
}

.cookie-overlay.active {
    display: block;
    z-index: 999999;
}

.cookie-popup {
    position: fixed;
    display: none;
    top: 0;
    left: 0;
    width: 400px;
    height: 100vh;
    background: #fff;
    box-shadow: 5px 0 20px rgba(0,0,0,.15);
    padding: 24px;
    overflow-y: auto;
}
.cookie-popup.active {
    display: block;
    z-index: 999999;
}
.cookie-popup-close {
  position: sticky;
  top: 0;
  float: right;
  font-size: 22px;
  cursor: pointer;
  background: #fff;
  z-index: 1;
}
.cookie-popup-title {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 10px;
}
.cookie-popup-text {
  font-size: 12px;
  line-height: 1.6;
  margin-bottom: 18px;
}
.cookie-popup-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top:16px;
}
.cookie-popup-checkbox {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 0;
  cursor: pointer;
}

.cookie-popup-checkbox input[type="checkbox"] {
  appearance: none;
  -webkit-appearance: none;
  width: 16px;
  height: 16px;
  min-width: 16px;
  border: 2px solid #ccc;
  border-radius: 3px;
  cursor: pointer;
  position: relative;
}

.cookie-popup-checkbox input[type="checkbox"].checked {
  background-color: #e21b2d;
  border-color: #e21b2d;
}

.cookie-popup-checkbox input[type="checkbox"].checked::after {
  content: "";
  position: absolute;
  left: 3px;
  top: 0px;
  width: 5px;
  height: 9px;
  border: 2px solid #fff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}
.cookie-popup-save {
  background: #e21b2d;
  color: #fff;
  border: 0;
  padding: 11px 20px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

@media (max-width: 768px) {
    .cookie-popup {
        width: 90%;
        height: 75vh;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
}

/* ---- First-shown consent banner ---- */
.cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    gap: 32px;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    width: 80%;
    max-width: 80%;
    margin: 0 auto;
    background-color: #fbfbfb;
    border: 1px solid #888;
    padding: 35px 35px 10px;
}
.cookie-banner.active {
    display: flex;
    z-index: 999999;
}
.cookie-banner-body {
    flex: 1;
    min-width: 0;
}
.cookie-banner-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: #1a1a1a;
}
.cookie-banner-icon svg {
    display: block;
}
.cookie-banner-title {
    font-family: "League Medium", sans-serif;
    font-size: 1vw;
    text-align: left;
    line-height: 20px;
}
.cookie-banner-text {
    font-family: "League Medium", sans-serif;
    font-size: 1vw;
    text-align: left;
    line-height: 20px;
    color: #333;
}
.cookie-banner-text a {
    color: #e21b2d;
    text-decoration: underline;
}
.cookie-banner-actions {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
}
.cookie-banner-actions button {
    width: 150px;
    border: none;
    background: #ef0006;
    color: #fff;
    height: 45px;
    font-family: "League Medium", sans-serif;
    display: inline-block;
    text-align: center;
    line-height: 45px;
    margin: 7px 0;
    font-size: 16px;
}

@media (min-width: 992px) {
 .cookie-banner-text,
 .cookie-banner-title {
    font-size: 1vw;
 }   
}

@media (max-width: 992px) {
 .cookie-banner-text,
 .cookie-banner-title {
    font-size: 1.6vw;
 }
 .cookie-banner {
    width: 100% !important;
    max-width: 100% !important;
 }
}

@media (max-width: 768px) {
    .cookie-banner {
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
        width: 100%;
        max-width: 100%;
        padding: 25px 25px;
        text-align: justify;
    }
    .cookie-banner-actions {
        flex-direction: row-reverse;
        justify-content: center;
        flex-wrap: nowrap;
        column-gap: 15px;
    }
    .cookie-banner-actions button {
        flex: 1 0 30%;
        margin: 0;
        height: 30px;
        line-height: 30px;
        font-size: 13px;
        width: 30% !important;
        min-width: initial;
    }
    .cookie-banner-title{
        font-size: 2.7vw;
        line-height: 2.7vw;
    }
    .cookie-banner-text{
        font-size: 2.7vw;
        line-height: 2.7vw;
        text-align: justify;
    }
}</style><style data-block-css="QhR8snywOFKYCLuIpRPXF">.cookie-popup-item {
  border-bottom: 1px solid #eee;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .4px;
  cursor: pointer;
  padding: 14px 0;
}

.cookie-popup-item-header {
  position: relative;
  padding-right: 32px;
}

.cookie-popup-item-header::after {
  content: "›";
  font-size: 28px;
  font-weight: 300;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  transition: transform 0.2s ease;
  line-height: 1;
}

.cookie-popup-item.open .cookie-popup-item-header::after {
  transform: translateY(-50%) rotate(90deg);
  color:#dc3c3c;
}

.cookie-popup-item-title {
  display: block;
}

.cookie-popup-switch {
  position: relative;
  display: inline-block;
  width: 40px;
  height: 22px;
  flex-shrink: 0;
  cursor: pointer;
}

.cookie-popup-switch input {
  position: absolute;
  opacity: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  cursor: pointer;
  z-index: 1;
  pointer-events: auto !important;
}

.cookie-popup-switch-slider {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ccc;
  border-radius: 22px;
  transition: background-color 0.3s;
}

.cookie-popup-switch-slider::before {
  content: "";
  position: absolute;
  width: 16px;
  height: 16px;
  left: 3px;
  top: 3px;
  background-color: #fff;
  border-radius: 50%;
  transition: transform 0.3s;
}

.cookie-popup-switch.active .cookie-popup-switch-slider {
  background-color: #dc3c3c;
}

.cookie-popup-switch.active .cookie-popup-switch-slider::before {
  transform: translateX(18px);
}

.cookie-popup-item-description {
  display: none;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.6;
  margin-top: 10px;
  color: #444;
}

.cookie-popup-item.open .cookie-popup-item-description {
  display: flex;
}
