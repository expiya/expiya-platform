  transform: translateX(0);
}
.catnav__drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  background: #3b3b3b;
  color: #fff;
  font-weight: 700;
  font-size: 1rem;
  flex-shrink: 0;
}
.catnav__drawer-close {
  background: none;
  border: none;
  color: inherit;
  font-size: 1.3rem;
  cursor: pointer;
  padding: 0.25rem 0.5rem;
  line-height: 1;
}
.catnav__drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 0;
}

/* === Mobile accordion === */
.catnav__accordion {
  border-bottom: 1px solid #eee;
}
.catnav__accordion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.9rem 1rem;
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  list-style: none;
  user-select: none;
  color: #333;
}
