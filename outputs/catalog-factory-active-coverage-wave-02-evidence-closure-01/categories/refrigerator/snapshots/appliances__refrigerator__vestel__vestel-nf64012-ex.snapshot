  font-weight: 300;
  opacity: 0.5;
  flex-shrink: 0;
}
.catnav__accordion-body {
  display: flex;
  flex-direction: column;
}
.catnav__accordion-seeall {
  display: block;
  padding: 0.55rem 1.75rem;
