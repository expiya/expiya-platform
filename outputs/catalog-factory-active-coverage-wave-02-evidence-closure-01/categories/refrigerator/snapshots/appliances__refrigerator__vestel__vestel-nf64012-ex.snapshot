</style><style data-block-css="L4ybKs_wgVW3LdGEQfwA9">.toggle-container {
  display: flex;
  flex-direction: column;
  align-content: center;
  justify-content: center;
  align-items: center;
}

.toggle-label {
  text-align: center;
  font-size: 10px;
  line-height: 11px;
  margin-bottom: 3px;
  color: #fff;
}

header .switch {
  position: relative;
  display: inline-block;
  width: 50px; /* küçültüldü */
  height: 24px; /* küçültüldü */
}

header .switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

header .slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ccc;
  border-radius: 12px; /* yarıçap da küçültüldü */
  transition: 0.4s;
}

/* Slider top */
header .slider::before {
  content: "";
  position: absolute;
  height: 18px; /* küçültüldü */
  width: 18px; /* küçültüldü */
  left: 3px;
  bottom: 3px;
  background-color: white;
  border-radius: 50%;
  transition: 0.4s;
}

/* Açık/Kapalı yazısı top'un yanında */
header .slider::after {
  content: "Kapalı";
  position: absolute;
  left: 22px; /* küçültüldü */
  top: 50%;
  transform: translateY(-50%);
  font-size: 9px; /* biraz daha küçük */
  font-weight: bold;
  color: white;
  transition: 0.4s;
}

/* Açık konum */
header .switch input:checked + .slider {
  background-color: #df2027;
}

header .switch input:checked + .slider::before {
  transform: translateX(26px); /* top’un hareketi küçültüldü */
}

header .switch input:checked + .slider::after {
  content: "Açık";
  left: 4px; /* top’un sol tarafına yaslı */
}

.mobile-account-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 5px;
}
.mobile-account-content .account-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}
.mobile-account-content .account-info .name {
  color: #ccc;
  
}
.mobile-account-content .account-info .account {
  color: #fff;
  font-size: 14px;
}
