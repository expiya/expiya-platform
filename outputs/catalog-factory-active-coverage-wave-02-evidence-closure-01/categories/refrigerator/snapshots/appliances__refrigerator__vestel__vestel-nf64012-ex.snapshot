<script>
  function changePartnersActive(e) {
    const isChecked = $(e).is(':checked');

    $('.partners-show-operations').prop('checked', isChecked);

    $.ajax({
      type: 'POST',
      url: 'https://www.vestel.com.tr/home/setshowpartnertocookie',
      data: { showPartner: isChecked },
    });
  }
  document.addEventListener('DOMContentLoaded', function () {
    $('body').click(function () {
