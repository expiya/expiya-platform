  flex-shrink: 0;
  cursor: pointer;
}

.cookie-popup-switch input {
  position: absolute;
  opacity: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  cursor: pointer;
  z-index: 1;
  pointer-events: auto !important;
}

.cookie-popup-switch-slider {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ccc;
  border-radius: 22px;
  transition: background-color 0.3s;
}

.cookie-popup-switch-slider::before {
  content: "";
  position: absolute;
  width: 16px;
  height: 16px;
  left: 3px;
  top: 3px;
  background-color: #fff;
  border-radius: 50%;
  transition: transform 0.3s;
}

.cookie-popup-switch.active .cookie-popup-switch-slider {
  background-color: #dc3c3c;
}

.cookie-popup-switch.active .cookie-popup-switch-slider::before {
  transform: translateX(18px);
}

.cookie-popup-item-description {
  display: none;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.6;
  margin-top: 10px;
  color: #444;
}

.cookie-popup-item.open .cookie-popup-item-description {
  display: flex;
}
</style><style data-block-css="hdraZ3K69A49LznDDEg0p">.cookie-popup-item {
