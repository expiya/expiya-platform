<script>(function () {
  var MQ = '(max-width: 768px)';

  function isMobile() {
    return window.matchMedia(MQ).matches;
  }

  function syncGroup(group) {
    var panel = group.querySelector('.footer-column__panel');
    var toggle = group.querySelector('.footer-column__toggle');
    if (!panel || !toggle) return;

    if (isMobile()) {
      var open = group.classList.contains('is-open');
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    } else {
      panel.hidden = false;
      group.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'true');
    }
  }

  function syncAll() {
    document
      .querySelectorAll('.footer-column__group--collapsible')
      .forEach(syncGroup);
  }

  if (!window.__footerColumnApiAccordionBound) {
    window.__footerColumnApiAccordionBound = true;

    document.addEventListener('click', function (event) {
      if (!isMobile()) return;

      var toggle = event.target.closest('.footer-column__toggle');
      if (!toggle) return;

      var group = toggle.closest('.footer-column__group--collapsible');
      if (!group) return;

      event.preventDefault();
      group.classList.toggle('is-open');
      syncGroup(group);
    });

    window.matchMedia(MQ).addEventListener('change', syncAll);
  }

  syncAll();
})();
</script>
          
