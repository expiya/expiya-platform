  <div class="cart-popup" id="cart-popup">
    <div class="cart-popup__panel">
      <div class="cart-popup__header"></div>
      <div class="cart-popup__items" id="cart-popup-items"></div>
      <div class="cart-popup__footer"></div>
    </div>
  </div>
  <script>
    (function () {
      window.getCartSummary = function () {
        return fetch(`https://www.vestel.com.tr/cart/GetCartSummaryJson`, {
          method: 'GET',
          credentials: 'include',
        })
          .then(function (res) {
            if (!res.ok) throw new Error('Cart fetch error');
            return res.json();
          })
          .then(function (data) {
            renderPopup(data);
            return data;
          })
          .catch(function (err) {
            console.error('Cart fetch failed:', err);
          });
      };

      document.addEventListener('DOMContentLoaded', function () {
        window.getCartSummary();
        $('body').click(function () {
          $('#cart-popup').removeClass('is-open');
        });
        $('#cart-popup').click(function (event) {
          event.stopPropagation();
        });
      });
      var popup = document.getElementById('cart-popup');
      if (!popup) return;

      window.cartSummaryOpen = function () {
        var isMobile = window.innerWidth < 1200;
        if (isMobile) return; // sadece desktop

        if (!popup) return;

        popup.classList.add('is-open');

        var btn = document.querySelector('[data-cart-toggle]');
        var panel = popup.querySelector('.cart-popup__panel');
        if (!btn || !panel) return;

        positionPopup(panel, btn);
      };

      function close() {
        popup.classList.remove('is-open');
      }
      function positionPopup(panel, btn) {
        var header = document.querySelector('.site-header');
        var headerBottom = header ? header.getBoundingClientRect().bottom : 0;

        var btnRect = btn.getBoundingClientRect();

        // Normal konum (butona göre)
        var left = btnRect.right - panel.offsetWidth + 30;

        // Sağdan taşma kontrolü
        var maxLeft = window.innerWidth - panel.offsetWidth - 10; // 10px margin

        // Eğer taşıyorsa sağa yasla
        if (left > maxLeft) {
          left = maxLeft;
        }

        // Soldan taşma da olmasın (bonus)
        if (left < 10) {
          left = 10;
        }

        panel.style.top = headerBottom + 'px';
        panel.style.left = left + 'px';
      }

      // Scroll olduğunda popup açık ise pozisyonu güncelle
      window.addEventListener('scroll', function () {
        if (!popup.classList.contains('is-open')) return;

        var btn = document.querySelector('[data-cart-toggle]');
        var panel = popup.querySelector('.cart-popup__panel');
        if (!btn || !panel) return;

        positionPopup(panel, btn);
      });

      document.addEventListener('click', function (e) {
        var toggle = e.target.closest('[data-cart-toggle]');
        if (toggle) {
          e.preventDefault();

          var isMobile = window.innerWidth < 1200;

          var count = document.querySelectorAll('.cart-popup__item').length;

          if (isMobile) {
            window.location.href = '/cart';
            return;
          }

          if (count === 0) {
            return;
          }

          popup.classList.contains('is-open') ? close() : window.cartSummaryOpen();
          return;
        }

        var closeBtn = e.target.closest('[data-cart-close]');
        if (closeBtn) {
          close();
          return;
        }

        if (
          popup.classList.contains('is-open') &&
          !e.target.closest('.cart-popup__panel') &&
          !e.target.closest('[data-cart-toggle]')
        ) {
          close();
          return;
        }
      });

      function money(val) {
        return parseFloat(val).toLocaleString('tr-TR', {
          style: 'currency',
          currency: 'TRY',
        });
      }

      // No discount → single price; discounted → original struck through next
      // to the discounted amount.
      function priceCell(without, discounted) {
        console.log("parameters:",without, discounted);
        console.log(discounted == null || parseFloat(without) === parseFloat(discounted));
        if (discounted == null || parseFloat(without) === parseFloat(discounted)) {
          return '<span class="price">' + money(without) + '</span>';
        }
        return '<span class="price price--old">' + money(without) + '</span>' +
          '<span class="price price--new">' + money(discounted) + '</span>';
      }

      function updateBadges(count) {
        document.querySelectorAll('.basketCount').forEach(function (b) {
          b.textContent = String(count);
        });
      }

      function renderPopup(cart) {
        updateBadges(cart.ItemCount || 0);

        var itemsEl = document.getElementById('cart-popup-items');
        var footerEl = popup.querySelector('.cart-popup__footer');

        var html = '';

        (cart.Items || []).forEach(function (item) {
          html += '<div class="cart-popup__item" data-line-item-id="' + item.Id + '">';

          if (item.Thumbnail) {
            html +=
              '<a href="' +
              item.Url +
              '" class="cart-popup__item-img">' +
              '<img src="' +
              item.Thumbnail +
              '" alt="' +
              item.ProductTitle +
              '">' +
              '</a>';
          }

          html += '<div class="cart-popup__item-info">';

          html += '<a href="' + item.Url + '" class="cart-popup__item-title">' + item.ProductTitle + '</a>';

          html +=
            '<div class="d-flex align-items-center cart-popup__item-quantity">' +
            '<span class="mr-3">Adet:</span>' +
            '<span>' +
            item.Quantity +
            '</span>' +
            '</div>';

          html +=
            '<div class="d-flex align-items-center cart-popup__item-price">' +
            '<span class="mr-3">Fiyat:</span>' +
            priceCell(item.TotalWithoutAnyDiscount, item.DiscountedTotal) +
            '</div>';

          html += '</div></div>';
        });

        itemsEl.innerHTML = html;

        if (!footerEl) {
          footerEl = document.createElement('div');
          footerEl.className = 'cart-popup__footer';
          popup.querySelector('.cart-popup__panel').appendChild(footerEl);
        }

        footerEl.innerHTML =
          '<div class="cart-popup__subtotal">' +
          '<span>Toplam Tutar:</span>' +
          '<span id="cart-popup-subtotal">' +
          priceCell(cart.TotalWithoutAnyDiscount, cart.TotalAmountToBePaid) +
          '</span>' +
          '</div>' +
          '<a href="' +
          cart.CartUrl +
          '" class="cart-popup__view-cart">SEPETE GİT</a>';
      }
    })();
  </script>

</div>
<style data-section-css="SzSQn8Z_ZTHV8D4hiaysx">/* === Container === */
.catnav {
  position: relative;
  background: var(--catnav-bg, #f7272f);
