ranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"PRE_WASH\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Ön yıkama\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Evet\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"PROGR_KOCH_BUNTWAESCHE\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Pamuklular programı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Pamuklular\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"PROGRAMM_PFLEGELEICHT\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Sentetikler programı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Standart soğuk\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"TEMP_CTRL\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Farklı derece seçme imkanı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Evet\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"WASH_OPTIMIZE\",\"name\":{\"footnoteDataArray\":[],\"text\":\"İlave yıkama programları\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Otomatik, Steam, Sıkma-Boşaltma, Mix, Durulama, Süper kısa 15'/30', Temel ayar, Aç/Kapat, Kalan süre erteleme, Leke Çıkarma, çocuk emniyeti, Daha fazla seçenek, İlave Durulama, Tek parça, Başlat/Beklet tuşu, Sıcaklık seçimi, varioSpeed, Ön yıkama, Devir sayısı seçimi\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"WATER_PLUS\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Water Plus\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.no\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]}],\"lineImages\":null},{\"name\":\"Home Connect\",\"fallbackNameKey\":null,\"key\":\"CONNECTIVITY\",\"specifications\":[{\"key\":\"HOMECONNECTABLE\",\"name\":{\"footnoteDataArray\":[{\"id\":\"20671533\",\"text\":\"Yarını bugünden yaşamak için akıllı telefon ve tabletinizden Home Connect uygulamasını indirmeniz yeterli. Böylece dilediğiniz yerden herhangi bir ev aletinize bağlanabilirsiniz.\",\"superscriptIndex\":12}],\"text\":\"Home Connect\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"HOMECONNECT_TYPE\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Home Connect Özellikleri\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Uzaktan arıza tespiti, Uzaktan takip ve kontrol\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]}],\"lineImages\":null},{\"name\":\"Güvenlik\",\"fallbackNameKey\":null,\"key\":\"SAFETY\",\"specifications\":[{\"key\":\"BALANCE_CTRL\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Denge kontrolü\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Evet\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"FOAM_CTRL\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Köpük tarama sistemi\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"WATER_PROTECT\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Su güvenlik sistemi\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Çoklu su koruması\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"CHILD_SAFETY\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Çocuk kilidi\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Evet\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]}],\"lineImages\":null}],\"spinMaxProperty\":{\"key\":\"SPIN_MAX\",\"name\":{\"footnoteDataArray\":[{\"id\":\"20826768\",\"text\":\"Belirtilen değerler en uygun tam sayı değerleri esas olacak şekilde düzenlenmiştir.\",\"superscriptIndex\":22}],\"text\":\"En yüksek sıkma sayısı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"1400\"},\"requiresValueTranslation\":false,\"unit\":\"rpm\",\"featureStoryLinkIds\":[]},\"overviewSpecifications\":[{\"key\":\"ENERGY_CLASS_2017\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Enerji Verimlilik Sınıfı\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"A\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"NOISE_2017\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Ses seviyesi\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"71\"},\"requiresValueTranslation\":false,\"unit\":\"dB(A) re 1pW\",\"featureStoryLinkIds\":[]},{\"key\":\"HOMECONNECTABLE\",\"name\":{\"footnoteDataArray\":[{\"id\":\"20671533\",\"text\":\"Yarını bugünden yaşamak için akıllı telefon ve tabletinizden Home Connect uygulamasını indirmeniz yeterli. Böylece dilediğiniz yerden herhangi bir ev aletinize bağlanabilirsiniz.\",\"superscriptIndex\":12}],\"text\":\"Home Connect\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"CAP_COTTON_2010\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Kapasite\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"10.0\"},\"requiresValueTranslation\":false,\"unit\":\"kg\",\"featureStoryLinkIds\":[]},\"$3b:props:product:spinMaxProperty\",{\"key\":\"AUTOMATICDOSAGESYSTEM\",\"name\":{\"footnoteDataArray\":[],\"text\":\"i-Dos\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[{\"featureStoryLinkId\":\"9369700\",\"relatedTo\":\"NAME\"}]},{\"key\":\"ECOSILENCEDRIVE\",\"name\":{\"footnoteDataArray\":[],\"text\":\"iQdrive - verimli ve ekstra sessiz\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"specifications.translatedBoolean.yes\"},\"requiresValueTranslation\":true,\"unit\":null,\"featureStoryLinkIds\":[]},{\"key\":\"COL_MAIN\",\"name\":{\"footnoteDataArray\":[],\"text\":\"Renk\"},\"value\":{\"footnoteDataArray\":[],\"text\":\"Beyaz\"},\"requiresValueTranslation\":false,\"unit\":null,\"featureStoryLinkIds\":[]}],\"awards\":[{\"id\":\"MCPI03072235_Siemens_MadeinGermany_Logo\",\"mediaType\":\"Feature_Icons\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"27516198_CE_Sign_TR_PDP\",\"mediaType\":\"Feature_Icons\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"}],\"highlights\":[{\"id\":\"11646627\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.detail\",\"id\":\"12442325_Handy_07\",\"url\":\"https://media3.bsh-group.com/Images/12442325_Handy_07.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Home Connect – Çamaşır makinenize istediğiniz her yerden erişin ve kontrol sağlayın.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Teknoloji ilerledikçe hayatınıza yeni kolaylıklar katabilirsiniz. Home Connect uygulaması ile cihazlarınıza bağlanabilir ve nerede olursanız olun onları kontrol edebilirsiniz. Home Connect, birçok akıllı özelliğe sahip, kullanımı kolay bir uygulama sunar. Bazı özellikler omuzlarınızdaki yükü kaldırırken, bazıları da size yeni olanaklar yaratır. Tüm Home Connect özellikleri, günlük yaşamınızı hiç olmadığı kadar verimli ve konforlu hale getirir. Home Connect ile daha rahat bir hayata bağlanın.\"}},{\"id\":\"9369700\",\"videos\":[{\"type\":\"YOUTUBE\",\"mediaType\":\"Video\",\"url\":\"https://www.youtube-nocookie.com/embed/m67UhvXLXbA\",\"image\":{\"id\":\"MCMOV03230529_MCMOV02426856_333_i-Dos-collected_tr_TR_Muzik\",\"mediaType\":\"Movies_Animations\"},\"caption\":\"$undefined\",\"options\":{\"autoplay\":true,\"loop\":false,\"hideControls\":false,\"disableFullscreen\":false,\"startAt\":0}}],\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"MCIM02814974_Siemens-REU-avantgarde-iDos-teaser_16_9\",\"url\":\"https://media3.bsh-group.com/Images/MCIM02814974_Siemens-REU-avantgarde-iDos-teaser_16_9.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"i-Dos – Doğru deterjan ve su miktarını otomatik olarak ayarlar.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"i-Dos; kumaşın cinsine, suyun sertliğine ve kirlilik derecesine göre doğru deterjan miktarını belirler. Deterjan bölmesini sadece bir kez doldurun ve i-Dos her yıkamada en doğru miktarı ayarlayarak size zaman kazandırsın. Üstelik gereksiz durulamayı önleyerek su tasarrufu da sağlayın.\"}},{\"id\":\"13346504\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.detail\",\"id\":\"MCIM03295837_SI_REU_Freestanding_Still_03_0076_JPG_72dpi_CMYK_final\",\"url\":\"https://media3.bsh-group.com/Images/MCIM03295837_SI_REU_Freestanding_Still_03_0076_JPG_72dpi_CMYK_final.png\"},{\"category\":\"bsh:category.detail\",\"id\":\"MCIM02350724_170804_TDV_varioSpeed_sRGB\",\"url\":\"https://media3.bsh-group.com/Images/MCIM02350724_170804_TDV_varioSpeed_sRGB.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"speedPack XL - Programları hızlandırın, süreyi ayarlayın veya sadece 15 dakikada yıkayın.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Zaman kazandıran varioSpeed seçeneğini kullanarak yıkama sürecini hızlandırın veya 59, 30 ve 15 dakikalık hızlı programlardan birini seçin. Yıkama süresini myTime özelliğini kullanarak kendiniz de belirleyebilirsiniz. Artık, çamaşırlar sizin düzeninize ayak uyduracak.\"}},{\"id\":\"22022399\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"20613939_K2638_LC_A79\",\"url\":\"https://media3.bsh-group.com/Images/20613939_K2638_LC_A79.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"i-Dos Deterjan Tarama - Home Connect uygulaması üzerinden deterjanınızın barkodunu taratın.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Akıllı i-Dos Deterjan Tarama özelliği, deterjan ve yumuşatıcı kullanımını hassas bir şekilde ayarlar. Home Connect üzerinden şişelerin barkodlarını taratarak su sertliği ve deterjan yoğunluğunu makineye iletebilirsiniz. i-Dos otomatik dozajlama sistemi, her yıkamada deterjan miktarını sizin için otomatik olarak belirler. Home Connect uygulaması, deterjan seviyesini kontrol eder ve tükenmeden önce size bildirim gönderir. Deterjan tarama özelliğini kullanabilmek için akıllı telefon veya tabletinizde Home Connect uygulamasının yüklü olması ve çamaşır makinenizin Home Connect hesabınıza bağlı olması gerekmektedir.\"}},{\"id\":\"22086575\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Bildirimler - Home Connect uygulaması, makinenizin durumunu ve ihtiyaçlarını size bildirir ve takibi kolaylaştırır.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Home Connect gibi bir yardımcı ile günlük işleriniz artık çok daha verimli ve pratik! Çünkü Home Connect uygulaması, makinenizin haznelerinin doldurulması gerektiğinde veya program bittiğinde sizi bilgilendirir. Böylece makinenizin ihtiyaçlarından haberdar olabilirsiniz. Hayalinizdeki ev düzenini şimdi akıllı telefon veya tabletinizden şekillendirin.\"}},{\"id\":\"9369796\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.detail\",\"id\":\"12442325_Handy_07\",\"url\":\"https://media3.bsh-group.com/Images/12442325_Handy_07.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Uzaktan Kontrol – Makinenizi her zaman ve her yerde uzaktan kontrol edin.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Çamaşırlar sizin hayatınıza ayak uydurmalı, siz onlara değil. Home Connect uygulamasıyla, ayarları rahatça seçebilir ve çamaşır makinenizi istediğiniz zaman, istediğiniz yerden çalıştırabilirsiniz. Çamaşırlarınız tam ihtiyacınız olduğu anda hazır.\"}},{\"id\":\"22086577\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.detail\",\"id\":\"12442328_Handy_09\",\"url\":\"https://media3.bsh-group.com/Images/12442328_Handy_09.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Çamaşır makinen için uzaktan desteğe anında bağlan.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Uzaktan destek sayesinde müşteri hizmetlerine Siemens Home Connect uygulaması üzerinden bağlanır, çamaşır makinenle ilgili olası sorunları hızlıca analiz edersin. Böylece teknik servise ihtiyacın olduğunda servis ekibi sorunun kaynağını önceden belirler ve ziyaret sırasında ihtiyaç duyulan yedek parçalarla hazır gelir.\"}},{\"id\":\"9369797\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.detail\",\"id\":\"12442326_Handy_08\",\"url\":\"https://media3.bsh-group.com/Images/12442326_Handy_08.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Uzaktan İzleme: Makinenizin durumundan sürekli haberdar olun ve bildirim alın.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Siz yokken çamaşırlarınızın ne durumda olduğunu bilmek istemez misiniz? Home Connect uygulaması sayesinde, sadece bir tıkla içiniz rahat. Home Connect uygulaması üzerinden çamaşır makinenizin ayarlarını takip edebilir, program bittiğinde anında bildirim alabilirsiniz. Home Connect ile makinenizin durumundan her zaman ve her yerde haberdar olun!\"}},{\"id\":\"9369709\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.detail\",\"id\":\"MCIM02359923_170927_TDV_iQDrive_sRGB\",\"url\":\"https://media3.bsh-group.com/Images/MCIM02359923_170927_TDV_iQDrive_sRGB.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"10 yıl garantili iQdrive motor: Verimli, sessiz ve dayanıklı.\"},\"text\":{\"footnoteDataArray\":[{\"id\":\"29240281\",\"text\":\"Fırçasız DC (BLDC) motorlar, daha az enerji tüketmeleri ve daha uzun servis ömrüne sahip olmaları nedeniyle üniversal motorlara kıyasla çevresel açıdan daha avantajlıdır. İnvertör tabanlı çalışma prensibi ve gelişmiş kontrol algoritmaları sayesinde daha yüksek verimlilik seviyelerine ulaşır ve daha az enerji tüketirler. Karbon fırça gerektirmemeleri, aşınma tozunu ortadan kaldırır, bakım ihtiyacını azaltır ve daha sessiz çalışmalarına olanak tanır. Kullanım ömürleri boyunca, emisyonların azaltılmasına yardımcı olurken enerji ve kaynak tasarrufuna da katkıda bulunurlar.\",\"superscriptIndex\":453}],\"text\":\"Yüksek teknolojiye sahip çamaşır makineleri aynı zamanda dayanıklı ve uzun ömürlü olmalıdır. Fırçasız iQdrive motoru bu amaçla yarattık. Çamaşır makinesi motorlarındaki karbon fırçalar zamanla aşınabilir ve dönmemeye başlayabilir. iQdrive motor fırçasızdır ve dolayısıyla zamanla yıpranmaz. Ayrıca akıllıdır ve sessiz çalışır. Üstelik 10 yıl garanti ile içinizi rahat tutmanızı sağlar. Size uzun bir süre eşlik edecek akıllı teknolojinin tadını çıkarın.\"}},{\"id\":\"9369717\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.detail\",\"id\":\"MCIM02287812_170728_TDV_waterPerfect_Plus_sRGB\",\"url\":\"https://media3.bsh-group.com/Images/MCIM02287812_170728_TDV_waterPerfect_Plus_sRGB.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"waterPerfect Plus - Sensör kontrollü yıkama programları ile çamaşır miktarına göre en verimli su kullanımı.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"waterPerfect Plus sayesinde, tüm çamaşır kapasitelerinde en verimli su kullanımı için sensör kontrollü yıkama programları.\"}},{\"id\":\"11604601\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.detail\",\"id\":\"MCIM01064327_waveDrum\",\"url\":\"https://media3.bsh-group.com/Images/MCIM01064327_waveDrum.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"waveDrum: Çamaşırlarınızı hassas ve etkili şekilde yıkayın.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"İpek bluzlar gibi en değerli giysilerin temizliği, ekstra hassasiyet gerektirir. Yenilikçi waveDrum teknolojisi, hassas giysilerinize hak ettikleri değeri verir. Eşsiz dalga formu ve asimetrik pedalları giysilerinizin hassas bir şekilde yıkanmasını sağlar. Değerli giysileriniz bir daha asla yıpranmasın.\"}},{\"id\":\"15906268\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"14480991_Siemens_Trakya_10KG_Image\",\"url\":\"https://media3.bsh-group.com/Images/14480991_Siemens_Trakya_10KG_Image.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"10 kg kapasite – Tüm çamaşır ihtiyaçlarınızı karşılayacak şekilde daha fazla kapasite sunar.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Çamaşır makinenizden her zaman daha fazlasını beklersiniz. Siemens, 10 kg kapasitesi ve sayısız akıllı özelliğiyle çamaşır konusundaki bütün beklentilerinizi karşılar. İster çok miktarda, ister büyük boyutlu çamaşır yıkıyor olun, daima mükemmel sonuçlar alırsınız. Çamaşır makinenizden beklentinizi yükseltin.\"}},{\"id\":\"18231227\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"A - En Yüksek Enerji Verimliliği Etiketi - Çalışırken en çok enerji tasarrufu yapan çamaşır makinemiz.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Enerji etiketi A çamaşır makineleri her koşulda verimli ve mükemmel yıkama sonuçları sağlar.\"}},{\"id\":\"9369703\",\"videos\":null,\"images\":null,\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"Çamaşırlarını kolay ve pratik bir şekilde temizle.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"İster hassas ister günlük çamaşırlar olsun, otomatik programlar yıkama sürecini çamaşırlarının ihtiyacına göre kendisi ayarlar. Deterjan miktarından program süresine kadar her detay otomatik olarak optimize edilir. Yoğun kirlerde ise sistem gerekli durumlarda ekstra deterjan ekler.\"}},{\"id\":\"22086571\",\"videos\":null,\"images\":[{\"category\":\"bsh:category.product-image\",\"id\":\"20613959_K2648_LC_A93\",\"url\":\"https://media3.bsh-group.com/Images/20613959_K2648_LC_A93.png\"}],\"assets3d\":null,\"headline\":{\"footnoteDataArray\":[],\"text\":\"directTouch Plus - Program ve opsiyon seçimi için kolay kullanılabilir menü.\"},\"text\":{\"footnoteDataArray\":[],\"text\":\"Şık, zarif ve kullanışlı directTouch Plus, geniş LED ekran sayesinde size sezgisel bir deneyim sunar. Kusursuz net ve siyah kontrol paneli, çamaşır makinesinin kullanımını pratik hale getirmek için tasarlanmıştır. Özel elementler, ergonomik olarak konumlandırılmış dokunmatik ekranda makine çalıştırıldığında yanar. Büyük ekran ve anlaşılır kullanıcı arayüzü sayesinde doğru programı hızlıca seçebilirsiniz. Sezgisel ve kullanıcı dostu kontrol sizinle.\"}}],\"images360\":null,\"images\":[{\"id\":\"21775348_WG54B2A0TR_STP_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"22135852_WG54B2A0TR_PGA1_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"22135862_WG54B2A0TR_PGA3_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"22135853_WG54B2A0TR_PGA4_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"21030804_Drum_W_WA_anthracite_white_PGA8_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"22972652_Sidewall_W-WD_L_fullsize_standard_white_PGA9_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"23017962_Backview_W-WD_FLCN_D25-D25C-D55-D55C-F23-F26-F27-F44-F44C-F55-F55C_MWP_L_white_PGA10_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"23624881_iDOS_A_Siemens_white_PGA6_def\",\"mediaType\":\"Product_Shots\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"20900296_F_PG1_5_SE_D_tr-TR\",\"mediaType\":\"Line_Drawings\",\"alt\":\"$undefined\",\"animated\":\"$undefined\",\"viewportDois\":\"$undefined\"},{\"id\":\"MCZ_00959281_586729_WD15H