ableProductVariants\":[],\"currentProductVariant\":null,\"repairIndex\":null,\"productBuyAreaOptions\":[{\"badge\":null,\"badgeType\":{\"type\":\"None\"},\"tile\":{\"headline\":\"Home Connect\",\"text\":\"\"},\"drawer\":{\"drawerHeadline\":\"Home Connect\",\"drawerFootnote\":\"\",\"teaserViewportImages\":{\"mobile\":{\"id\":\"27129703_HomeConnect_badge\",\"alt\":\"Home Connect Badge\",\"mediaType\":\"Images\",\"viewport\":\"mobile\"},\"tablet\":{\"id\":\"27129703_HomeConnect_badge\",\"alt\":\"Home Connect Badge\",\"mediaType\":\"Images\",\"viewport\":\"tablet\"},\"desktop\":{\"id\":\"27129703_HomeConnect_badge\",\"alt\":\"Home Connect Badge\",\"mediaType\":\"Images\",\"viewport\":\"desktop\"}},\"teaserLink\":{\"href\":\"https://www.siemens-home.bsh-group.com/tr/ilham-alin/yenilikler/homeconnect-teknolojisi?intcid=home_connectli_urunler%7E%7EWebsite%7EImprint%7Ehemen_indirmek_icin_tiklayin\",\"title\":\"Hemen indirmek için tıklayın!\",\"target\":\"_self\"},\"teaserText\":\"Home Connect uygulaması ile akıllı ev aletlerinizi dilediğiniz zaman istediğiniz yerden kontrol edebilir, sorularınızın çözümü için servis hizmetinden yararlanabilirsiniz.\",\"teaserHeadline\":\"Bu ürünü Home Connect uygulaması ile uzaktan kontrol edebilirsiniz\"}},{\"badge\":{\"text\":\"10 Yıl Motor Garantisi\"},\"badgeType\":{\"type\":\"Marketing\"},\"tile\":null,\"drawer\":{\"drawerHeadline\":\"\",\"drawerFootnote\":\"\",\"teaserViewportImages\":{\"mobile\":null,\"tablet\":null,\"desktop\":null},\"teaserLink\":null,\"teaserText\":null,\"teaserHeadline\":null}}],\"buyAreaBenefits\":null,\"marketingTeaser\":null,\"reducedCmsInstallmentRates\":{\"tileHeader\":\"Taksit Seçenekleri\",\"tileDescription\":\"Taksit seçeneklerini görüntüleyin.\",\"drawerHeader\":\"Taksit Seçenekleri\",\"numberOfInstallments\":2},\"serviceVibs\":[],\"salesProgram\":null,\"packagingNote\":null,\"isBVib\":false,\"installmentRates\":null,\"teaserPromotions\":[],\"businessField\":\"G15\",\"productBrand\":\"SIEMENS\",\"isNotIn