e\":\"PropertyValue\",\"name\":\"Ürünün boyutları\",\"value\":\"845x598x590\",\"unitText\":\"mm\"},{\"@type\":\"PropertyValue\",\"name\":\"Ambalajlı Ürün Boyutları\",\"value\":\"875 x 640 x 675\",\"unitText\":\"mm\"},{\"@type\":\"PropertyValue\",\"name\":\"Kapağı 90 derece açık olduğunda ürün derinliği\",\"value\":\"1090\",\"unitText\":\"mm\"},{\"@type\":\"PropertyValue\",\"name\":\"Tambur hacmi\",\"value\":\"70\",\"unitText\":\"litre\"},{\"@type\":\"PropertyValue\",\"name\":\"Maksimum yükseklik ayarı\",\"value\":\"12\",\"unitText\":\"mm\"},{\"@type\":\"PropertyValue\",\"name\":\"Net Ağırlık\",\"value\":\"82.6\",\"unitText\":\"kg\"},{\"@type\":\"PropertyValue\",\"name\":\"Elektrik Kablosu Uzunluğu\",\"value\":\"160\",\"unitText\":\"cm\"},{\"@type\":\"PropertyValue\",\"name\":\"i-Dos\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Reload (Yeniden yükleme fonksiyonu)\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Yük sensörü\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Kirlilik derecesi algılama\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Kalan süre göstergesi\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"İlerleme göstergesi\",\"value\":\"LED ekran\"},{\"@type\":\"PropertyValue\",\"name\":\"Program sonu göstergesi\",\"value\":\"Akustik, LED gösterge\"},{\"@type\":\"PropertyValue\",\"name\":\"Durulama sensörü\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Water Plus\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"waterPerfect\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"waterPerfect Plus\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Başlat-ertele opsiyonları\",\"value\":\"Sürekli\"},{\"@type\":\"PropertyValue\",\"name\":\"Otomatik su seviyelendirme\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"İç aydınlatma\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"varioSoft tambur\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"iQdrive - verimli ve ekstra sessiz\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Sıcak \u0026 Soğuk su girişi\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"varioSpeed\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"super15\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Süper-Kısa 15’/30’\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"varioSpeed\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Devir sayısı seçme seçeneği\",\"value\":\"Değişebilir\"},{\"@type\":\"PropertyValue\",\"name\":\"Allergy Plus\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"Spor giysileri programı\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"Gömlek/Bluz programı\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"Narin/İpek programı\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Yünlüler programı\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Kuş tüyü\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"Outdoor\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"stainRemoval\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Soğuk yıkama seçeneği\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Ön yıkama\",\"value\":\"Evet\"},{\"@type\":\"PropertyValue\",\"name\":\"Pamuklular programı\",\"value\":\"Pamuklular\"},{\"@type\":\"PropertyValue\",\"name\":\"Sentetikler programı\",\"value\":\"Standart soğuk\"},{\"@type\":\"PropertyValue\",\"name\":\"Farklı derece seçme imkanı\",\"value\":\"Evet\"},{\"@type\":\"PropertyValue\",\"name\":\"İlave yıkama programları\",\"value\":\"Otomatik, Steam, Sıkma-Boşaltma, Mix, Durulama, Süper kısa 15'/30', Temel ayar, Aç/Kapat, Kalan süre erteleme, Leke Çıkarma, çocuk emniyeti, Daha fazla seçenek, İlave Durulama, Tek parça, Başlat/Beklet tuşu, Sıcaklık seçimi, varioSpeed, Ön yıkama, Devir sayısı seçimi\"},{\"@type\":\"PropertyValue\",\"name\":\"Water Plus\",\"value\":\"Yok\"},{\"@type\":\"PropertyValue\",\"name\":\"Home Connect\",\"value\":\"Var\"},{\"@type\":\"PropertyValue\",\"name\":\"Home Connect Özellikleri\",\"value\":\"Uzaktan arıza tespiti, Uzaktan takip ve kontrol\"},{\"@type\":\"PropertyValue\",\"name\":\"Home Connect – Çamaşır makinenize istediğiniz her yerden erişin ve kontrol sağlayın.\",\"value\":\"Teknoloji ilerledikçe hayatınıza yeni kolaylıklar katabilirsiniz. Home Connect uygulaması ile cihazlarınıza bağlanabilir ve nerede olursanız olun onları kontrol edebilirsiniz. Home Connect, birçok akıllı özelliğe sahip, kullanımı kolay bir uygulama sunar. Bazı özellikler omuzlarınızdaki yükü kaldırırken, bazıları da size yeni olanaklar yaratır. Tüm Home Connect özellikleri, günlük yaşamınızı hiç olmadığı kadar verimli ve konforlu hale getirir. Home Connect ile daha rahat bir hayata bağlanın.\"},{\"@type\":\"PropertyValue\",\"name\":\"i-Dos – Doğru deterjan ve su miktarını otomatik olarak ayarlar.\",\"value\":\"i-Dos; kumaşın cinsine, suyun sertliğine ve kirlilik derecesine göre doğru deterjan miktarını belirler. Deterjan bölmesini sadece bir kez doldurun ve i-Dos her yıkamada en doğru miktarı ayarlayarak size zaman kazandırsın. Üstelik gereksiz durulamayı önleyerek su tasarrufu da sağlayın.\"},{\"@type\":\"PropertyValue\",\"name\":\"speedPack XL - Programları hızlandırın, süreyi ayarlayın veya sadece 15 dakikada yıkayın.\",\"value\":\"Zaman kazandıran varioSpeed seçeneğini kullanarak yıkama sürecini hızlandırın veya 59, 30 ve 15 dakikalık hızlı programlardan birini seçin. Yıkama süresini myTime özelliğini kullanarak kendiniz de belirleyebilirsiniz. Artık, çamaşırlar sizin düzeninize ayak uyduracak.\"},{\"@type\":\"PropertyValue\",\"name\":\"i-Dos Deterjan Tarama - Home Connect uygulaması üzerinden deterjanınızın barkodunu taratın.\",\"value\":\"Akıllı i-Dos Deterjan Tarama özelliği, deterjan ve yumuşatıcı kullanımını hassas bir şekilde ayarlar. Home Connect üzerinden şişelerin barkodlarını taratarak su sertliği ve deterjan yoğunluğunu makineye iletebilirsiniz. i-Dos otomatik dozajlama sistemi, her yıkamada deterjan miktarını sizin için otomatik olarak belirler. Home Connect uygulaması, deterjan seviyesini kontrol eder ve tükenmeden önce size bildirim gönderir. Deterjan tarama özelliğini kullanabilmek için akıllı telefon veya tabletinizde Home Connect uygulamasının yüklü olması ve çamaşır makinenizin Home Connect hesabınıza bağlı olması gerekmektedir.\"},{\"@type\":\"PropertyValue\",\"name\":\"Bildirimler - Home Connect uygulaması, makinenizin durumunu ve ihtiyaçlarını size bildirir ve takibi kolaylaştırır.\",\"value\":\"Home Connect gibi bir yardımcı ile günlük işleriniz artık çok daha verimli ve pratik! Çünkü Home Connect uygulaması, makinenizin haznelerinin doldurulması gerektiğinde veya program bittiğinde sizi bilgilendirir. Böylece makinenizin ihtiyaçlarından haberdar olabilirsiniz. Hayalinizdeki ev düzenini şimdi akıllı telefon veya tabletinizden şekillendirin.\"},{\"@type\":\"PropertyValue\",\"name\":\"Uzaktan Kontrol – Makinenizi her zaman ve her yerde uzaktan kontrol edin.\",\"value\":\"Çamaşırlar sizin hayatınıza ayak uydurmalı, siz onlara değil. Home Connect uygulamasıyla, ayarları rahatça seçebilir ve çamaşır makinenizi istediğiniz zaman, istediğiniz yerden çalıştırabilirsiniz. Çamaşırlarınız tam ihtiyacınız olduğu anda hazır.\"},{\"@type\":\"PropertyValue\",\"name\":\"Çamaşır makinen için uzaktan desteğe anında bağlan.\",\"value\":\"Uzaktan destek sayesinde müşteri hizmetlerine Siemens Home Connect uygulaması üzerinden bağlanır, çamaşır makinenle ilgili olası sorunları hızlıca analiz edersin. Böylece teknik servise ihtiyacın olduğunda servis ekibi sorunun kaynağını önceden belirler ve ziyaret sırasında ihtiyaç duyulan yedek parçalarla hazır gelir.\"},{\"@type\":\"PropertyValue\",\"name\":\"Uzaktan İzleme: Makinenizin durumundan sürekli haberdar olun ve bildirim alın.\",\"value\":\"Siz yokken çamaşırlarınızın ne durumda olduğunu bilmek istemez misiniz? Home Connect uygulaması sayesinde, sadece bir tıkla içiniz rahat. Home Connect uygulaması üzerinden çamaşır makinenizin ayarlarını takip edebilir, program bittiğinde anında bildirim alabilirsiniz. Home Connect ile makinenizin durumundan her zaman ve her yerde haberdar olun!\"},{\"@type\":\"PropertyValue\",\"name\":\"10 yıl garantili iQdrive motor: Verimli, sessiz ve dayanıklı.\",\"value\":\"Yüksek teknolojiye sahip çamaşır makineleri aynı zamanda dayanıklı ve uzun ömürlü olmalıdır. Fırçasız iQdrive motoru bu amaçla yarattık. Çamaşır makinesi motorlarındaki karbon fırçalar zamanla aşınabilir ve dönmemeye başlayabilir. iQdrive motor fırçasızdır ve dolayısıyla zamanla yıpranmaz. Ayrıca akıllıdır ve sessiz çalışır. Üstelik 10 yıl garanti ile içinizi rahat tutmanızı sağlar. Size uzun bir süre eşlik edecek akıllı teknolojinin tadını çıkarın.\"},{\"@type\":\"PropertyValue\",\"name\":\"waterPerfect Plus - Sensör kontrollü yıkama programları ile çamaşır miktarına göre en verimli su kullanımı.\",\"value\":\"waterPerfect Plus sayesinde, tüm çamaşır kapasitelerinde en verimli su kullanımı için sensör kontrollü yıkama programları.\"},{\"@type\":\"PropertyValue\",\"name\":\"waveDrum: Çamaşırlarınızı hassas ve etkili şekilde yıkayın.\",\"value\":\"İpek bluzlar gibi en değerli giysilerin temizliği, ekstra hassasiyet gerektirir. Yenilikçi waveDrum teknolojisi, hassas giysilerinize hak ettikleri değeri verir. Eşsiz dalga formu ve asimetrik pedalları giysilerinizin hassas bir şekilde yıkanmasını sağlar. Değerli giysileriniz bir daha asla yıpranmasın.\"},{\"@type\":\"PropertyValue\",\"name\":\"10 kg kapasite – Tüm çamaşır ihtiyaçlarınızı karşılayacak şekilde daha fazla kapasite sunar.\",\"value\":\"Çamaşır makinenizden her zaman daha fazlasını beklersiniz. Siemens, 10 kg kapasitesi ve sayısız akıllı özelliğiyle çamaşır konusundaki bütün beklentilerinizi karşılar. İster çok miktarda, ister büyük boyutlu çamaşır yıkıyor olun, daima mükemmel sonuçlar alırsınız. Çamaşır makinenizden beklentinizi yükseltin.\"},{\"@type\":\"PropertyValue\",\"name\":\"A - En Yüksek Enerji Verimliliği Etiketi - Çalışırken en çok enerji tasarrufu yapan çamaşır makinemiz.\",\"value\":\"Enerji etiketi A çamaşır makineleri her koşulda verimli ve mükemmel yıkama sonuçları sağlar.\"},{\"@type\":\"PropertyValue\",\"name\":\"Çamaşırlarını kolay ve pratik bir şekilde temizle.\",\"value\":\"İster hassas ister günlük çamaşırlar olsun, otomatik programlar yıkama sürecini çamaşırlarının ihtiyacına göre kendisi ayarlar. Deterjan miktarından program süresine kadar her detay otomatik olarak optimize edilir. Yoğun kirlerde ise sistem gerekli durumlarda ekstra deterjan ekler.\"},{\"@type\":\"PropertyValue\",\"name\":\"directTouch Plus - Program ve opsiyon seçimi için kolay kullanılabilir menü.\",\"value\":\"Şık, zarif ve kullanışlı directTouch Plus, geniş LED ekran sayesinde size sezgisel bir deneyim sunar. Kusursuz net ve siyah kontrol paneli, çamaşır makinesinin kullanımını pratik hale getirmek için tasarlanmıştır. Özel elementler, ergonomik olarak konumlandırılmış dokunmatik ekranda makine çalıştırıldığında yanar. Büyük ekran ve anlaşılır kullanıcı arayüzü sayesinde doğru programı hızlıca seçebilirsiniz. Sezgisel ve kullanıcı dostu kontrol sizinle.\"}]}}]\n"])</script><script>self.__next_f.push([1,"3c:[\"$\",\"$L3e\",null,{\"children\":\"$L3f\"}]\n"])</script><script>self.__next_f.push([1,"40:I[41548,[\"12545\",\"static/chunks/c16f53c3-ffa0e0f20d988207.js\",\"76979\",\"static/chunks/swiper-8da60fd0e5c4f0f1.js\",\"86201\",\"static/chunks/86201-4dc3c96bbba7a638.js\",\"72659\",\"static/chunks/72659-0201678301047820.js\",\"96301\",\"static/chunks/96301-b71e4cd6b86c20d4.js\",\"52619\",\"static/chunks/52619-3b2b5779c4c83e85.js\",\"53531\",\"static/chunks/53531-2133d4593f2511f4.js\",\"17070\",\"static/chunks/17070-b5454ee610ce571f.js\",\"63711\",\"static/chunks/63711-887792cf106f4010.js\",\"92019\",\"static/chunks/92019-02792adfea36b8d8.js\",\"37425\",\"static/chunks/37425-b8965506d670871b.js\",\"6386