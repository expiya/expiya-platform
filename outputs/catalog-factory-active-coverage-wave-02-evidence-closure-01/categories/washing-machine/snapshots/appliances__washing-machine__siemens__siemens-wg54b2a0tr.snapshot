herLocalesFilterLabel\":\"Diğer bölgeler\",\"otherLocalesFilterLabelTrue\":\"Evet\",\"otherLocalesFilterLabelFalse\":\"Hayır\",\"removeAllFilterButtonLabel\":\"Tüm Filtreleri Kaldır\",\"allFilterArea\":{\"allFilterButtonLable\":\"Tüm Filtreler\",\"primaryHeadline\":\"Filtreler\"}},\"sortButton\":{\"heading\":\"Sırala\",\"BEST\":\"En ilişkili yorumlar\",\"HELPFUL\":\"En yardımcı yorumlar\",\"RATING\":\"En yüksekten en düşüğe puan\",\"NEWEST\":\"En yeni yorumlar\"},\"altText\":\"Yorumun {{index}} görseli\",\"title\":\"Yorumlar ve Sorular\",\"titleNoQuestions\":\"Yorumlar\",\"ratings\":{\"title\":\"Değerlendirmeler ({{reviewsCount}})\",\"ariaLabel\":\"Yorum butonunu genişlet\",\"rateNow\":{\"title\":\"Düşünceleriniz bizim için önemli.\",\"description\":\"Yorumunuz, diğer tüketicilerimizin de doğru ürünü seçmelerine yardımcı olacaktır\",\"btnText\":\"Yorum yazın\"}},\"questions\":{\"anonymous\":\"Anonymous\",\"title\":\"Sorular \u0026 Cevaplar ({{questionsCount}})\",\"overviewTitle\":\"Ürüne göre sorular\",\"inputPlaceholder\":\"Soruları ve Cevapları Ara\",\"questionsCount\":\"Sorular\",\"responseRate\":\"Cevap oranı\",\"askAQuestionButton\":\"Soru sor\",\"summaryLink\":\"Cevaplar: {{answerCount}}\",\"input\":{\"label\":\"Soruları ve Cevapları Ara\"},\"form\":{\"title\":\"Sorunuzu sorabilirsiniz!\",\"nickname\":{\"label\":\"Takma Ad\",\"placeholder\":\"örn.: Ali Veli\"},\"email\":{\"label\":\"E-posta adresi\",\"placeholder\":\"ornek@mail.com\"},\"question\":{\"label\":\"Soru\",\"placeholder\":\"Size nasıl yardımcı olabiliriz?\"},\"gdpr\":{\"text\":\"Yorumların gönderilmesiyle ilgili olarak kişisel verilerin işlenmesine ilişkin bilgilere \u003cGdprLegalNoticeLink\u003eburadan\u003c/GdprLegalNoticeLink\u003e ulaşabilirsiniz.\",\"link\":\"https://www.siemens-home.bsh-group.com/tr/musteri-hizmetleri/iletisim/gizlilik-ve-yasal-metinler/kvkk-politikamiz\"},\"checkbox\":{\"text\":\"\u003cQaTermsLink\u003eHüküm ve koşulları\u003c/QaTermsLink\u003e okudum ve anladım.\",\"link\":\"https://www.siemens-home.bsh-group.com/tr/degerlendirmeler-ve-yorumlar/yorum-degerlendirme-yayinlama-kriterleri\"},\"button\":{\"open_modal\":\"Soru sorun\",\"submit\":\"Soru ekleyin\"},\"error\":{\"required\":\"Bu alana veri girilmesi zorunludur.\",\"profanity\":\"Metin uygun olmayan bir dil içeriyor. Lütfen yazdığınızı gözden geçirin.\",\"nickname\":{\"length\":\"Takma ad 4-25 karakter uzunluğunda olmalıdır.\",\"invalid\":\"Takma ad emoji içermemelidir.\"},\"email\":{\"invalid\":\"E-posta adresinizi kontrol edin ve düzenleyin.\"},\"question\":{\"length\":\"Sorunuz 255 karakterden uzun olmamalıdır.\"},\"terms\":{\"invalid\":\"Hüküm ve Koşullar kabul edilmelidir.\"}},\"toast\":{\"success\":\"Sorunuz gönderilmiştir. İncelendikten sonra yayınlanması birkaç gün sürebilir.\",\"failure\":\"Üzgünüz, bir sorun oluştu. Lütfen daha sonra tekrar deneyin.\",\"profanity\":\"Metin uygun olmayan bir dil içeriyor. Lütfen yazdığınızı gözden geçirin.\"}},\"sortButton\":{\"NEWEST\":\"En yeni sorular\",\"TOTAL_ANSWER_COUNT\":\"En yararlı cevap\"},\"noContent\":{\"heading\":\"İlk soruyu soran siz olun!\",\"message\":\"Uzman ekibimizden hızlı yanıtlar alın ve güvenle satın alma işleminizi gerçekleştirin.\"},\"setModal\":{\"title\":\"Sorunun ayrıntıları\"}},\"reviews\":{\"ariaLabel\":\"Yorumu genişlet\",\"title\":\"Sorular \u0026 Cevaplar ({{reviewsCount}})\",\"stars\":\"{{stars}} Yıldız\",\"ratingsCount\":\"{{reviewsCount}} Değerlendirme\",\"author\":\"{{author}} - {{postedMonth}} ay önce -doğrulanmış tüketici\",\"translate\":\"Yorumu Çevir\",\"backToOriginal\":\"Orijinaline dön\",\"automaticallyTranslated\":\"Bu yorum otomatik olarak çevrildi\",\"recommendation\":\"Bu ürünü önerir\",\"publishedOrigin\":\"İlk olarak {{ origin }} tarihinde yayınlandı\",\"helpful\":\"Yardımcı oldu mu?\",\"upVotes\":\"Evet ({{upVotes}})\",\"downVotes\":\"Hayır ({{downVotes}})\",\"report\":\"Rapor\",\"feedback\":\"Teşekkür ederiz!\",\"reportConfirmation\":{\"title\":\"Rapor\",\"text\":\"Bu yorumu uygunsuz olarak raporlamak üzeresiniz. Uygun olmayan bir yorum saldırgan, haksız ya da açıkça güvenilir olmayan bir içeriğe sahip olabilir. Devam etmek istediğinize emin misiniz?\",\"confirm\":\"Rapor\",\"cancel\":\"İptal\"},\"answers\":{\"avatarAltText\":\"Marka\",\"answerFrom\":\"{{author}} 'den yanıt\"},\"writeAReviewButton\":\"Bir yorum yazın\",\"needHelpButton\":\"Yardım için bize ulaşın\",\"legalNoticeButton\":\"Yorumlarla ilgili önemli bilgi \",\"legalNoticePopover\":{\"title\":\"Yorumlarla ilgili önemli bilgi \",\"text\":\"Burada yayınlanan yorumlar, web sitemizden gerçek ve onaylı satın alım yapmış tüketiciler tarafından yazılmıştır. \"},\"dimentionsSummaryTitle\":\"Özelliğe göre değerlendirmeler\",\"tags\":{\"incentivizedReview\":{\"title\":\"Teşvik edilme\",\"description\":\"Bu yorumu yazan kişi, bu yorumu yazmak için bir teşvik aldı. Teşvik, bir yorum yazma karşılığında bir kupon, örnek ürün, çekilişe katılım hakkı, sadakat puanları veya başka bir değer belirteci olabilir. Tüketiciler, ürünle ilgili olumlu ya da olumsuz gerçek deneyimlerini yansıtan yorumlar yazma konusunda teşvik edilir.\"},\"EmployeeReviewtrue\":{\"title\":\"Çalışan\",\"description\":\"Bu yorumu yazan kişi, şirketimizin bir çalışanı veya şirketimizde bilinen bir mali çıkarı olan birisidir, ancak bu yorumu yazmak için herhangi bir teşvik almamıştır. Tüketiciler, ürünle ilgili olumlu ya da olumsuz gerçek deneyimlerini yansıtan yorumlar yazma konusunda teşvik edilir.\"},\"verifiedPurchaser\":{\"title\":\"Doğrulandı\",\"description\":\"Bu yorumu yazan kişi, ürününü Siemens Ev Aletleri'nden satın aldı ve çoğu tüketiciye sunulan fiyatı ödedi. Bu etiket olmadan yapılan yorumlar da yardımcı olabilir. Örneğin, ürününü bir perakendeciden satın alan ancak fikrini web sitemizde paylaşmak isteyen tüketicilerimizin yorumları.\"}},\"noContent\":{\"heading\":\"İlk yorumu yazan siz olun!\",\"message\":\"Deneyimlerinizi paylaşarak diğer tüketicilerin ihtiyaçlarına uygun ürüne karar vermelerine yardımcı olabilirsiniz.\"},\"setModal\":{\"title\":\"Değerlendirme ayrıntıları\"},\"dateOfUserExperience\":\"An approximate date of purchase, installation, or first use: {{dateOfUserExperience}}\",\"summary\":{\"title\":\"Summary\",\"disclaimer\":\"Disclaimer: This summary is generated by artificial intelligence based on customer reviews.\"}},\"showMoreRatings\":\"Daha fazla değerlendirme göster\",\"retailerReviews\":{\"headingTitle\":\"Perakendecilerimizin yorumları\",\"legalNotice\":\"Bağlantıya tıkladığınızda, \u003clegalNoticeLink\u003everi koruma politikamızın\u003c/legalNoticeLink\u003e geçerli olmadığı perakendecinin web sitesine yönlendirileceksiniz. Lütfen perakendecinin sağladığı veri koruma bilgilerini gözden geçirin.\",\"legalNoticeLink\":\"https://www.siemens-home.bsh-group.com/tr/musteri-hizmetleri/iletisim/gizlilik-ve-yasal-metinler/kvkk-politikamiz\",\"rating\":\"{{average}} ({{count}})\"},\"sortExplanation\":{\"BEST\":\"Bu sıralama, yorumun uzunluğunu, yardımseverlik oylarını, görsel sayısını ve yorum gönderim süresini dikkate alır. Önce en alakalı yorumları gösterir ve yorum puanını dikkate almaz.\",\"HELPFUL\":\"Bu sıralama sadece yardımseverlik oylarını dikkate alır. Önce en yararlı yorumları gösterir ve yorum puanını dikkate almaz.\",\"RATING\":\"Bu sıralama sadece yorum puanını dikkate alır. Önce yüksek puanlı yorumları gösterir.\",\"NEWEST\":\"Bu sıralama sadece yorum gönderim süresini dikkate alır. Önce en son yapılan yorumları gösterir ve yorum puanını dikkate almaz.\"},\"sets\":{\"tooltip\":{\"title\":\"Ürün setleri için ortalama değerlendirme\",\"text\":\"Ürün setinin ortalama puanı, setteki tüm ürünlerin mevcut tüm yorumlarının aritmetik ortalamasıdır.\"}}},\"customBrandName\":\"Siemens Ev Aletleri\",\"meta\":{\"description\":{\"shop\":\"Siemens'ten satın alın!\",\"marketing\":\"Perakendecilerimizden satın alın!\"}},\"ariaLabel\":{\"productGallery\":{\"rightArrow\":\"sonraki görsel\",\"leftArrow\":\"önceki görsel\"},\"technicalOverview\":\"genel bakış bölümü ürüne genel bakış sağlar\",\"highlights\":{\"actionButton\":\"Öne çıkan özelliği açmayı vurgulayan ikon görseli\",\"modal\":\"Öne çıkan penceresini açmak için ikonu vurgular\"},\"documents\":{\"redirect\":\"Dosyayı yeni sekmede açmak için belge simgesi\",\"download\":\"Dosyayı indirmek için belge simgesi\"},\"productCompare\":\"Ürün karşılaştırması için bilgi çubuğunu kapatın\",\"helpfulLinks\":\"Bağlantı\",\"productSetComponents\":{\"rightArrow\":\"geri kaydır\",\"leftArrow\":\"ileri kaydır\",\"link\":\"Ürün setinin detay sayfasına bağlantı\"},\"ratingReviews\":{\"rating\":{\"stars\":\"Yorumların ortalaması: 5 üzerinden {{average}}\"},\"ratings\":\"Yorum genişletme butonu\",\"reviews\":\"Yorumu genişlet\",\"expandReview\":\"Yorumu genişlet\",\"collapseReview\":\"Collapse review\",\"filterChipToggleButton\":\"{{filterButtonContent}} toggle {{selected}}\",\"upvote\":\"Is this review helpful?, vote yes\",\"downvote\":\"Is this review helpful?, vote no\"},\"buyArea\":{\"ratings\":\"{{count}} yoruma göre 5 üzerinden {{average}} ortalama\"},\"footnotes\":{\"linkToFootnotes\":\"Dipnot {{footnoteIndex}} {{footnoteText}} Dipnotun sonu\"}},\"accessibility\":{\"ariaLabel\":{\"specifications\":{\"searchInput\":\"Aradığınız kelimeyi ya da ürünü yazınız\"},\"productCarousel\":{\"arrowLeft\":\"önceki ürün\",\"arrowRight\":\"sonraki ürün\"},\"segmentControl\":{\"arrowLeft\":\"önceki öge\",\"arrowRight\":\"sonraki öge\"},\"retailerReviews\":{\"tile\":\"{{retailerName}} 'dan yorumlar\",\"image\":\"{{retailerName}} logosu\",\"button\":\"{{retailerName}} sitesine dış bağlantı\"},\"ratingReviews\":{\"tag\":\"{{label}} olarak etiketlenmiş yorum\",\"upvote\":\"Destek oyu\",\"downvote\":\"Olumsuz oy\",\"report\":\"Rapor\",\"rating\":\"Tüketici yorumu: 5 yıldız üzerinden {{rating}} yıldız\",\"ratingSpecs\":\"Tüketici yorumu: {{category}} için 100 üzerinden {{rating}}\",\"average\":\"{{count}} yoruma göre 5 üzerinden {{average}} ortalama değerlendirme\",\"sortingReviewInfo\":\"Yorum bil