f67/major-v-two-asset-hybrid-12.jpeg?w=480&amp;fm=jpg&amp;q=85 480w, //images.ctfassets.net/javen7msabdh/50XRgXyEW1uhlMaCvHXdse/7236756f0755ebec4d5796d9b92cbf67/major-v-two-asset-hybrid-12.jpeg?w=640&amp;fm=jpg&amp;q=85 640w" decoding="async" loading="lazy" fetchpriority="auto"/></picture></div></div><div class="css-kmsvxd"><div class="css-1a58p04"><h3 class="chakra-text css-z6ujzh" style="text-wrap:pretty">Bluetooth LE Audio-ready</h3><div class="css-1situk"><div style="white-space:pre-wrap;color:#8C8C8C" class="css-0"><p style="white-space:pre-wrap;color:#8C8C8C;text-wrap:pretty">Major V is geared up for Bluetooth LE Audio. This <strong style="color:#FFFFFF">future-proof technology</strong> will deliver superior sound quality and open a new world of audio sharing possibilities with <strong style="color:#FFFFFF">Auracast™. </strong></p></div></div></div><div class="css-od5bpv"><div class="css-1e9f299"><picture class="css-y6dvqs"><source media="(prefers-reduced-motion: reduce) and (min-width: 768px)" type="image/png" sizes="100vw" width="4" height="3" alt="Front image of folded Major V Black Marshall on-ear headphones." srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=png&amp;fl=png8 640w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=1024&amp;fm=png&amp;fl=png8 1024w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=1440&amp;fm=png&amp;fl=png8 1440w"/><source media="(prefers-reduced-motion: reduce)" type="image/png" sizes="100vw" width="4" height="3" alt="Front image of folded Major V Black Marshall on-ear headphones." srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=320&amp;fm=png&amp;fl=png8 320w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=480&amp;fm=png&amp;fl=png8 480w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=png&amp;fl=png8 640w"/><source type="image/webp" sizes="auto, 100vw" media="(min-width: 768px)" width="4" height="3" srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=webp 640w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=1024&amp;fm=webp 1024w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=1440&amp;fm=webp 1440w"/><source type="image/gif" sizes="auto, 100vw" media="(min-width: 768px)" width="4" height="3" srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=gif 640w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=1024&amp;fm=gif 1024w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=1440&amp;fm=gif 1440w"/><source type="image/png" sizes="auto, 100vw" media="(min-width: 768px)" width="4" height="3" srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=png&amp;fl=png8 640w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=1024&amp;fm=png&amp;fl=png8 1024w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=1440&amp;fm=png&amp;fl=png8 1440w"/><source type="image/webp" sizes="auto, 100vw" width="4" height="3" srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=320&amp;fm=webp 320w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=480&amp;fm=webp 480w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=webp 640w"/><source type="image/gif" sizes="auto, 100vw" width="4" height="3" srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=320&amp;fm=gif 320w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=480&amp;fm=gif 480w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=gif 640w"/><source type="image/png" sizes="auto, 100vw" width="4" height="3" srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=320&amp;fm=png&amp;fl=png8 320w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=480&amp;fm=png&amp;fl=png8 480w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=png&amp;fl=png8 640w"/><img style="height:100%;width:100%;position:absolute;inset:0;object-fit:cover;opacity:1;object-position:center" alt="Front image of folded Major V Black Marshall on-ear headphones." width="4" height="3" srcSet="//images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=320&amp;fm=png&amp;fl=png8 320w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=480&amp;fm=png&amp;fl=png8 480w, //images.ctfassets.net/javen7msabdh/2Fb7a0eGaOnS9RNfPBk60s/9a227ffa72e3fc24c679fbb9f9654216/major-v-two-asset-hybrid-11.gif?w=640&amp;fm=png&amp;fl=png8 640w" decoding="async" loading="lazy" fetchpriority="auto"/></picture><button title="Pause button" class="css-1mmai13"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16" focusable="false" class="chakra-icon css-ua7cne"><path fill="currentColor" d="M4 1.5h1.5v13H4zM10.5 1.5H12v13h-1.5z"></path></svg></button></div></div></div></div><div class="one-asset-widget css-bcypiz"><div class="css-9qg7do"><div class="css-qp4lqd"><h3 class="chakra-text css-1xzno8x" style="text-wrap:pretty">Cut through the noise like Billie</h3><div class="css-x5y9t"><div style="white-space:pre-wrap;color:#8C8C8C" class="css-0"><p style="white-space:pre-wrap;color:#8C8C8C;text-wrap:pretty">When the <strong style="color:#FFFFFF">world gets a little chaotic</strong>, music can be the force of inspiration to make your way through the noise. We&#x27;re proud to showcase our headphone collection with <strong style="color:#FFFFFF">Billie Joe Armstrong</strong>.</p></div></div></div></div><div class="css-3lf2mu"><div class="css-ldo4d5"><div class="css-910he2"><a target="_self" class="chakra-link css-spn4bz" href="/tr/en/headband/billie-joe-armstrong" style="display:block;width:100%" aria-label="Billie Joe Armstrong using the Major V headphones by Marshall in a cinema"><div class="css-n3mk9x"><picture class="css-12ld42p"><source type="image/avif" sizes="auto, 100vw" media="(min-width: 1281px)" width="16" height="9" srcSet="//images.ctfassets.net/javen7msabdh/DXzXWDjAB2cjUarezrFYu/3d1af23b0221df5e45dae3cb2c7a832e/major_v_headband_reactivation_2025_single_asset_full_width_13_desktop.jpg?w=1200&amp;fm=avif&amp;q=100 1200w, //images.ctfassets.net/javen7msabdh/DXzXWDjAB2cjUarezrFYu/3d1af23b0221df5e45dae3cb2c7a832e/major_v_headband_reactivation_2025_single_asset_full_width_13_desktop.jpg?w=1500&amp;fm=avif&amp;q=100 1500w, //images.ctfassets.net/javen7msabdh/DXzXWDjAB2cjUarezrFYu/3d1af23b0221df5e45dae3cb2c7a832e/major_v_headband_reactivation_2025_single_asset_full_width_13_desktop.jpg?w=1900&amp;fm=avif&amp;q=100 1900w, //images.ctfassets.net/javen7msabdh/DXzXWDjAB2cjUarezrFYu/3d1af23b0221df5e45dae3cb2c7a832e/major_v_headband_reactivation_2025_single_asset_full_width_13_desktop.jpg?w=2400&amp;fm=avif&amp;q=100 2400w"/><source type="image/jpeg" sizes="auto, 100vw" media="(min-width: 1281px)" width="16" height="9" srcSet="//images.ctfassets.net/javen7msabdh/DXzXWDjAB2cjUarezrFYu/3d1af23b0221df5e45dae3cb2c7a832e/major_v_headband_reactivation_2025_single_asset_full_width_13_desktop.jpg?w=1200&amp;fm=jpg&amp;q=85 1200w, //images.ctfassets.net/javen7msabdh/DXzXWDjAB2cjUarezrFYu/3d1af23b0221df5e45dae3cb2c7a832e/major_v_headband_reactivation_2025_single_asset_full_width_13_desktop.jpg?w=1500&amp;fm=jpg&amp;q=85 1500w, //images.ctfassets.net/javen7msabdh/DXzXWDjAB2cjUarezrFYu/3d1af23b0221df5e45dae3cb2c7a832e/major_v_headband_reactivation_2025_single_asset_full_width_13_desktop.jpg?w=1900&amp;fm=jpg&amp;q=85 1900w, //images.ctfassets.net/javen7msabdh/DXzXWDjAB2cjUarezrFYu/3d1af23b0221df5e45dae3cb2c7a832e/major_v_headband_reactivation_2025_single_asset_full_width_13_desktop.jpg?w=2400&amp;fm=jpg&amp;q=85 2400w"/><source type="image/avif" sizes="auto, 100vw" width="4" height="5" srcSet="//images.ctfassets.net/javen7msabdh/7l8cGhrjpQvZwzGSQlVecj/bb16eb0b72d1168c61595ed97a1be737/major_v_headband_reactivation_2025_single_asset_full_width_13_mobile.jpg?w=300&amp;fm=avif&amp;q=100 300w, //images.ctfassets.net/javen7msabdh/7l8cGhrjpQvZwzGSQlVecj/bb16eb0b72d1168c61595ed97a1be737/major_v_headband_reactivation_2025_single_asset_full_width_13_mobile.jpg?w=500&amp;fm=avif&amp;q=100 500w, //images.ctfassets.net/javen7msabdh/7l8cGhrjpQvZwzGSQlVecj/bb16eb0b72d1168c61595ed97a1be737/major_v_headband_reactivation_2025_single_asset_full_width_13_m