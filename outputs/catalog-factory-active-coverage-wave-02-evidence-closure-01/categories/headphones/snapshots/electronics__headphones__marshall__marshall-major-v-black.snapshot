Set="//images.ctfassets.net/javen7msabdh/27lBTRZsYifyTeumJ9J2iC/6a9ee2348c33b40a787612b7c23a85f4/major-v-two-asset-hybrid-10.jpeg?w=320&amp;fm=jpg&amp;q=85 320w, //images.ctfassets.net/javen7msabdh/27lBTRZsYifyTeumJ9J2iC/6a9ee2348c33b40a787612b7c23a85f4/major-v-two-asset-hybrid-10.jpeg?w=480&amp;fm=jpg&amp;q=85 480w, //images.ctfassets.net/javen7msabdh/27lBTRZsYifyTeumJ9J2iC/6a9ee2348c33b40a787612b7c23a85f4/major-v-two-asset-hybrid-10.jpeg?w=640&amp;fm=jpg&amp;q=85 640w" decoding="async" loading="lazy" fetchpriority="auto"/></picture></div></div></div><div class="two-assets-widget css-1hdfdjo"><div class="shared-top css-1stqjnx"><div class="css-bz60ct"><h3 class="chakra-text css-z6ujzh" style="text-wrap:pretty">Bluetooth LE Audio-ready</h3><div class="css-1situk"><div style="white-space:pre-wrap;color:#8C8C8C" class="css-0"><p style="white-space:pre-wrap;color:#8C8C8C;text-wrap:pretty">Major V is geared up for Bluetooth LE Audio. This <strong style="color:#FFFFFF">future-proof technology</strong> will deliver superior sound quality and open a new world of audio sharing possibilities with <strong style="color:#FFFFFF">Auracast™. </strong></p></div></div></div></div><div class="css-t5098a"><div class="css-ypv6sy"><picture class="css-15jpfpj"><source type="image/avif" sizes="auto, 100vw" media="(min-width: 768px)" width="4" height="5" srcSet="//images.ctfassets.net/javen7msabdh/50XRgXyEW1uhlMaCvHXdse/7236756f0755ebec4d5796d9b92cbf67/major-v-two-asset-hybrid-12.jpeg?w=640&amp;fm=avif&amp;q=100 640w, //images.ctfassets.net/javen7msabdh/50XRgXyEW1uhlMaCvHXdse/7236756f0755ebec4d5796d9b92cbf67/major-v-two-asset-hybrid-12.jpeg?w=1024&amp;fm=avif&amp;q=100 1024w, //images.ctfassets.net/javen7msabdh/50XRgXyEW1uhlMaCvHXdse/7236756f0755ebec4d5796d9b92cbf67/major-v-two-asset-hybrid-12.jpeg?w=1440&amp;fm=avif&amp;q=100 1440w"/><source type="image/jpeg" sizes="auto, 100vw" media="(min-width: 768px)" width="4" height="5" srcSet="//images.ctfassets.net/javen7msabdh/50XRgXyEW1uhlMaCvH