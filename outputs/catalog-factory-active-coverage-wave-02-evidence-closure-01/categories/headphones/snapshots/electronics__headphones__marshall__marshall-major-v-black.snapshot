ts from the moment you receive the shipping confirmation email with your tracking number.\u000b\u003Cbr \u002F\u003EOrders to countries outside the EU are shipped according to Incoterm Delivered Duty Unpaid (DDU). This means that we do not collect or pay any import duties that may be charged in designated country of delivery. Any additional import charges must be covered by you in order for your package to clear customs. Please contact your local customs office for more information if you are unsure if import duties may apply in your home country."}],"c_brand":"Marshall","c_category":{"id":"headphones","displayName":"Headphones","parentCategory":"headphones"},"c_price":{"sales":{"value":99,"currency":"EUR","formatted":"€ 99","decimalPrice":"99.00","formattedCurrency":"€ ","formattedValue":"99","position":"left"},"list":{"value":149,"currency":"EUR","formatted":"€ 149","decimalPrice":"149.00","formattedCurrency":"€ ","formattedValue":"149","position":"left"},"priceInfo":null},"c_discount":50,"c_campaigns":[{"id":"Special offers","enabled":true,"startDate":null,"endDate":null,"description":null,"relatedVariants":[{"productID":"1006832","variantID":"black"},{"productID":"1009165","variantID":"pitch black"}]}],"c_variationAttributes":[{"id":"color","name":"Color","values":[{"value":"black","description":"#000000","name":"Black","orderable":true,"productIds":["1006832"],"imageLinks":[{"swatch":[{"alt":"imageMissingAlt","url":"https:\u002F\u002Fbcql-prd.my.commercecloud.salesforce.com\u002Fdw\u002Fimage\u002Fv2\u002FBCQL_PRD\u002Fon\u002Fdemandware.static\u002FSites-Marshall-SK-Site\u002F-\u002Fen_TR\u002Fv1788445098692\u002Fnoimg_hires.png?sw=195&sh=195&sm=fit","title":"","sourceSet":"","sizes":"(min-width: 768px)"}]}],"hasPromotion":true},{"value":"brown","description":"#824820","name":"Brown","orderable":true,"productIds":["1006834"],"imageLinks":[{"swatch":[{"alt":"imageMissingAlt","url":"https:\u002F\u002Fbcql-prd.my.commercecloud.salesforce.com\u002Fdw\u002Fimage\u0