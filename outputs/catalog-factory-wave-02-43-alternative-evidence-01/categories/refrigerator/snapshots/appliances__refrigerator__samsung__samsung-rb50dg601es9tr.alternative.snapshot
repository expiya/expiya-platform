						document.querySelector(".pd-g-floating-nav").style.display='none';
					}
					document.querySelectorAll("#content a[target='_blank']").forEach(function(item){
						item.removeAttribute('target');
					});
				}
				if("page-standard-pd" === "page-support-detail" || "page-buying-pd" === "page-support-detail" || "page-feature-pd" === "page-support-detail") {
					if(document.querySelector(".pd-header-navigation__menu-epromoter-cta") != null && document.querySelector(".pd-header-navigation__menu-epromoter-cta").style != null) {
						document.querySelector(".pd-header-navigation__menu-epromoter-cta").style.display='none';
					}
					if(document.querySelector(".product-detail-kv__cta-epromotor") != null && document.querySelector(".product-detail-kv__cta-epromotor").style != null) {
						document.querySelector(".product-detail-kv__cta-epromotor").style.display='none';
					}
				}else if("page-bc-pd" === "page-support-detail"){
					document.querySelectorAll("#content .s-message-link").forEach(function(item){
						item.style.display = "none";
					});
				}
				if(document.querySelector(".skip-bar") != null && document.querySelector(".skip-bar").style != null) {
					document.querySelector(".skip-bar").style.display='none';
				}
				if(document.querySelector(".cookie-bar__app-banner") != null && document.querySelector(".cookie-bar__app-banner").style != null) {
					document.querySelector(".cookie-bar__app-banner").style.display='none';
				}
				if(document.querySelector(".cookie-bar") != null && document.querySelector(".cookie-bar").style != null) {
					document.querySelector(".cookie-bar").style.display='none';
				}
				if(document.querySelector(".cod05-app-banner") != null && document.querySelector(".cod05-app-banner").style != null) {
					document.querySelector(".cod05-app-banner").style.display='none';
				}
				//[EPP] Partner Bar 미노출 처리 (nl제외)
				if(document.querySelector(".partner-bar-wrap") != null && document.querySelector(".partner-bar-wrap").style != null && "nl" != "tr") {
					document.querySelector(".partner-bar-wrap").style.display='none';
				}
				if("us" === "tr" && document.querySelector(".footer-local-logo") != null && document.querySelector(".footer-local-logo").style != null) {
					document.querySelector(".footer-local-logo").style.display='none';
				}
				if(window.sg && window.sg.common && window.sg.common.utils){
					window.sg.common.utils.visibleScroll();
				}
			}

			let timerId = setInterval(() => {
				if(isWebView){
					hideHeaderFooterByWindowFlutterInappwebview();
				}
				if(window.location.href.indexOf("samsung.com.cn") > -1){ //cn국가인 경우
					//추가된 userAgent 판단 로직
					var ua = navigator.userAgent;
					var ualower = ua.toLowerCase();
					if(/micromessenger/.test(ualower)){ //userAgent include 'micromessenger'
						if(/miniprogram/i.test(ualower)){ // 위챗 미니앱
							//return 'wxApp';
							hideHeaderFooterByWindowFlutterInappwebview();
						}
					}else if(/aliapp/i.test(ualower) && /miniprogram/i.test(ualower)){//userAgent include 'aliapp', 'miniprogram'
						//return 'aliApp';// 알리 미니앱
						hideHeaderFooterByWindowFlutterInappwebview();
					}
				}
			}, 10);
			setTimeout(() => {
				clearInterval(timerId);
			}, 20000);

			const setSessionStorage = () => {
				const isInAppWebViewSessionStorage = sessionStorage.getItem("isInAppWebViewSessionStorage");
				if(!isInAppWebViewSessionStorage){
					// readyCallback에서 세팅 (기존에 없는 경우만 세팅)
					sessionStorage.setItem("isInAppWebViewSessionStorage", "true");
				}
			}

			//new ShopAppUtil
			let shopAppUtilInstance = new ShopAppUtil({
				logger: true,
				readyCallback: setSessionStorage
			});

			document.addEventListener("DOMContentLoaded", function () {
				if(shopAppUtilInstance.isWebView() && typeof $ !== "undefined"){
					$(document).off("click", 'a[target*="_blank"]');
					$(document).on("click", 'a[target*="_blank"]', function (e) {
						let href = $(this).attr("href");
						if (!!href && href.indexOf("javascript") === -1 && href !== "#") {
							if (href.startsWith("/" + "tr" + "/")) {
								href = window.location.origin + href;
							}
							if (href.indexOf("http:") === -1 && href.indexOf("https:") === -1) {
								href = "https://" + href;
							}
							if($('[class*="popup"] a[target*="_blank"]').index(this) > -1 
								|| href.indexOf("www.samsung.com") === -1 || href.indexOf("/hu/article/") > -1 || window.location.href.indexOf("/mypage/rewards") > -1 || window.location.href.indexOf("/" + siteCode + "/rewards") > -1){
								e.preventDefault();
								shopAppUtilInstance.openExternalBrowser(href);
							}
						}
					});
					if(window.location.href.indexOf("/us/mypage") > -1 ){
						$(document).off("click", '.myd15-recommended-products a');
						$(document).on("click", '.myd15-recommended-products a', async function (e) {
							let href = $(this).attr("href");
							if (!!href && href.indexOf("javascript") === -1 && href !== "#") {
								if (href.startsWith("/us/")) {
									href = window.location.origin + href;
								}
								if (href.indexOf("http:") === -1 && href.indexOf("https:") === -1) {
									href = "https://" + href;
								}
								e.preventDefault();
								await shopAppUtilInstance.callHandler("openDeeplink","samsungestore://openwebview#url=" + href);
							}
						});
					}
					if("au" === "tr"){
						$(document).off("click", ".hubble-price-bar-disclaimer a, .hubble-price-bar__disclaimer a");
						$(document).on("click", ".hubble-price-bar-disclaimer a, .hubble-price-bar__disclaimer a", function (e) {
							let href = $(this).attr("href");
							if (!!href && href.indexOf("/au/terms/") > -1) {
								if (href.startsWith("/au/")) {
									href = window.location.origin + href;
								}
								if (href.indexOf("http:") === -1 && href.indexOf("https:") === -1) {
									href = "https://" + href;
								}
								e.preventDefault();
								shopAppUtilInstance.openExternalBrowser(href);
							}
						});
					}
				}
			});

			//EMI 팝업에서 호출 확인 용 
			function hideModalEmipopup() {
					console.log("[from finance-popup.js] call hideModalEmipopup()!! ");
					$('#wrap > div.finance-popup > div > div > div > button').click();
			}
			
			function hideModalEmipopupConsole() {
				console.log("dummy [from finance-popup.js] call hideModalEmipopup()!! ");
					
			}
		
			// App Login callback function
			function login_completed (login_result, identifier) {
				if("true" === login_result) {
					if("nv-g-mini-cart.checkout" === identifier) {
						location.href = window.sg.minicart.checkoutUrl;
					}
				}
			}
			
			// [CRHQ-1787],[SRD-15288] [AEM][SCIC] SHOP APP 로그인 연계 코드 추가
			function login_completed_reload(login_result, identifier) {
				if(login_result === "true") {
					location.reload();
				}
			}
		</script>
