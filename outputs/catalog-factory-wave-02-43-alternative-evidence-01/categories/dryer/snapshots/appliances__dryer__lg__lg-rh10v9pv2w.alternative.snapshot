</div></div></div></div></div></div></div></div></div></div><div class="c-wrapper cs0028-downloadmanualsoftwares type-text aem-GridColumn aem-GridColumn--default--12"><div class="component type-grid type-tabs" data-retrievemanualsoftwarelistendpoint="/ncms/api/v1/support/proxy/retrieveManualSoftwareList?locale=TR" data-manualslistauthoringconfig="[{&quot;categoryKey&quot;:&quot;MANUAL&quot;,&quot;categoryTitle&quot;:&quot;Kullanıcı Kılavuzları&quot;,&quot;categoryDescription&quot;:&quot;\u003cp\u003eÜrün kurulumu ve kullanımı ile ilgili en kapsamlı belge.\u003c/p\u003e\r\n&quot;,&quot;appliedCssClassNames&quot;:null,&quot;dynamicComponentId&quot;:&quot;-808d66743d&quot;,&quot;resourcePath&quot;:&quot;/content/lge/tr/tr/destek/product-support/jcr:content/root/container/supporttab/item_1/downloadmanualsoftwa/manualsListConfig/item0&quot;,&quot;:type&quot;:null},{&quot;categoryKey&quot;:&quot;USER&quot;,&quot;categoryTitle&quot;:&quot;Kullanım Kılavuzu&quot;,&quot;categoryDescription&quot;:&quot;\u003cp\u003eÜrün kullanımı ve talimatları açıklar.\u003c/p\u003e\r\n&quot;,&quot;appliedCssClassNames&quot;:null,&quot;dynamicComponentId&quot;:&quot;-12846c025d&quot;,&quot;resourcePath&quot;:&quot;/content/lge/tr/tr/destek/product-support/jcr:content/root/container/supporttab/item_1/downloadmanualsoftwa/manualsListConfig/item1&quot;,&quot;:type&quot;:null},{&quot;categoryKey&quot;:&quot;OWNERS_MANUAL&quot;,&quot;categoryTitle&quot;:&quot;Kullanıcı Kılavuzu&quot;,&quot;categoryDescription&quot;:&quot;\u003cp\u003eÜrün kurulumu ve kullanımı ile ilgili en kapsamlı belge.\u003c/p\u003e\r\n&quot;,&quot;appliedCssClassNames&quot;:null,&quot;dynamicComponentId&quot;:&quot;-1885b1cb56&quot;,&quot;resourcePath&quot;:&quot;/content/lge/tr/tr/destek/product-support/jcr:content/root/container/supporttab/item_1/downloadmanualsoftwa/manualsListConfig/item2&quot;,&quot;:type&quot;:null},{&quot;categoryKey&quot;:&quot;addtionalLinks&quot;,&quot;categoryTitle&quot;:&quot;Ek Bağlantılar&quot;,&quot;categoryDescription&quot;:&quot;\u003cp\u003eÜrün kurulumu ve kullanımı ile ilgili en kapsamlı belge.\u003c/p\u003e\r\n&quot;,&quot;appliedCssClassNames&quot;:null,&quot;dynamicComponentId&quot;:&quot;-925f9d693a&quot;,&quot;resourcePath&quot;:&quot;/content/lge/tr/tr/destek/product-support/jcr:content/root/container/supporttab/item_1/downloadmanualsoftwa/manualsListConfig/item3&quot;,&quot;:type&quot;:null},{&quot;categoryKey&quot;:&quot;QUICK&quot;,&quot;categoryTitle&quot;:&quot;Hızlı Kurulum Kılavuzu&quot;,&quot;categoryDescription&quot;:&quot;\u003cp\u003eÜrününüzü daha hızlı kurmanıza yardım eden bir kılavuzdur.\u003c/p\u003e\r\n&quot;,&quot;appliedCssClassNames&quot;:null,&quot;dynamicComponentId&quot;:&quot;-2bbfe584ea&quot;,&quot;resourcePath&quot;:&quot;/content/lge/tr/tr/destek/product-support/jcr:content/root/container/supporttab/item_1/downloadmanualsoftwa/manualsListConfig/item4&quot;,&quot;:type&quot;:null},{&quot;categoryKey&quot;:&quot;INSTALLATION&quot;,&quot;categoryTitle&quot;:&quot;Kurulum Kılavuzu&quot;,&quot;categoryDescription&quot;:&quot;\u003cp\u003eKurulum kılavuzu ürünün kullanımını açıklayan bir belgedir.\u003c/p\u003e\r\n&quot;,&quot;appliedCssClassNames&quot;:null,&quot;dynamicComponentId&quot;:&quot;-5b726ae8e8&quot;,&quot;resourcePath&quot;:&quot;/content/lge/tr/tr/destek/product-support/jcr:content/root/container/supporttab/item_1/downloadmanualsoftwa/manualsListConfig/item5&quot;,&quot;:type&quot;:null}]" data-reference="Reference" data-extensiontext="extension" data-title="Kılavuzları İndir" data-oslabel="" data-noresultstextmanuals="&lt;p&gt;İndirilecek kılavuz bulunmuyor.&lt;/p&gt;
