  const conformityRules = [
      {
          stores: ["US", "CA"],
          headingKey: "declaration_of_conformity",
          hiddenDocumentUrlPart: "EU_Declaration_of_Conformity",
      },
      {
          stores: [
              "AT", // Austria
              "BE", // Belgium
              "DK", // Denmark
              "FI", // Finland
              "FR", // France
              "DE", // Germany
              "GR", // Greece
              "HU", // Hungary
              "IE", // Ireland
              "IT", // Italy
              "LU", // Luxembourg
              "NL", // Netherlands
              "PT", // Portugal
              "ES", // Spain
              "SE", // Sweden
              "GB", // United Kingdom
              "CH", // Switzerland
          ],
          headingKey: "eu_conformity",
          hiddenDocumentUrlPart: "FCC_Supplier",
      },
  ];

  const defaultConformityRule = {
      headingKey: "eu_conformity",
      hiddenDocumentUrlPart: null,
  };

  function getConformityRule(storeCode) {
      return (
          conformityRules.find((rule) => rule.stores.includes(storeCode)) ||
          defaultConformityRule
      );
  }

  document.addEventListener("DOMContentLoaded", function () {
      const downloadsSection = document.getElementById("downloads-section");
      // Stop everything if section does not exist
      if (!downloadsSection) return;

      const languagePicker = document.getElementById("downloads-language-picker");
      /* ---- Detect Shopify language ---- */
      let currentLang = "en";
      // normalize language format
      currentLang = currentLang.toLowerCase();
      // mapping (important for chinese)
      const languageMap = {
          "zh-cn": "zh_hans",
          "zh-tw": "zh_hant",
      };

      if (languageMap[currentLang]) {
          currentLang = languageMap[currentLang];
      }

      if (languagePicker.querySelector(`option[value="${currentLang}"]`)) {
          languagePicker.value = currentLang;
          selectedLang = currentLang;
      }

      fetch(
          "https://dechbbrandcomstshrprd.blob.core.windows.net/product-documents/final-test"
      )
          .then((res) => {
              return res.json();
          })
          .then((data) => {
              storedProductData = data[currentHandle];

              if (!storedProductData) return;
              document.getElementById("downloads-section").style.display =
                  "block";
              document
                  .getElementById("downloads-language-picker")
                  .addEventListener("change", function () {
                      selectedLang = this.value;
                      renderAccordion(); // re-render without fetch
                  });
              renderAccordion();
          })
          .catch((err) => {
              console.log("fetch Error:", err);
          });
  });

  function normalizeCategoryKey(rawTitle) {
      const lower = rawTitle.toLowerCase();

      // Direct match
      if (titleTranslations["en"][rawTitle]) return rawTitle;

      // Keyword mapping
      if (lower.includes("declaration of conformity")) return "eu_conformity";
      if (lower.includes("instruction manual")) return "instruction_manual";
      if (lower.includes("manual")) return "instruction_manual";
      if (lower.includes("safety")) return "safety_instruction";
      if (lower.includes("compliance sheet")) return "compliance_sheet";
      if (lower.includes("compliance")) return "safety_instruction";
      if (lower.includes("faq")) return "faq_links";
      if (lower.includes("quick guide")) return "quick_guides";
      if (lower.includes("spec")) return "spec_sheets";
      if (lower.includes("fact")) return "fact_sheets";
      if (lower.includes("battery")) return "lithium_batteries_info";
      if (lower.includes("software")) return "application_software";
      if (lower.includes("photo")) return "high_resolution_photo";
      if (lower.includes("video")) return "how_to_videos";
      if (lower.includes("transport")) return "lithium_batteries_info";

      // fallback
      return "miscellaneous";
  }

  function renderAccordion() {
      const accordion = document.getElementById("downloads-accordion");
      accordion.innerHTML = "";

      const groupedData = {};

      //Normalize + Merge categories
      Object.entries(storedProductData).forEach(([title, items]) => {
          if (!items || items.length === 0) return;

          const normalizedKey = normalizeCategoryKey(title);

          if (!groupedData[normalizedKey]) {
              groupedData[normalizedKey] = [];
          }

          groupedData[normalizedKey] = groupedData[normalizedKey].concat(items);
      });

      //Render grouped categories
      Object.entries(groupedData).forEach(([categoryKey, originalItems]) => {
          let items = originalItems;
          let headingKey = categoryKey;

          if (categoryKey === "eu_conformity") {
              const rule = getConformityRule(currentStore);

              headingKey = rule.headingKey;

              if (rule.hiddenDocumentUrlPart) {
                  items = items.filter(
                      (item) =>
                          !item.defaultUrl
                              .toLowerCase()
                              .includes(rule.hiddenDocumentUrlPart.toLowerCase())
                  );
              }
          }

          if (!items.length) return;

          const displayTitle =
              (titleTranslations[selectedLang] &&
                  titleTranslations[selectedLang][headingKey]) ||
              (titleTranslations.en && titleTranslations.en[headingKey]) ||
              headingKey;

          let linksHTML = "";

          items.forEach((item) => {
              let url = item.defaultUrl;
              let label = item.label;

              if (item.translations && item.translations[selectedLang]) {
                  url = item.translations[selectedLang].url;
                  label = item.translations[selectedLang].label;
              }

              linksHTML += `
          <div class="faq-answer">
            <a target="_blank" href="${url}" data-type="link">
              ${label}
            </a>
          </div>
        `;
          });

          accordion.innerHTML += `
        <div class="accordion-item">
          <div class="accordion-heading">
            ${displayTitle}
            <em class="accordion-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 5">
                <path d="M.397.972a.479.479 0 0 1 .67-.684L4.5 3.658 7.932.288a.479.479 0 0 1 .671.684L4.5 5 .397.972Z"></path>
              </svg>
            </em>
          </div>
          <div class="accordion-content">
            ${linksHTML}
          </div>
        </div>
      `;
      });

      attachAccordionEvents();
  }

  function attachAccordionEvents() {
      const accordion = document.getElementById("downloads-accordion");
      if (!accordion) return;

      const headings = accordion.querySelectorAll(".accordion-heading");

      headings.forEach((heading) => {
          heading.addEventListener("click", function () {
              const item = this.closest(".accordion-item");
              const content = item.querySelector(".accordion-content");
              const isOpen = item.classList.contains("active");

              // Close all items first
              accordion.querySelectorAll(".accordion-item").forEach((i) => {
                  i.classList.remove("active");
                  $(i).find(".accordion-content").stop(true, true).slideUp();
              });

              // If it was previously closed, open it
              if (!isOpen) {
                  item.classList.add("active");
                  $(content).stop(true, true).slideDown();
              }
          });
      });
  }
</script></div><script data-locksmith>
    var load = function () {


            Locksmith.initializeSession({silent: window.location.search === ""});


      Locksmith.util.on('submit', 'locksmith-resource-form', function (event) {
        event.preventDefault();
        var data = Locksmith.util.serializeForm(event.target);
        var options = { spinner: false, container: 'locksmith-content' };
        // a form rendered inline (section replacement) must keep that context
        // on resubmit: same enclosing container (there may be several on the
        // page), and no layout classes or cancel affordance in the re-render
        var inlineContainer = event.target.closest && event.target.closest('[id^="locksmith-content"]');
        if (inlineContainer) {
          options.container = inlineContainer;
        }
        if (event.target.getAttribute('data-locksmith-inline') === 'true') {
          options.include_layout_classes = false;
        }
        Locksmith.postResource(data, options);
      });

      Locksmith.util.on('click', 'locksmith-manual-trigger', function (event) {
        event.preventDefault();
        Locksmith.postResource({}, { spinner: true, container: document });
      });

      Locksmith.submitPasscode = function (passcode) {
        Locksmith.postResource(
          { passcode: passcode },
          { spinner: false, container: 'locksmith-content' }
        );
      };
    };

    if (typeof Locksmith !== 'undefined') {
      load();
    } else {
      window.addEventListener('load', load);
    }
  </script>
