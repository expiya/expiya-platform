    <link href="//us.sennheiser-hearing.com/cdn/shop/t/14/assets/variant-modal.css?v=90269822127468239101787830915" rel="stylesheet" type="text/css" media="all" />

<div id="variantModal" class="custom-variant-modal modal-overlay" data-cart-type="page">
  <div class="modal-container">
    <button class="modal-close" title="Close">
      <img src="//us.sennheiser-hearing.com/cdn/shop/t/14/assets/close-gray.svg?v=46109475149867373151787830927" alt="Close icon" height="auto" width="auto">
    </button>
    <div class="modal-content">
      <div class="modal-image">
        <img id="modalProductImage" src="" alt="Product Image">
      </div>

      <div class="modal-details">
        <div class="inner-wrap">
          <div class="product-details">
            <h2 class="product-title">
              <a href="#" id="modalProductTitle" style="text-decoration: none; color: inherit;"></a>
            </h2>
            <div class="product-price-wrapper">
              <div class="product-price-inner-wrapper">
                <p class="product-price" id="modalProductPrice"></p>
                <p class="product-compare-at-price is-hidden" id="modalProductCompareAtPrice"></p>
              </div>
              <p class="promotional-price is-hidden" id="modalPromotionalText">Promotional price</p>
            </div>
          </div>

          
          <input name="id" value="" hidden>
          
          <div id="modalVariantOptions" class="modal-variant-options"></div>

          <div class="product-option quantity-options">
            <span>Quantity : </span>
            <div class="quantity-box">
              <button class="quantity-btn" id="modalQuantityMinus">
                <img src="//us.sennheiser-hearing.com/cdn/shop/t/14/assets/minus.svg?v=129486583950633214261787830927" alt="Minus" height="auto" width="auto">
              </button>
              <input type="number" id="modalQuantityInput" value="1" min="1">
              <button class="quantity-btn" id="modalQuantityPlus">
                <img src="//us.sennheiser-hearing.com/cdn/shop/t/14/assets/plus.svg?v=181760894803939087131787830927" alt="Plus" height="auto" width="auto">
              </button>
            </div>
          </div>
        </div>

        <div class="btn-wrapper">
          
            <a
              href="javascript:void(0)"
              class="btn btn-secondary"
              id="modalProductURL"
              title="View Details"
            >View Details</a>
          
          <button class="btn btn-primary" id="modalAddToCart" title="Add to Cart">Add to Cart</button>
        </div>
      </div>
    </div>
  </div>
</div>


